{
  "info": { "name": "Demo", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Get User (by id)",
          "request": {
            "method": "get",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "X-Api-Key", "value": "k" }, { "name": "X-Name", "value": "n" } ],
            "url": { "raw": "https://api.example.com/users/1?verbose=true", "host": ["api", "example", "com"], "path": ["users", "1"], "query": [ { "key": "verbose", "value": "true" }, { "key": "flag" } ] }
          },
          "response": [
            { "name": "ok", "code": 200, "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Set-Cookie", "value": "sid=secret" } ], "body": "{\"id\":1,\"apiKey\":\"abc\"}" },
            { "name": "missing", "code": 404, "body": "" }
          ]
        },
        {
          "name": "No examples",
          "request": { "method": "GET", "url": "https://api.example.com/none" },
          "response": []
        }
      ]
    },
    {
      "name": "Create order",
      "request": {
        "method": "POST",
        "url": "https://api.example.com/orders?source=web&token=abc",
        "body": { "mode": "raw", "raw": "{\"item\":\"book\",\"clientSecret\":\"s\"}" }
      },
      "response": [ { "code": 201, "body": "created" } ]
    },
    {
      "name": "Raw only",
      "request": { "method": "DELETE", "url": { "raw": "https://api.example.com/orders/7?hard=1" } },
      "response": [ { "status": "No Content", "code": 204 } ]
    },
    {
      "request": { "method": "PATCH", "url": "{{baseUrl}}/templated" },
      "response": [ { "code": 200, "body": "patched" } ]
    },
    {
      "name": "String request",
      "request": "https://api.example.com/string",
      "response": [ { "code": 200 } ]
    },
    {
      "name": "***",
      "request": { "method": "GET", "url": {} },
      "response": [ { "code": "202" } ]
    }
  ]
}
