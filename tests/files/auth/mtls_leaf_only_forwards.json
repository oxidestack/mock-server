[
  {
    "httpRequest": {
      "path": "/via-tls/clear"
    },
    "httpOverrideForwardedRequest": {
      "requestOverride": {
        "method": "PUT",
        "path": "/mockserver/clear",
        "secure": true,
        "body": "{\"path\": \"/nothing\"}"
      }
    }
  },
  {
    "httpRequest": {
      "path": "/via-tls/retrieve"
    },
    "httpOverrideForwardedRequest": {
      "requestOverride": {
        "method": "PUT",
        "path": "/mockserver/retrieve",
        "queryStringParameters": {
          "type": [
            "ACTIVE_EXPECTATIONS"
          ]
        },
        "secure": true,
        "body": "{\"path\": \"/nothing\"}"
      }
    }
  },
  {
    "httpRequest": {
      "path": "/via-tls/audit"
    },
    "httpOverrideForwardedRequest": {
      "requestOverride": {
        "method": "GET",
        "path": "/mockserver/audit",
        "secure": true
      }
    }
  },
  {
    "httpRequest": {
      "path": "/whoami",
      "secure": true
    },
    "httpResponseTemplate": {
      "templateType": "MUSTACHE",
      "template": "{ \"statusCode\": 200, \"body\": \"{{request.clientCertificateChain}}\" }"
    }
  },
  {
    "httpRequest": {
      "path": "/via-tls/whoami"
    },
    "httpOverrideForwardedRequest": {
      "requestOverride": {
        "path": "/whoami",
        "secure": true
      }
    }
  }
]
