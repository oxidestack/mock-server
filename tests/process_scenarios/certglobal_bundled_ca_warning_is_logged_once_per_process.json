{
  "target": "both",
  "args": [
    "-serverPort",
    "{{serverPort}},{{serverPort2}}"
  ],
  "readiness": {
    "logContains": "started on port",
    "settleMillis": 1000
  },
  "afterReady": [
    {
      "tls": 1,
      "warmup": true
    },
    {
      "tls": 3,
      "label": "t"
    }
  ],
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "tls": {
      "t": "served"
    },
    "stdoutOccurrences": {
      "signing TLS traffic with the bundled default Certificate Authority": 1
    }
  }
}
