{
  "target": "both",
  "args": [
    "-serverPort",
    "{{serverPort}}",
    "-Dmockserver.x509CertificatePath={{files}}/tls/fixed-ok-cert.pem"
  ],
  "readiness": {
    "logContains": "started on port",
    "settleMillis": 1000
  },
  "afterReady": [
    {
      "tls": 1,
      "warmup": true
    },
    {
      "tls": 3,
      "label": "t"
    }
  ],
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "tls": {
      "t": "refused"
    },
    "stdoutContains": [
      "SSL or decoder fault caught by port unification handler",
      "Both 'privateKeyPath' and 'x509CertificatePath' must be configured together",
      "'privateKeyPath' is not set"
    ]
  }
}
