{
  "target": "both",
  "args": ["-serverPort", "0", "-logLevel", "WARN"],
  "env": {
    "MOCK_SERVER_NO_BROWSER": "1",
    "MOCKSERVER_PROPERTY_FILE": "{{files}}/properties/typo.properties"
  },
  "readiness": {
    "logContains": "logger level is"
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutContains": [
      "[INFO] Reading properties from property file [",
      "[WARN] unrecognised MockServer configuration properties-file key [mockserver.typoThing]",
      "[WARN] logger level is WARN"
    ]
  }
}
