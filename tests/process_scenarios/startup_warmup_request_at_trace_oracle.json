{
  "target": "oracleDocker",
  "args": ["-serverPort", "{{serverPort}}"],
  "env": {
    "MOCK_SERVER_NO_BROWSER": "1",
    "MOCKSERVER_LOG_LEVEL": "TRACE"
  },
  "readiness": {
    "logContains": "\"User-Agent\" : [ \"Java/26.0.2.1\" ]",
    "settleMillis": 4000
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutInOrder": [
      "started on port",
      " received request:\n\n  {\n    \"method\" : \"PUT\",\n    \"path\" : \"/mockserver/status\",\n    \"headers\" : {\n      \"content-length\" : [ \"0\" ],\n      \"User-Agent\" : [ \"Java/26.0.2.1\" ],\n      \"Host\" : [ \"127.0.0.1:",
      "      \"Connection\" : [ \"keep-alive\" ],\n      \"Accept\" : [ \"*/*\" ]\n    },\n    \"keepAlive\" : true,\n    \"secure\" : false,\n    \"protocol\" : \"HTTP_1_1\","
    ]
  }
}
