{
  "target": "both",
  "args": [
    "-serverPort",
    "0"
  ],
  "env": {
    "MOCK_SERVER_NO_BROWSER": "1",
    "MOCKSERVER_PROPERTY_FILE": "{{files}}/properties/json/value_plus_infinity_value.json"
  },
  "readiness": {
    "logContains": "AsyncAPI control-plane registered",
    "settleMillis": 3000
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutContains": [
      "  mockserver.a = Infinity\n"
    ],
    "stdoutNotContains": [
      "exception loading JSON property file"
    ]
  }
}
