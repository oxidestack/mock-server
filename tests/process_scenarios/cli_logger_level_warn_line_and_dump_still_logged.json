{
  "target": "both",
  "args": [
    "-p",
    "0",
    "-l",
    "WARN"
  ],
  "env": {
    "SERVER_PORT": "",
    "MOCK_SERVER_NO_BROWSER": "1"
  },
  "readiness": {
    "logContains": "logger level is"
  },
  "timeoutSecs": 90,
  "expect": {
    "running": true,
    "stdoutContains": [
      "[INFO] using environment variables:",
      "logLevel=WARN",
      "[WARN] logger level is WARN, change using:"
    ],
    "stdoutNotContains": [
      "started on port"
    ]
  }
}
