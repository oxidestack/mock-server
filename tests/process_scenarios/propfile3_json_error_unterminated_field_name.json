{
  "target": "both",
  "args": [
    "-serverPort",
    "0"
  ],
  "env": {
    "MOCK_SERVER_NO_BROWSER": "1",
    "MOCKSERVER_PROPERTY_FILE": "{{files}}/properties/json/syntax_unterminated_field_name.json"
  },
  "readiness": {
    "logContains": "exception loading JSON property file",
    "settleMillis": 3000
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutContains": [
      "[ERROR] exception loading JSON property file [{{files}}/properties/json/syntax_unterminated_field_name.json]",
      "shaded_package.com.fasterxml.jackson.core.io.JsonEOFException: Unexpected end-of-input in field name\n at [Source: REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); line: 1, column: 6]"
    ],
    "stdoutNotContains": [
      "Reading properties from property file"
    ]
  }
}
