{
  "target": "both",
  "args": ["-serverPort", "{{serverPort}}"],
  "env": {
    "MOCK_SERVER_NO_BROWSER": "1",
    "MOCKSERVER_LOCAL_BOUND_IP": "127.0.0.1"
  },
  "readiness": {
    "logContains": "started on port"
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutContains": ["[INFO] ", "started on port"],
    "stdoutNotContains": ["[ERROR]"]
  }
}
