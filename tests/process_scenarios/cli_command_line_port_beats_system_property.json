{
  "note": "MainTest.shouldPreferCliArgOverSystemProperty: -serverPort wins over mockserver.serverPort; the property asks for two ports, the option for one, and one is bound",
  "target": "both",
  "args": [
    "-Dmockserver.serverPort=0,0",
    "-serverPort",
    "0"
  ],
  "env": {
    "SERVER_PORT": "",
    "MOCK_SERVER_NO_BROWSER": "1"
  },
  "readiness": {
    "logContains": "started on port"
  },
  "timeoutSecs": 90,
  "expect": {
    "running": true,
    "stdoutContains": [
      "[INFO] started on port: "
    ],
    "stdoutNotContains": [
      "started on ports"
    ]
  }
}
