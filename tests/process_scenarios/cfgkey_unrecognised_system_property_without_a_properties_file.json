{
  "target": "both",
  "args": [
    "-serverPort",
    "{{serverPort}}",
    "-Dmockserver.typo=1",
    "-Dmockserver.propertyFile=/nonexistent/mockserver.properties"
  ],
  "readiness": {
    "logContains": "started on port",
    "settleMillis": 1000
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutContains": [
      "unrecognised MockServer configuration system property [mockserver.typo]"
    ],
    "stdoutOccurrences": {
      "unrecognised MockServer configuration ": 1
    }
  }
}
