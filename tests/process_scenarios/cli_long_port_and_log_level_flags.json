{
  "target": "both",
  "args": [
    "run",
    "--port",
    "0",
    "--log-level",
    "WARN"
  ],
  "env": {
    "SERVER_PORT": "",
    "MOCK_SERVER_NO_BROWSER": "1"
  },
  "readiness": {
    "logContains": "logger level is"
  },
  "timeoutSecs": 90,
  "expect": {
    "running": true,
    "stdoutContains": [
      "logLevel=WARN",
      "serverPort=0",
      "[WARN] logger level is WARN"
    ],
    "stdoutNotContains": [
      "started on port"
    ]
  }
}
