{
  "target": "both",
  "args": [
    "-serverPort",
    "{{serverPort}}"
  ],
  "propertyFile": "mockserver.metricsEnabled=true\nmockserver.logLevel=INFO\n",
  "readiness": {
    "logContains": "started on port",
    "settleMillis": 1000
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutContains": [
      "Reading properties from property file ["
    ],
    "stdoutNotContains": [
      "unrecognised MockServer configuration "
    ]
  }
}
