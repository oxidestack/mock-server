{
  "target": "both",
  "args": ["-serverPort", "{{serverPort}}"],
  "env": {
    "MOCK_SERVER_NO_BROWSER": "1",
    "MOCKSERVER_LOG_LEVEL": "TRACE",
    "MOCKSERVER_STARTUP_WARMUP": "false"
  },
  "readiness": {
    "logContains": "started on port",
    "settleMillis": 4000
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutContains": ["started on port"],
    "stdoutNotContains": ["\"Host\" : [ \"127.0.0.1:", "warm-up"]
  }
}
