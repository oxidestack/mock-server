{
  "target": "both",
  "args": [
    "-serverPort",
    "{{serverPort}}"
  ],
  "pickPort": true,
  "propertyFile": "mockserver.disableLogging=true\nmockserver.compactLogFormat=true\n",
  "readiness": {
    "logContains": "started on port"
  },
  "afterReady": [
    {
      "sleepMillis": 3000
    },
    {
      "http": {
        "method": "PUT",
        "path": "/mockserver/expectation",
        "ownHost": true,
        "body": "{\"id\": \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\", \"httpRequest\": {\"path\": \"/a\"}, \"httpResponse\": {\"body\": \"x\"}}",
        "expectStatus": 201
      }
    },
    {
      "http": {
        "method": "GET",
        "path": "/a",
        "ownHost": true,
        "expectStatus": 200
      }
    },
    {
      "sleepMillis": 500
    }
  ],
  "timeoutSecs": 90,
  "expect": {
    "running": true,
    "stdoutContains": [
      "Reading properties from property file",
      "using environment variables:\n",
      "creating expectation:\n\n  {",
      "received request:\n\n  {",
      "returning response:\n\n  {"
    ],
    "stdoutNotContains": []
  }
}
