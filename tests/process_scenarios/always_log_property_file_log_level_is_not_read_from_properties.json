{
  "target": "both",
  "args": ["-serverPort", "0"],
  "env": {
    "MOCK_SERVER_NO_BROWSER": "1",
    "MOCKSERVER_PROPERTY_FILE": "{{files}}/properties/warn.properties"
  },
  "readiness": {
    "logContains": "logger level is"
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutContains": [
      "[INFO] Reading properties from property file [",
      "  mockserver.logLevel = WARN\n",
      "[INFO] logger level is INFO, change using:"
    ]
  }
}
