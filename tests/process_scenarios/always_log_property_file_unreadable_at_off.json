{
  "target": "both",
  "args": ["-serverPort", "0"],
  "env": {
    "MOCK_SERVER_NO_BROWSER": "1",
    "MOCKSERVER_LOG_LEVEL": "OFF",
    "MOCKSERVER_PROPERTY_FILE": "/nonexistent-216/x.json"
  },
  "readiness": {
    "logContains": "could not be read",
    "settleMillis": 4000
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutContains": [
      "[WARN] JSON property file [/nonexistent-216/x.json] could not be read so none of its properties have been applied - /nonexistent-216/x.json (No such file or directory)"
    ],
    "stdoutNotContains": [
      "[INFO] ",
      "logger level is",
      "started on port"
    ]
  }
}
