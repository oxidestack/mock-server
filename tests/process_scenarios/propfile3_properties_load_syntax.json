{
  "target": "both",
  "args": [
    "-serverPort",
    "0"
  ],
  "env": {
    "MOCK_SERVER_NO_BROWSER": "1",
    "MOCKSERVER_PROPERTY_FILE": "{{files}}/properties/java_load.properties"
  },
  "readiness": {
    "logContains": "AsyncAPI control-plane registered",
    "settleMillis": 2000
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutContains": [
      "  a = 1\n",
      "  b = 2\n",
      "  c = 3\n",
      "  d = 4\n",
      "  e = 5\n",
      "  f = trailing \n",
      "  g = leadcontinued\n",
      "  h = no\\\n",
      "  i = after double backslash\n",
      "  j = odd\\k continues\n",
      "  l=m = escaped eq in key\n",
      "  n o = space in key\n",
      "  p = A\tx\n",
      "  q =\n",
      "  r =\n",
      "  t = a# not a comment\n",
      "  u = x ! y\n",
      "  v = a # b\n",
      "  w = 5\n",
      "  x = : 6\n",
      "  y = tabs\n",
      "  z = end\n"
    ],
    "stdoutNotContains": [
      "  comment =",
      "  bang comment",
      "  # not a comment"
    ]
  }
}
