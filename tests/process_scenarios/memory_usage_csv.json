{
  "note": "outputMemoryUsageCsv writes memoryUsage_<date>.csv in memoryUsageCsvDirectory: the header at startup, then a row on every 50th listener notification (one per expectation added, one per 250 ms window of event-log changes). 30 PUTs 400 ms apart make 60 notifications plus the startup ones, so exactly one row, written near the 24th PUT. The first five columns are upstream's; the heap columns are replaced by process figures (docs/divergences.md).",
  "target": "both",
  "pickPort": true,
  "args": [
    "-serverPort",
    "{{serverPort}}"
  ],
  "env": {
    "MOCKSERVER_OUTPUT_MEMORY_USAGE_CSV": "true",
    "MOCKSERVER_MEMORY_USAGE_CSV_DIRECTORY": "{{scratch}}"
  },
  "readiness": {
    "logContains": "started on port",
    "settleMillis": 2000
  },
  "timeoutSecs": 60,
  "afterReady": [
    {
      "http": {
        "method": "PUT",
        "path": "/mockserver/expectation",
        "body": "{\"httpRequest\": {\"path\": \"/csv1\"}, \"httpResponse\": {\"statusCode\": 200}}",
        "expectStatus": 201
      }
    },
    {
      "sleepMillis": 400
    },
    {
      "http": {
