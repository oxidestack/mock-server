{
  "note": "MainCliTest.shouldStartWithLongPortFlag: run --port starts the server",
  "target": "both",
  "args": [
    "run",
    "--port",
    "0"
  ],
  "env": {
    "SERVER_PORT": "",
    "MOCK_SERVER_NO_BROWSER": "1"
