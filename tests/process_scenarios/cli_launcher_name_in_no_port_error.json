{
  "note": "MainCliTest.shouldUseLauncherNameInNoPortError: mockserver.launcherName replaces the java -jar form in the no-port error",
  "target": "both",
  "args": [
    "-Dmockserver.launcherName=mockserver"
  ],
  "env": {
    "SERVER_PORT": ""
  },
  "readiness": {
    "exit": true
  },
  "timeoutSecs": 60,
  "expect": {
    "running": false,
    "exitCode": 0,
    "stderrContains": [
      "(e.g. mockserver -p 1080)"
    ],
    "stderrNotContains": [
      "java -jar"
    ],
    "compareOutput": true
  }
}
