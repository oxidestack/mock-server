{
  "target": "both",
  "args": ["-serverPort", "0"],
  "env": {
    "MOCKSERVER_FAIL_ON_INITIALIZATION_ERROR": "true",
    "MOCKSERVER_INITIALIZATION_CLASS": "org.mockserver.server.initialize.NoSuchInitializerClass",
    "MOCK_SERVER_NO_BROWSER": "1"
  },
  "readiness": {
    "exit": true
  },
  "timeoutSecs": 90,
  "expect": {
    "running": false,
    "exitCode": 1,
    "stdoutContains": [
      "[ERROR] exception while starting:{}",
      "failing startup for:org.mockserver.server.initialize.NoSuchInitializerClass"
    ],
    "stderrNotContains": [
      "[ERROR] ",
      "exception while starting",
      "failing startup for"
    ]
  }
}
