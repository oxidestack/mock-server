{
  "note": "an EC JWK whose x5c certificate carries the same key as a compressed point (BouncyCastle decompresses it)",
  "target": "both",
  "args": [
    "-serverPort",
    "{{serverPort}}"
  ],
  "files": {
    "jwks.json": "{\"keys\": [{\"kty\": \"EC\", \"crv\": \"P-256\", \"x\": \"czDQTQyg_Ql8JrS5Bz3SzvvnZ3Tvnt-j8w-7m7ozqHQ\", \"y\": \"2dn5ALJtDhzOem4xtzb3q5ZRKHmgy4k73GUMVLnApg8\", \"x5c\": [\"\"]}]}"
  },
  "propertyFile": "mockserver.controlPlaneJWTAuthenticationRequired=true\nmockserver.controlPlaneJWTAuthenticationJWKSource={{scratch}}/jwks.json\n",
  "readiness": {
    "logContains": "started on port"
  },
  "afterReady": [
    {
      "http": {
        "method": "PUT",
        "path": "/mockserver/retrieve",
        "ownHost": true,
        "expectStatus": 401,
        "expectBodyContains": "Unauthorized for control plane - no authorization header found"
      }
    },
    {
      "http": {
        "method": "PUT",
        "path": "/mockserver/retrieve",
        "ownHost": true,
        "expectStatus": 401,
        "expectBodyContains": "Unauthorized for control plane - no authorization header found"
      }
    },
    {
      "http": {
        "method": "PUT",
        "path": "/mockserver/clear",
        "ownHost": true,
        "expectStatus": 401,
        "expectBodyContains": "Unauthorized for control plane - no authorization header found"
      }
    },
    {
      "sleepMillis": 500
    }
  ],
  "timeoutSecs": 90,
  "expect": {
    "running": true,
    "stdoutOccurrences": {
      "exception building JWT validator for:": 0,
      "authentication handler could not be created": 0
    }
  }
}
