{
  "target": "both",
  "args": [
    "-serverPort",
    "{{serverPort}}",
    "-Dmockserver.typo=1"
  ],
  "propertyFile": "mockserver.typo=1\n",
  "readiness": {
    "logContains": "started on port",
    "settleMillis": 1000
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutContains": [
      "unrecognised MockServer configuration system property [mockserver.typo]"
    ],
    "stdoutNotContains": [
      "properties-file key [mockserver.typo]"
    ],
    "stdoutOccurrences": {
      "unrecognised MockServer configuration ": 1
    }
  }
}
