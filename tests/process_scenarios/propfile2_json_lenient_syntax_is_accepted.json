{
  "target": "both",
  "args": [
    "-serverPort",
    "0"
  ],
  "env": {
    "MOCK_SERVER_NO_BROWSER": "1",
    "MOCKSERVER_PROPERTY_FILE": "{{files}}/properties/json/lenient.json"
  },
  "readiness": {
    "logContains": "AsyncAPI control-plane registered",
    "settleMillis": 2000
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutContains": [
      "  mockserver.maxExpectations = 5\n",
      "  mockserver.typoUnquoted = single\n",
      "  mockserver.zeros = 7\n",
      "  mockserver.trailing = [Ljava.lang.Object;@"
    ],
    "stdoutNotContains": [
      "exception loading JSON property file",
      "mockserver.ignored"
    ]
  }
}
