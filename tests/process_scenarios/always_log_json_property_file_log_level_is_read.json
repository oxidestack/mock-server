{
  "target": "both",
  "args": ["-serverPort", "0"],
  "env": {
    "MOCK_SERVER_NO_BROWSER": "1",
    "MOCKSERVER_PROPERTY_FILE": "{{files}}/properties/warn.json"
  },
  "readiness": {
    "logContains": "logger level is"
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutContains": [
      "[WARN] unrecognised MockServer configuration properties-file key [mockserver.typoThing]",
      "[WARN] logger level is WARN"
    ],
    "stdoutNotContains": [
      "Reading properties from property file",
      "started on port"
    ]
  }
}
