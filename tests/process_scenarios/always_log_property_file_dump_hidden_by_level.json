{
  "target": "both",
  "args": ["-serverPort", "0"],
  "env": {
    "MOCK_SERVER_NO_BROWSER": "1",
    "MOCKSERVER_PROPERTY_FILE": "{{files}}/properties/typo.properties",
    "MOCKSERVER_LOG_LEVEL": "ERROR"
  },
  "readiness": {
    "logContains": "logger level is"
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutNotContains": [
      "Reading properties from property file",
      "unrecognised MockServer configuration"
    ]
  }
}
