{
  "target": "oracleDocker",
  "args": ["-serverPort", "0", "-proxyRemotePort", "80", "-proxyRemoteHost", "example.com"],
  "readiness": {
    "logContains": "started on port:"
  },
  "timeoutSecs": 120,
  "expect": {
    "running": true,
    "stdoutContains": [
      "[INFO]",
      "started on port:"
    ],
    "stdoutNotContains": [
      "started on port with proxy"
    ]
  }
}
