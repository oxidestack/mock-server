{
  "target": "both",
  "args": [
    "-serverPort",
    "{{serverPort}}"
  ],
  "env": {
    "JAVA_HOME": "/opt/unrelated",
    "HOME": "/srv/unrelated",
    "MOCK_SERVER_NOT_NAMESPACED": "1"
  },
  "readiness": {
    "logContains": "started on port",
    "settleMillis": 1000
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutNotContains": [
      "unrecognised MockServer configuration "
    ]
  }
}
