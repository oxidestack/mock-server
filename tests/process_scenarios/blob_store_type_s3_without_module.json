{
  "target": "both",
  "args": ["-serverPort", "{{serverPort}}"],
  "env": {
    "MOCK_SERVER_NO_BROWSER": "1",
    "MOCKSERVER_BLOB_STORE_TYPE": "s3"
  },
  "readiness": {
    "exit": true
  },
  "timeoutSecs": 120,
  "expect": {
    "running": false,
    "exitCode": 1,
    "stdoutInOrder": [
      "[ERROR] exception while starting:{}\njava.lang.IllegalStateException: blobStoreType=s3 configured but org.mockserver.blob.s3.S3BlobStoreRegistrar is not on the classpath; add the mockserver-blob-s3 dependency\n",
      "Caused by: java.lang.ClassNotFoundException: org.mockserver.blob.s3.S3BlobStoreRegistrar"
    ],
    "stdoutNotContains": ["started on port", "valid options are:"],
    "stderrNotContains": ["exception while starting"]
  }
}
