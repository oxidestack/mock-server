{
  "target": "both",
  "args": ["-serverPort", "0"],
  "env": {
    "MOCK_SERVER_NO_BROWSER": "1"
  },
  "readiness": {
    "logContains": "logger level is",
    "settleMillis": 3000
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutInOrder": [
      "using environment variables:",
      "[WARN] Forward proxy is configured to trust ALL X.509 certificates",
      "[WARN] MockServer is signing TLS traffic with the bundled default Certificate Authority",
      "[INFO] AsyncAPI control-plane registered",
      "started on port:",
      "loaded CA X509 from path",
      "file:/mockserver.jar!/org/mockserver/socket/CertificateAuthorityCertificate.pem",
      "[WARN] ",
      "MockServer proxy setup",
      "WARNING: The default CA private key is published in the MockServer repository"
    ],
    "stdoutContains": [
      "logger level is INFO"
    ],
    "stdoutNotContains": [
      "loaded CA private key",
      "created dynamic"
    ]
  }
}
