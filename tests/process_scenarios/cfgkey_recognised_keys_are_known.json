{
  "target": "both",
  "args": [
    "-serverPort",
    "{{serverPort}}",
    "-Dmockserver.maxExpectations=50",
    "-Dmockserver.metricsEnabled=true",
    "-Dmockserver.logLevel=INFO"
  ],
  "env": {
    "MOCKSERVER_MAX_EXPECTATIONS": "50",
    "MOCKSERVER_METRICS_ENABLED": "true",
    "MOCKSERVER_LOG_LEVEL": "INFO"
  },
  "readiness": {
    "logContains": "started on port",
    "settleMillis": 1000
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutNotContains": [
      "unrecognised MockServer configuration "
    ]
  }
}
