{
  "note": "without JVM-only input there is no JVM-only notice; map and support inputs (nioEventLoopThreadCount, the trust manager type JVM, velocityDisallowClassLoading=true) and blank JVM options do not count",
  "target": "both",
  "args": [
    "-serverPort",
    "{{serverPort}}",
    "-Dmockserver.velocityDisallowClassLoading=true"
  ],
  "env": {
    "JAVA_TOOL_OPTIONS": " ",
    "MOCKSERVER_NIO_EVENT_LOOP_THREAD_COUNT": "2",
    "MOCKSERVER_FORWARD_PROXY_TLS_X509_CERTIFICATES_TRUST_MANAGER_TYPE": "JVM"
  },
  "readiness": {
    "logContains": "started on port",
    "settleMillis": 500
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutNotContains": [
      "JVM-only settings"
    ]
  }
}
