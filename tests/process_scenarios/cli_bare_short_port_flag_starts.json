{
  "note": "MainCliTest.shouldStartWithBarePortFlagNoSubcommand and shouldPrependRunWhenNoSubcommand: -p without a subcommand runs the server",
  "target": "both",
  "args": [
    "-p",
    "0"
  ],
  "env": {
    "SERVER_PORT": "",
    "MOCK_SERVER_NO_BROWSER": "1"
  },
  "readiness": {
    "logContains": "started on port"
  },
  "timeoutSecs": 90,
  "expect": {
    "running": true,
    "stdoutContains": [
      "serverPort=0",
      "[INFO] started on port: "
    ]
  }
}
