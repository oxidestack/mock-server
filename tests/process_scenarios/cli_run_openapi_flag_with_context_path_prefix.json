{
  "target": "both",
  "args": [
    "run",
    "--port",
    "{{serverPort}}",
    "--openapi",
    "{{files}}/init/openapi.yaml",
    "-Dmockserver.openAPIContextPathPrefix=/svc"
  ],
  "env": {
    "SERVER_PORT": "",
    "MOCK_SERVER_NO_BROWSER": "1"
  },
  "readiness": {
    "logContains": "started on port"
  },
  "afterReady": [
    {"http": {"method": "GET", "path": "/svc/init/ping", "ownHost": true, "expectStatus": 200, "expectBodyContains": "pong"}},
    {"http": {"method": "GET", "path": "/init/ping", "ownHost": true, "expectStatus": 404}}
  ],
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutContains": ["started on port"]
  }
}
