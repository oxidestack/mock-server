{
  "note": "MainCliTest.shouldPreserveExplicitProxySetupLoggingOptOutOnStandaloneLaunch: the launcher turns proxySetupLogging on only when no source set it; an explicit false stays false, so no setup block is printed",
  "target": "both",
  "args": [
    "run",
    "-p",
    "0",
    "-Dmockserver.proxySetupLogging=false"
  ],
  "env": {
    "SERVER_PORT": "",
    "MOCK_SERVER_NO_BROWSER": "1"
  },
  "readiness": {
    "logContains": "started on port",
    "settleMillis": 1500
  },
  "timeoutSecs": 90,
  "expect": {
    "running": true,
    "stdoutContains": [
      "mockserver.proxySetupLogging=false",
      "[INFO] started on port: "
    ],
    "stdoutNotContains": [
      "mockserver.proxySetupLogging=true",
      "MockServer proxy setup",
      "CA certificate:"
    ]
  }
}
