{
  "target": "both",
  "args": ["-serverPort", "0"],
  "env": {
    "MOCK_SERVER_NO_BROWSER": "1",
    "MOCKSERVER_LOG_LEVEL_OVERRIDES": "{\"SERVER_CONFIGURATION\":\"OFF\",\"GENERAL\":\"WARNING\"}"
  },
  "readiness": {
    "logContains": "logger level is"
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutContains": [
      "using environment variables:",
      "started on port",
      "loaded CA X509 from path",
      "Forward proxy is configured to trust ALL X.509 certificates",
      "MockServer proxy setup"
    ]
  }
}
