{
  "note": "extensions=' , ' names nothing, so the server starts normally",
  "target": "both",
  "args": [
    "-serverPort",
    "{{serverPort}}"
  ],
  "env": {
    "MOCK_SERVER_NO_BROWSER": "1",
    "MOCKSERVER_EXTENSIONS": " , "
  },
  "readiness": {
    "logContains": "started on port"
  },
  "timeoutSecs": 120,
  "expect": {
    "running": true,
    "stdoutContains": [
      "[INFO] started on port: "
    ],
    "stdoutNotContains": [
      "exception while starting",
      "ExtensionException"
    ]
  }
}
