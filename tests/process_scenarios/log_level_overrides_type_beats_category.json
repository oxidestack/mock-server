{
  "target": "both",
  "args": ["-serverPort", "0"],
  "env": {
    "MOCK_SERVER_NO_BROWSER": "1",
    "MOCKSERVER_LOG_LEVEL_OVERRIDES": "{\"SERVER\":\"ERROR\",\"SERVER_CONFIGURATION\":\"INFO\"}"
  },
  "readiness": {
    "logContains": "logger level is"
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutContains": [
      "using environment variables:",
      "started on port",
      "MockServer proxy setup",
      "logger level is INFO"
    ]
  }
}
