{
  "target": "both",
  "args": [
    "-serverPort",
    "{{serverPort}}"
  ],
  "env": {
    "MOCKSERVER_LAUNCHER": "mockserver"
  },
  "readiness": {
    "logContains": "started on port",
    "settleMillis": 1000
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutNotContains": [
      "unrecognised MockServer configuration "
    ]
  }
}
