{
  "target": "both",
  "args": ["-serverPort", "0"],
  "env": {
    "MOCK_SERVER_NO_BROWSER": "1",
    "MOCKSERVER_LOG_LEVEL": "OFF",
    "MOCKSERVER_PROPERTY_FILE": "{{files}}/properties/bad.json"
  },
  "readiness": {
    "logContains": "Unexpected end-of-input",
    "settleMillis": 4000
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutContains": [
      "[ERROR] exception loading JSON property file [{{files}}/properties/bad.json]",
      "JsonParseException: Unexpected end-of-input within/between Object entries",
      "line: 1, column: 22]"
    ],
    "stdoutNotContains": [
      "logger level is",
      "started on port"
    ]
  }
}
