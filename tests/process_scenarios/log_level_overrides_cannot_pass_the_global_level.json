{
  "target": "both",
  "args": ["-serverPort", "0"],
  "env": {
    "MOCK_SERVER_NO_BROWSER": "1",
    "MOCKSERVER_LOG_LEVEL": "WARN",
    "MOCKSERVER_LOG_LEVEL_OVERRIDES": "{\"SERVER_CONFIGURATION\":\"INFO\"}"
  },
  "readiness": {
    "logContains": "logger level is",
    "settleMillis": 3000
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutContains": [
      "[WARN] ",
      "MockServer proxy setup",
      "logger level is WARN"
    ],
    "stdoutNotContains": [
      "[INFO] ",
      "started on port",
      "loaded CA X509 from path"
    ]
  }
}
