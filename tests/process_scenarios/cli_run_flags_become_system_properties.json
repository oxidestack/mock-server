{
  "target": "both",
  "args": [
    "-p",
    "0",
    "--watch",
    "--persist",
    "persisted.json",
    "--validate-openapi",
    "{{files}}/openapi/openapi.yaml",
    "--validate-enforce"
  ],
  "env": {
    "SERVER_PORT": "",
    "MOCK_SERVER_NO_BROWSER": "1"
  },
  "readiness": {
    "logContains": "logger level is"
  },
  "timeoutSecs": 90,
  "expect": {
    "running": true,
    "stdoutContains": [
      "mockserver.watchInitializationJson=true",
      "mockserver.persistExpectations=true",
      "mockserver.persistedExpectationsPath=persisted.json",
      "mockserver.validateProxyOpenAPISpec={{files}}/openapi/openapi.yaml",
      "mockserver.validateProxyEnforce=true"
    ]
  }
}
