{
  "note": "a JWK source file and controlPlaneTLSMutualAuthenticationCAChain resolve on the class path roots of MOCK_SERVER_CLASS_PATH (JWTAuthenticationHandler's FilePath.absolutePathFromClassPathOrPath, PEMToFile.x509ChainFromPEMFile), so both handlers build and nothing denies all",
  "target": "binary",
  "args": [
    "-serverPort",
    "{{serverPort}}"
  ],
  "env": {
    "MOCK_SERVER_CLASS_PATH": "{{scratch}}/classes"
  },
  "files": {
    "classes/keys/jwks.json": "{\"keys\": [{\"kty\": \"RSA\", \"n\": \"zBNDa1oY23bvXJZrscpVb9ZOByt9Ygo5FpOTPFWppnPvMrnvTGj2wAj7C6rzhytf_nvNgXCG_98_pvjdIOlHoXGP-IGWwm2XNtYwgOuudun4ECwq_t0pfTizQlRX8edvoJfwozcxDZ4vked3Jp3X2-fZ7F9xuFcPNrbRyV8QUSc\", \"e\": \"AQAB\", \"x5c\": [\"\"]}]}",
    "classes/tls/ca.pem": {
      "from": "tls/ca.pem"
    }
  },
  "propertyFile": "mockserver.controlPlaneJWTAuthenticationRequired=true\nmockserver.controlPlaneJWTAuthenticationJWKSource=keys/jwks.json\nmockserver.controlPlaneTLSMutualAuthenticationRequired=true\nmockserver.controlPlaneTLSMutualAuthenticationCAChain=tls/ca.pem\n",
  "readiness": {
    "logContains": "started on port"
  },
  "afterReady": [
    {
      "http": {
        "method": "PUT",
        "path": "/mockserver/retrieve",
        "ownHost": true,
        "expectStatus": 401
      }
    },
    {
      "http": {
        "method": "PUT",
        "path": "/mockserver/clear",
        "ownHost": true,
        "expectStatus": 401
      }
    },
    {
      "sleepMillis": 500
    }
  ],
  "timeoutSecs": 90,
  "expect": {
    "running": true,
    "stdoutOccurrences": {
      "exception building JWT validator for:": 0,
      "authentication handler could not be created": 0,
      "Exception reading X509 from PEM file": 0
    }
  }
}
