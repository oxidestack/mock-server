{
  "target": "binary",
  "args": [
    "-serverPort",
    "0",
    "-logLevel",
    "WARNING"
  ],
  "readiness": {
    "logContains": "Forward proxy is configured to trust ALL X.509 certificates"
  },
  "timeoutSecs": 10,
  "expect": {
    "running": true,
    "stdoutContains": [
      "[WARN]"
    ],
    "stdoutNotContains": [
      "started on port"
    ],
    "stderrContains": [],
    "stderrNotContains": [
      "started on port",
      "[WARN] "
    ]
  }
}
