{
  "source": "every ConfigurationProperties property with a blank or unlisted default, which the config_tier_* scenarios cannot set to its default, set through -D to a value that leaves the server starting; GET /mockserver/config reports each with its value (credentials masked) and the system-property tier.",
  "target": "both",
  "args": [
    "-serverPort",
    "{{serverPort}}",
    "-Dmockserver.dashboardAnalyticsEndpoint=https://analytics.example/ingest",
    "-Dmockserver.dashboardAnalyticsKey=analytics-key-502",
    "-Dmockserver.loadGenerationMetricLabels=team, env",
    "-Dmockserver.maxFutureTimeout=90000",
    "-Dmockserver.maxSocketTimeout=20000",
    "-Dmockserver.socketConnectionTimeout=20000",
    "-Dmockserver.connectionDelayMillis=5",
    "-Dmockserver.llmProvider=openai",
    "-Dmockserver.llmApiKey=llm-key-502",
    "-Dmockserver.llmModel=gpt-test",
    "-Dmockserver.llmBaseUrl=http://127.0.0.1:1",
    "-Dmockserver.llmBackendsConfig=[{\"name\":\"openai\",\"apiKey\":\"backend-key-502\"}]",
    "-Dmockserver.driftAlertWebhookUrl=http://127.0.0.1:1/drift",
    "-Dmockserver.auditLogFile={{scratch}}/audit.log",
    "-Dmockserver.fixtureBodyRedactFields=secret,apiKey",
    "-Dmockserver.otelEndpoint=http://127.0.0.1:1",
    "-Dmockserver.prometheusRemoteWriteUrl=http://127.0.0.1:1/api/v1/write",
    "-Dmockserver.prometheusRemoteWriteBearerToken=prom-token-502",
    "-Dmockserver.prometheusRemoteWriteBasicAuthUsername=prom-user",
    "-Dmockserver.prometheusRemoteWriteBasicAuthPassword=prom-password-502",
    "-Dmockserver.prometheusRemoteWriteHeaders=X-Scope-OrgID=tenant-a",
    "-Dmockserver.perExpectationMetrics=true",
    "-Dmockserver.grpcDescriptorDirectory={{files}}/grpc",
    "-Dmockserver.grpcProtoDirectory={{files}}/grpc/proto",
    "-Dmockserver.http3ConnectUdpAllowedTargets=allowed.example.com:443",
    "-Dmockserver.corsAllowOrigin=https://allowed.example",
    "-Dmockserver.corsAllowMethods=GET, PUT",
    "-Dmockserver.corsAllowHeaders=Authorization, X-Custom",
    "-Dmockserver.defaultResponseHeaders=X-Default=one|Cache-Control=no-cache, no-store",
    "-Dmockserver.javascriptDisallowedClasses=java.lang.Runtime",
    "-Dmockserver.javascriptAllowedClasses=java.lang.String",
    "-Dmockserver.javascriptDisallowedText=exec(",
    "-Dmockserver.velocityDisallowedText=request.class",
    "-Dmockserver.mustacheDisallowedText=request.method",
    "-Dmockserver.validateProxyOpenAPISpec={{files}}/openapi/openapi_petstore_example.json",
    "-Dmockserver.blobStoreBucket=bucket-502",
    "-Dmockserver.blobStoreRegion=eu-west-1",
    "-Dmockserver.blobStoreEndpoint=http://127.0.0.1:1",
    "-Dmockserver.blobStoreKeyPrefix=prefix/",
    "-Dmockserver.blobStoreAccessKeyId=access-key-id-502",
    "-Dmockserver.blobStoreSecretAccessKey=secret-key-502",
    "-Dmockserver.blobStoreContainer=container-502",
    "-Dmockserver.blobStoreConnectionString=conn-string-502",
    "-Dmockserver.blobStoreProjectId=project-502",
    "-Dmockserver.clusterVerifyFanInPeers=http://127.0.0.1:1",
    "-Dmockserver.clusterFanInPeerAuthToken=peer-token-502",
    "-Dmockserver.forwardHttpsProxy=127.0.0.1:1",
    "-Dmockserver.forwardProxyAuthenticationUsername=forward-user",
    "-Dmockserver.forwardProxyAuthenticationPassword=forward-password-502",
    "-Dmockserver.proxyAuthenticationUsername=proxy-user",
    "-Dmockserver.proxyAuthenticationPassword=proxy-password-502",
    "-Dmockserver.dataPlaneBasicAuthenticationUsername=user",
    "-Dmockserver.dataPlaneBasicAuthenticationPassword=basic-password-502",
    "-Dmockserver.dataPlaneBearerAuthenticationToken=bearer-token-502",
    "-Dmockserver.dataPlaneApiKeyAuthenticationHeader=x-api-key",
    "-Dmockserver.dataPlaneApiKeyAuthenticationValue=api-key-502",
    "-Dmockserver.noProxyHosts=localhost,*.internal.invalid",
    "-Dmockserver.proxyRemoteHost=127.0.0.1",
    "-Dmockserver.proxyRemotePort=1",
    "-Dmockserver.forwardDefaultHostHeader=configured.example:9999",
    "-Dmockserver.proxyPass=[{\"pathPrefix\":\"/api/\",\"targetUri\":\"http://127.0.0.1:1/services/\"}]",
    "-Dmockserver.globalResponseDelayMillis=1",
    "-Dmockserver.livenessHttpGetPath=/liveness/probe",
    "-Dmockserver.controlPlanePrivateKeyPath={{files}}/tls/fixed-ok-key.pem",
    "-Dmockserver.controlPlaneX509CertificatePath={{files}}/tls/fixed-ok-cert.pem",
    "-Dmockserver.controlPlaneJWTAuthenticationExpectedAudience=https://mock-server.com",
    "-Dmockserver.controlPlaneJWTAuthenticationRequiredClaims=name,admin",
    "-Dmockserver.controlPlaneOidcIssuer=https://issuer.example",
    "-Dmockserver.controlPlaneOidcJwksUri={{files}}/oidc/jwks.json",
    "-Dmockserver.controlPlaneOidcAudience=mockserver",
    "-Dmockserver.controlPlaneOidcRequiredScopes=s1,s2",
    "-Dmockserver.controlPlaneScopeMapping=readers=read,admins=admin",
    "-Dmockserver.tlsMutualAuthenticationCertificateChain={{files}}/tls/private-ca/ca-cert.pem",
    "-Dmockserver.forwardProxyTLSCustomTrustX509Certificates={{files}}/tls/fwd-ca.pem",
    "-Dmockserver.forwardProxyPrivateKey={{files}}/tls/fwd-client-key.pem",
    "-Dmockserver.forwardProxyCertificateChain={{files}}/tls/fwd-client-cert.pem",
    "-Dmockserver.forwardProxyClientCertificatesByHost=localhost={{files}}/tls/fwd-client-cert.pem;{{files}}/tls/fwd-client-key.pem",
    "-Dmockserver.asyncKafkaBootstrapServers=127.0.0.1:1",
    "-Dmockserver.asyncMqttBrokerUrl=tcp://127.0.0.1:1",
    "-Dmockserver.asyncAmqpUri=amqp://127.0.0.1:1",
    "-Dmockserver.customJsonUnitMatchersClass=org.example.NoSuchMatchers",
    "-Dmockserver.clusterTransportConfig={{files}}/no-such-jgroups.xml"
  ],
  "readiness": {
    "logContains": "started on port",
    "settleMillis": 500
  },
  "timeoutSecs": 150,
  "afterReady": [
    {
      "http": {
        "method": "GET",
        "path": "/mockserver/config",
        "compareBody": "config"
      }
    }
  ],
  "expect": {
    "running": true
  }
}
