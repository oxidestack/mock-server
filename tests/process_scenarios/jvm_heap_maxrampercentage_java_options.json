{
  "source": "_JAVA_OPTIONS comes after the ENTRYPOINT's -XX:MaxRAMPercentage=45.0, so 25 replaces it: the ceiling is a quarter of the container's 8 GiB (G1 does not apply, the image's ZGC does: 2 MiB alignment), and the heap-derived defaults follow it.",
  "target": "both",
  "args": [
    "-serverPort",
    "{{serverPort}}"
  ],
  "env": {
    "_JAVA_OPTIONS": "-XX:MaxRAMPercentage=25"
  },
  "containerMemoryBytes": 8589934592,
  "readiness": {
    "logContains": "started on port",
    "settleMillis": 500
  },
  "timeoutSecs": 150,
  "afterReady": [
    {
      "http": {
        "method": "GET",
        "path": "/mockserver/config",
        "compareBody": "config"
      }
    },
    {
      "http": {
        "method": "GET",
        "path": "/mockserver/configuration",
        "compareBody": "configuration"
      }
    }
  ],
  "expect": {
    "running": true
  }
}
