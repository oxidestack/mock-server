{
  "target": "both",
  "args": [
    "-serverPort",
    "0"
  ],
  "env": {
    "MOCK_SERVER_NO_BROWSER": "1",
    "MOCKSERVER_PROPERTY_FILE": "{{files}}/properties/log_level_overrides.json"
  },
  "readiness": {
    "logContains": "AsyncAPI control-plane registered",
    "settleMillis": 2000
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutContains": [
      "[INFO] Reading properties from property file [",
      "mockserver.logLevelOverrides = {\"SERVER_CONFIGURATION\":\"ERROR\"}",
      "[INFO] using environment variables:",
      "[INFO] logger level is INFO, change using:"
    ],
    "stdoutNotContains": []
  }
}
