{
  "target": "both",
  "args": [
    "lint",
    "{{files}}/lint/clean.json",
    "{{files}}/lint/absent.json",
    "{{files}}/lint/malformed.json",
    "{{files}}/lint/scalar.json",
    "{{files}}/lint/empty.json"
  ],
  "env": {
    "SERVER_PORT": ""
  },
  "readiness": {
    "exit": true
  },
  "timeoutSecs": 90,
  "expect": {
    "running": false,
    "exitCode": 1,
    "compareOutput": true
  }
}
