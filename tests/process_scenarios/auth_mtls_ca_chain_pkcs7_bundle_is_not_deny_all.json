{
  "note": "a DER PKCS#7 bundle (openssl crl2pkcs7) is read as its two certificates",
  "target": "both",
  "args": [
    "-serverPort",
    "{{serverPort}}"
  ],
  "files": {
    "ca.pem": {
      "from": "x509/p7b.der"
    }
  },
  "propertyFile": "mockserver.controlPlaneTLSMutualAuthenticationRequired=true\nmockserver.controlPlaneTLSMutualAuthenticationCAChain={{scratch}}/ca.pem\n",
  "readiness": {
    "logContains": "started on port"
  },
  "afterReady": [
    {
      "http": {
        "method": "PUT",
        "path": "/mockserver/retrieve",
        "ownHost": true,
        "expectStatus": 401,
        "expectBodyContains": "Unauthorized for control plane - control plane request failed authentication no client certificates found"
      }
    },
    {
      "http": {
        "method": "PUT",
        "path": "/mockserver/retrieve",
        "ownHost": true,
        "expectStatus": 401,
        "expectBodyContains": "Unauthorized for control plane - control plane request failed authentication no client certificates found"
      }
    },
    {
      "http": {
        "method": "PUT",
        "path": "/mockserver/clear",
        "ownHost": true,
        "expectStatus": 401,
        "expectBodyContains": "Unauthorized for control plane - control plane request failed authentication no client certificates found"
      }
    },
    {
      "sleepMillis": 500
    }
  ],
  "timeoutSecs": 90,
  "expect": {
    "running": true,
    "stdoutOccurrences": {
      "authentication handler could not be created": 0
    }
  }
}
