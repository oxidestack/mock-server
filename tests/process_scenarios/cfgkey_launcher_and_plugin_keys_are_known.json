{
  "target": "both",
  "args": [
    "-serverPort",
    "{{serverPort}}",
    "-Dmockserver.mockServerPort=1",
    "-Dmockserver.launcherName=mockserver"
  ],
  "env": {
    "MOCKSERVER_JAVA_OPTS": "-Xmx1g"
  },
  "readiness": {
    "logContains": "started on port",
    "settleMillis": 1000
  },
  "timeoutSecs": 150,
  "expect": {
    "running": true,
    "stdoutNotContains": [
      "unrecognised MockServer configuration "
    ]
  }
}
