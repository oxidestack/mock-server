{
  "target": "both",
  "args": [
    "openapi",
    "{{files}}/openapi/openapi.yaml",
    "-p",
    "0"
  ],
  "env": {
    "SERVER_PORT": "",
    "MOCK_SERVER_NO_BROWSER": "1"
  },
  "readiness": {
    "logContains": "logger level is"
  },
  "timeoutSecs": 90,
  "expect": {
    "running": true,
    "stdoutContains": [
      "mockserver.initializationOpenAPIPath={{files}}/openapi/openapi.yaml",
      "started on port"
    ]
  }
}
