  {
   "method": "PUT",
   "path": "/mockserver/reset"
  },
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "path": "/t0"
    },
    "httpResponseTemplate": {
     "templateType": "VELOCITY",
     "template": "{\n    'statusCode': 200,\n    'body': \"one=$lists.pickRandom('a') | list=$lists.pickRandom(['only']) | map=$lists.pickRandom({'k':'v'}) | str=$lists | class=$lists.getClass().getName()\"\n}"
    }
   }
  },
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "path": "/t1"
    },
    "httpResponseTemplate": {
     "templateType": "VELOCITY",
     "template": "{\n    'statusCode': 200,\n    'body': \"array=$lists.array('a', 'b', 3) | copy=$lists.array(['x', 'y']) | map=$lists.array({'a':1,'b':2}) | empty=$lists.array() | size=$lists.array('a','b').size()\"\n}"
    }
   }
  },
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
