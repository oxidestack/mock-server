{
 "properties": {
  "jsonSchemaAllowRemoteRefs": "true"
 },
 "peer": true,
 "steps": [
  {
   "note": "serve /ext/pet.json",
   "node": "peer",
   "maxMillis": 30000,
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "method": "GET",
     "path": "/ext/pet.json"
    },
    "httpResponse": {
     "headers": {
      "content-type": [
       "application/json"
      ]
     },
     "body": {
      "json": {
       "type": "object",
       "required": [
        "name"
       ],
       "properties": {
        "name": {
         "type": "string",
         "minLength": 2
        },
        "age": {
         "type": "integer",
         "minimum": 0
        },
        "tag": {
         "enum": [
          "a",
          "b"
         ]
        },
        "code": {
         "pattern": "^[A-Z]+$"
        }
       },
       "additionalProperties": false
      }
     }
    }
   }
  },
  {
   "note": "serve /ext/defs.json",
   "node": "peer",
   "maxMillis": 30000,
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "method": "GET",
     "path": "/ext/defs.json"
    },
    "httpResponse": {
     "headers": {
      "content-type": [
       "application/json"
      ]
     },
     "body": {
      "json": {
       "definitions": {
        "pet": {
         "$ref": "pet.json"
        },
        "id": {
         "type": "integer"
        }
       }
      }
     }
    }
   }
  },
  {
   "note": "serve /ext/text.json",
   "node": "peer",
   "maxMillis": 30000,
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "method": "GET",
     "path": "/ext/text.json"
    },
    "httpResponse": {
     "headers": {
      "content-type": [
       "text/plain"
      ]
     },
     "body": "hello"
    }
   }
  },
  {
   "note": "serve /ext/unbuilt.json",
   "node": "peer",
   "maxMillis": 30000,
   "method": "PUT",
