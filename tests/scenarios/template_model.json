    "Content-Type": "application/json"
   }
  },
  {
   "method": "POST",
   "path": "/rpc",
   "note": "/rpc: with params",
   "body": "{\"jsonrpc\": \"2.0\", \"method\": \"tools/call\", \"id\": 5, \"params\": {\"name\": \"calculator\"}}",
   "headers": {
    "Content-Type": "application/json"
   }
  },
  {
   "method": "POST",
   "path": "/rpc-mustache",
   "note": "/rpc-mustache: valid request",
   "body": "{\"jsonrpc\": \"2.0\", \"method\": \"tools/list\", \"id\": 1}",
   "headers": {
    "Content-Type": "application/json"
   }
  },
  {
   "method": "POST",
   "path": "/rpc-mustache",
   "note": "/rpc-mustache: not JSON-RPC",
   "body": "{\"name\": \"value\"}",
   "headers": {
    "Content-Type": "application/json"
   }
  },
  {
   "method": "GET",
   "path": "/rpc-mustache",
   "note": "/rpc-mustache: no body"
  },
  {
   "method": "POST",
   "path": "/rpc-mustache",
   "note": "/rpc-mustache: numeric id",
   "body": "{\"jsonrpc\": \"2.0\", \"method\": \"tools/call\", \"id\": 42}",
   "headers": {
    "Content-Type": "application/json"
   }
  },
  {
   "method": "POST",
   "path": "/rpc-mustache",
   "note": "/rpc-mustache: string id",
   "body": "{\"jsonrpc\": \"2.0\", \"method\": \"resources/read\", \"id\": \"abc\"}",
   "headers": {
    "Content-Type": "application/json"
   }
  },
