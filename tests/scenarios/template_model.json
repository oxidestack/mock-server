   "body": "this is not json",
   "headers": {
    "Content-Type": "application/json"
   }
  },
  {
   "method": "POST",
   "path": "/rpc",
   "note": "/rpc: jsonrpc without method",
   "body": "{\"jsonrpc\": \"2.0\", \"id\": 1}",
   "headers": {
    "Content-Type": "application/json"
   }
  },
  {
   "method": "POST",
   "path": "/rpc",
   "note": "/rpc: empty body",
   "body": "",
