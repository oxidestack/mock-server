   "method": "POST",
   "path": "/rpc-mustache",
   "note": "/rpc-mustache: id missing",
   "body": "{\"jsonrpc\": \"2.0\", \"method\": \"notifications/send\"}",
   "headers": {
    "Content-Type": "application/json"
   }
