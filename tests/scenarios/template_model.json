   "method": "POST",
   "path": "/rpc-mustache",
   "note": "/rpc-mustache: id JSON null",
   "body": "{\"jsonrpc\": \"2.0\", \"method\": \"tools/list\", \"id\": null}",
   "headers": {
    "Content-Type": "application/json"
   }
