{
 "source": "hand-written: the template model objects (HttpRequestTemplateObject's JSON-RPC getters, CaseInsensitiveHeaderMap, HttpResponseTemplateObject) read through templates, as mockserver-core's model tests exercise them directly ()",
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": [
    {
     "httpRequest": {
      "path": "/rpc"
     },
     "httpResponseTemplate": {
      "templateType": "VELOCITY",
      "template": "{\"statusCode\": 200, \"body\": \"id=[$!request.jsonRpcId] idIsNull=#if($request.jsonRpcId)false#{else}true#end method=[$!request.jsonRpcMethod] methodIsNull=#if($request.jsonRpcMethod)false#{else}true#end\"}"
     }
    },
    {
     "httpRequest": {
      "path": "/rpc-mustache"
     },
     "httpResponseTemplate": {
      "templateType": "MUSTACHE",
      "template": "{\"statusCode\": 200, \"body\": \"id=[{{request.jsonRpcId}}] method=[{{request.jsonRpcMethod}}]\"}"
     }
    }
   ],
   "note": "JSON-RPC templates (HttpRequestTemplateObjectJsonRpcTest)"
  },
  {
   "method": "POST",
   "path": "/rpc",
   "note": "/rpc: valid request",
   "body": "{\"jsonrpc\": \"2.0\", \"method\": \"tools/list\", \"id\": 1}",
   "headers": {
    "Content-Type": "application/json"
   }
  },
  {
   "method": "POST",
   "path": "/rpc",
   "note": "/rpc: not JSON-RPC",
   "body": "{\"name\": \"value\"}",
   "headers": {
    "Content-Type": "application/json"
   }
  },
  {
   "method": "GET",
   "path": "/rpc",
   "note": "/rpc: no body"
  },
  {
   "method": "POST",
   "path": "/rpc",
   "note": "/rpc: numeric id",
   "body": "{\"jsonrpc\": \"2.0\", \"method\": \"tools/call\", \"id\": 42}",
   "headers": {
    "Content-Type": "application/json"
   }
  },
  {
   "method": "POST",
   "path": "/rpc",
   "note": "/rpc: string id",
   "body": "{\"jsonrpc\": \"2.0\", \"method\": \"resources/read\", \"id\": \"abc\"}",
   "headers": {
    "Content-Type": "application/json"
   }
  },
  {
   "method": "POST",
   "path": "/rpc",
   "note": "/rpc: id missing",
   "body": "{\"jsonrpc\": \"2.0\", \"method\": \"notifications/send\"}",
   "headers": {
    "Content-Type": "application/json"
   }
  },
  {
   "method": "POST",
   "path": "/rpc",
   "note": "/rpc: id JSON null",
   "body": "{\"jsonrpc\": \"2.0\", \"method\": \"tools/list\", \"id\": null}",
   "headers": {
    "Content-Type": "application/json"
   }
  },
