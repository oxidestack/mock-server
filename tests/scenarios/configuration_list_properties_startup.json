{
 "properties": {
  "loadGenerationMetricLabels": "a, b,,c",
  "controlPlaneJWTAuthenticationRequiredClaims": "x,,y,x",
  "controlPlaneOidcRequiredScopes": "s2,s1,s1",
  "sslSubjectAlternativeNameDomains": "z.example,y.example",
  "sslSubjectAlternativeNameIps": "9.9.9.9, 8.8.8.8,127.0.0.1"
 },
 "steps": [
  {
   "method": "GET",
   "path": "/mockserver/configuration",
   "note": "startup values are split on commas, trimmed, blanks dropped, a set's duplicates collapse"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "loadGenerationMetricLabels": [
     "p,q"
    ]
   },
   "note": "an update replaces them whole"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "sslSubjectAlternativeNameDomains": [
     "w.example"
    ]
   },
   "note": "a SAN update replaces the seed"
  },
  {
   "method": "GET",
   "path": "/mockserver/configuration"
  }
 ]
}
