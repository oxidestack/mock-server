  },
  {
   "method": "PUT",
   "path": "/mockserver/files/store",
   "note": "binary bytes, base64 as a number",
   "body": "{\"name\":\"bin\",\"content\":\"/wCAfw==\",\"base64\":1}"
  },
  {
   "method": "PUT",
   "path": "/mockserver/files/store",
