   "body": "{\"name\":\"text\",\"content\":\"hello world\"}"
  },
  {
   "method": "PUT",
   "path": "/mockserver/files/store",
   "note": "trailing content is ignored, overwrite keeps the name",
   "body": "{\"name\":\"text\",\"content\":\"hi\"} trailing"
  },
  {
   "method": "PUT",
   "path": "/mockserver/files/store",
   "note": "single quotes, unquoted names, trailing comma",
   "body": "{'name':'lenient',content:'c',}"
  },
  {
   "method": "PUT",
   "path": "/mockserver/files/store",
   "note": "the name is written into the answer unescaped",
   "body": "{\"name\":\"q\\\"uote\",\"content\":\"x\"}"
  },
  {
   "method": "PUT",
   "path": "/mockserver/files/store",
   "note": "size counts UTF-8 bytes",
   "body": "{\"name\":\"utf\",\"content\":\"héllo ☃\"}"
  },
  {
   "method": "PUT",
   "path": "/mockserver/files/store",
   "note": "base64",
   "body": "{\"name\":\"b64\",\"content\":\"aGVsbG8=\",\"base64\":true}"
  },
  {
   "method": "PUT",
   "path": "/mockserver/files/store",
