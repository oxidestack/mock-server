{
 "source": "A server of its own (the property is incidental): the store's ConcurrentHashMap keeps its grown table across reset, so the list order depends on what the server stored before this scenario.",
 "properties": {
  "maxExpectations": "5000"
 },
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/files/store",
   "body": "{\"name\": \"a\", \"content\": \"a\"}"
  },
  {
   "method": "PUT",
   "path": "/mockserver/files/store",
   "body": "{\"name\": \"q\", \"content\": \"q\"}"
  },
  {
   "method": "PUT",
   "path": "/mockserver/files/store",
   "body": "{\"name\": \"A\", \"content\": \"A\"}"
  },
  {
   "method": "PUT",
   "path": "/mockserver/files/store",
   "body": "{\"name\": \"Q\", \"content\": \"Q\"}"
  },
  {
   "method": "PUT",
   "path": "/mockserver/files/store",
   "body": "{\"name\": \"1\", \"content\": \"1\"}"
  },
  {
   "method": "PUT",
   "path": "/mockserver/files/store",
   "body": "{\"name\": \"!\", \"content\": \"!\"}"
  },
  {
   "method": "PUT",
   "path": "/mockserver/files/store",
   "body": "{\"name\": \"b\", \"content\": \"b\"}"
  },
  {
   "method": "PUT",
   "path": "/mockserver/files/store",
   "body": "{\"name\": \"c\", \"content\": \"c\"}"
  },
  {
   "method": "PUT",
   "path": "/mockserver/files/store",
   "body": "{\"name\": \"d\", \"content\": \"d\"}"
  },
  {
   "method": "PUT",
   "path": "/mockserver/files/store",
   "body": "{\"name\": \"e\", \"content\": \"e\"}"
  },
  {
   "method": "PUT",
   "path": "/mockserver/files/store",
   "body": "{\"name\": \"f\", \"content\": \"f\"}"
  },
  {
   "method": "PUT",
   "path": "/mockserver/files/list",
   "note": "eleven entries in a table of 16: bin 1 holds six in insertion order"
  },
  {
   "method": "PUT",
   "path": "/mockserver/files/store",
   "body": "{\"name\":\"g\",\"content\":\"g\"}",
   "note": "the twelfth entry doubles the table"
  },
  {
   "method": "PUT",
   "path": "/mockserver/files/list",
   "note": "bin 1 split by ConcurrentHashMap.transfer: the nodes before the last run come out reversed"
  },
  {
   "method": "PUT",
   "path": "/mockserver/reset"
  },
  {
   "method": "PUT",
   "path": "/mockserver/files/store",
   "body": "{\"name\":\"q\",\"content\":\"q\"}",
   "note": "reset clears the map but keeps its table of 32"
  },
  {
   "method": "PUT",
   "path": "/mockserver/files/store",
   "body": "{\"name\":\"a\",\"content\":\"a\"}"
  },
  {
   "method": "PUT",
   "path": "/mockserver/files/list"
  }
 ]
