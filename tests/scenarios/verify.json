  {"method": "POST", "path": "/other", "body": "{\"a\":1}", "headers": {"Content-Type": "application/json"}},
  {"note": "exactly once default", "method": "PUT", "path": "/mockserver/verify", "body": {"httpRequest": {"path": "/some/path"}}},
