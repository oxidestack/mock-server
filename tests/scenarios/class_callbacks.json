{"steps": [
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"httpRequest": {"path": "/missing"}, "httpResponseClassCallback": {"callbackClass": "com.example.NoSuchCallback"}}},
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"httpRequest": {"path": "/missing-delayed"}, "httpResponseClassCallback": {"callbackClass": "com.example.NoSuchCallback", "delay": {"timeUnit": "MILLISECONDS", "value": 50}}}},
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"httpRequest": {"path": "/forward-missing"}, "httpForwardClassCallback": {"callbackClass": "com.example.NoSuchCallback"}}},
  {"method": "PUT", "path": "/mockserver/retrieve?type=ACTIVE_EXPECTATIONS"},
  {"method": "PUT", "path": "/mockserver/clear?type=LOG"},
  {"note": "unknown class", "method": "GET", "path": "/missing"},
  {"note": "unknown class with a delay", "method": "GET", "path": "/missing-delayed"},
  {"note": "forward: unknown class forwards the request unchanged", "method": "GET", "path": "/forward-missing", "headers": {"Host": ["{{deadhost}}"]}},
  {"method": "PUT", "path": "/mockserver/retrieve?type=LOGS"},
  {"note": "the same entries as LOG_ENTRIES (the ERROR entry's Java throwable, stack frames and all, is left out: docs/divergences.md)", "method": "PUT", "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES", "mask": [{"regex": "(\"type\" : \"WARN\",\\n)    \"port\" : <port>,\\n", "replace": "${1}"}, {"regex": ",\\s*\"throwable\" : \\{[\\s\\S]*?\\n    \\}", "replace": ""}, {"regex": "(\"epochTime\" : )\\d+", "replace": "${1}0"}, "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)", {"regex": "(Millis\\\\?\" : )\\d+", "replace": "${1}0"}, {"regex": "(x-mockserver-response-time-ms\\\\?\" : \\[\\s*\\\\?\")\\d+", "replace": "${1}0"}]}
]}
