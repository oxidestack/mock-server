{
 "properties": {
  "forwardProxyAllowedHosts": "api.example.com, not a host",
  "socketConnectionTimeoutInMillis": "500"
 },
 "steps": [
  {
   "note": "an invalid entry (system property, so not validated when set)",
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": [
    {
     "httpRequest": {
      "path": "/f/localhost"
     },
     "httpForward": {
      "host": "localhost",
      "port": "{{deadport}}"
     }
    },
    {
     "httpRequest": {
      "path": "/f/listed"
     },
     "httpForward": {
      "host": "api.example.com",
      "port": 80
     }
    },
    {
     "httpRequest": {
      "path": "/hook/0"
     },
     "httpResponse": {
      "statusCode": 200,
      "body": "hooked"
     },
     "afterActions": [
      {
       "httpRequest": {
        "path": "/hooked",
        "headers": {
         "Host": [
          "{{deadhost}}"
         ]
        }
       }
      }
     ]
    }
   ],
   "mask": [
    "\"id\" : \"[0-9a-f-]+\""
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/clear?type=LOG"
  },
  {
   "note": "httpForward to localhost: an unparseable list refuses every target",
   "method": "GET",
   "path": "/f/localhost"
  },
  {
   "note": "httpForward to api.example.com: even one the list names",
   "method": "GET",
   "path": "/f/listed"
  },
  {
   "note": "the forward refusals",
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS",
   "body": {
    "path": "/f/.*"
   },
   "mask": [
    "^content-length: \\d+$"
   ],
   "compare": "unordered"
  },
  {
   "method": "PUT",
   "path": "/mockserver/clear?type=LOG"
  },
  {
   "note": "an upgrade relayed to localhost: an unparseable list refuses every target",
   "method": "GET",
   "path": "/f/localhost",
   "headers": {
    "Upgrade": "websocket",
    "Connection": "Upgrade",
    "Sec-WebSocket-Key": "dGhlIHNhbXBsZSBub25jZQ==",
    "Sec-WebSocket-Version": "13"
   },
   "mask": [
    {
     "regex": "(unable to connect to upstream WebSocket server [^ ]+) - .*",
     "replace": "$1 - <connect failure>",
     "reason": "the OS connect error text differs between the oracle's JVM and ours"
    }
   ]
  },
  {
   "note": "an upgrade relayed to api.example.com: even one the list names",
   "method": "GET",
   "path": "/f/listed",
   "headers": {
    "Upgrade": "websocket",
    "Connection": "Upgrade",
    "Sec-WebSocket-Key": "dGhlIHNhbXBsZSBub25jZQ==",
    "Sec-WebSocket-Version": "13"
   },
   "mask": [
    {
     "regex": "(unable to connect to upstream WebSocket server [^ ]+) - .*",
     "replace": "$1 - <connect failure>",
     "reason": "the OS connect error text differs between the oracle's JVM and ours"
    }
   ]
  },
  {
   "note": "unmatched, proxied to Host {{deadhost}}",
   "method": "GET",
   "path": "/proxied",
   "headers": {
    "Host": "{{deadhost}}"
   }
  },
  {
   "note": "replay to Host {{deadhost}}",
   "method": "PUT",
   "path": "/mockserver/replay",
   "body": {
    "path": "/replayed",
    "headers": {
     "Host": [
      "{{deadhost}}"
     ]
    }
   }
  },
  {
   "note": "an after-action webhook to Host {{deadhost}}",
   "method": "GET",
   "path": "/hook/0"
  },
  {
   "note": "the webhooks are sent after the response",
   "sleepMillis": 1500
  },
  {
   "note": "the relay, proxy, replay and webhook refusals",
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS&format=JSON",
   "mask": [
    "^content-length: \\d+$"
   ],
   "compare": "unordered"
  }
 ]
}
