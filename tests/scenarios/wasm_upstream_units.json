     "body": {
      "type": "WASM",
      "moduleName": "myModule"
     }
    },
    "httpResponse": {
     "body": "named"
    }
   }
  },
  {
   "note": "WasmBodyMatcherTest#shouldReportBlankWhenModuleNameIsEmpty",
