{
 "source": "mockserver-core 8.0.0 WASM unit tests that no recorded boundary reaches (WasmStoreTest, WasmBodyTest, WasmBodyDTOTest, WasmBodyMatcherTest blank names, WasmRuntimeShapeAbiTest readShapedResult, WasmResponseShaperTest applyShaped), by hand; modules in tests/files/wasm/units (WAT sources next to them)",
 "properties": {
  "wasmEnabled": "true"
 },
 "steps": [
  {
   "note": "WasmStoreTest: empty store",
   "method": "GET",
   "path": "/mockserver/wasm/modules"
  },
  {
   "note": "WasmStoreTest#shouldListAllModuleNames: mod1",
   "method": "PUT",
   "path": "/mockserver/wasm/modules?name=mod1",
   "bodyFile": "wasm/match.wasm"
  },
  {
   "note": "WasmStoreTest#shouldListAllModuleNames: mod2",
   "method": "PUT",
   "path": "/mockserver/wasm/modules?name=mod2",
   "bodyFile": "wasm/match.wasm"
  },
  {
   "note": "WasmStoreTest#shouldIgnoreNullName: no name",
   "method": "PUT",
   "path": "/mockserver/wasm/modules",
   "bodyFile": "wasm/match.wasm"
  },
  {
   "note": "WasmStoreTest#shouldIgnoreNullName: blank name",
   "method": "PUT",
   "path": "/mockserver/wasm/modules?name=",
   "bodyFile": "wasm/match.wasm"
  },
  {
   "note": "WasmStoreTest#shouldIgnoreNullBytes: no bytes",
   "method": "PUT",
   "path": "/mockserver/wasm/modules?name=name"
  },
  {
   "note": "WasmStoreTest#shouldListAllModuleNames: list",
   "method": "GET",
   "path": "/mockserver/wasm/modules"
  },
  {
   "note": "WasmStoreTest#shouldStoreAndRetrieveModule / shouldReportContains: present",
   "method": "POST",
   "path": "/mockserver/wasm/test",
   "body": {
    "moduleName": "mod1",
    "request": {
     "body": "{\"amount\": 5000}"
    }
   }
  },
  {
   "note": "WasmStoreTest#shouldReturnNullForUnknownModule / shouldReportContains: absent",
   "method": "POST",
   "path": "/mockserver/wasm/test",
   "body": {
    "moduleName": "absent",
    "request": {
     "body": "{\"amount\": 5000}"
    }
   }
  },
  {
   "note": "WasmStoreTest#shouldRemoveModule",
   "method": "DELETE",
   "path": "/mockserver/wasm/modules?name=mod2"
  },
  {
   "note": "WasmStoreTest#shouldRemoveModule / WasmRuntimeModuleCacheTest#shouldEvictCachedModuleViaWasmStoreRemove: removed",
   "method": "POST",
   "path": "/mockserver/wasm/test",
   "body": {
    "moduleName": "mod2",
    "request": {
     "body": "{\"amount\": 5000}"
    }
   }
  },
  {
   "note": "WasmStoreTest#shouldHandleNullRemove: no name",
   "method": "DELETE",
   "path": "/mockserver/wasm/modules"
  },
  {
   "note": "WasmStoreTest#shouldHandleNullRemove: mod1 survives",
   "method": "GET",
   "path": "/mockserver/wasm/modules"
  },
  {
   "note": "WasmStoreTest#shouldOverwriteExistingModule: v1",
   "method": "PUT",
   "path": "/mockserver/wasm/modules?name=m",
   "bodyFile": "wasm/match.wasm"
  },
  {
   "note": "WasmStoreTest#shouldOverwriteExistingModule: v2",
   "method": "PUT",
   "path": "/mockserver/wasm/modules?name=m",
   "bodyFile": "wasm/match-request.wasm"
  },
  {
   "note": "WasmStoreTest#shouldOverwriteExistingModule: one name",
   "method": "GET",
   "path": "/mockserver/wasm/modules"
  },
  {
   "note": "WasmStoreTest#shouldOverwriteExistingModule: v1 no longer runs",
   "method": "POST",
   "path": "/mockserver/wasm/test",
   "body": {
    "moduleName": "m",
    "request": {
     "body": "{\"amount\": 5000}"
    }
   }
  },
  {
   "note": "WasmStoreTest#shouldOverwriteExistingModule: v2 runs",
   "method": "POST",
   "path": "/mockserver/wasm/test",
   "body": {
    "moduleName": "m",
    "request": {
     "method": "POST",
     "path": "/orders",
     "headers": {
      "X-Tenant": [
       "acme"
      ]
     },
     "body": "{}"
    }
   }
  },
  {
   "note": "WasmStoreTest#shouldResetClearAllModules / WasmRuntimeModuleCacheTest#shouldClearCacheOnWasmStoreReset",
   "method": "PUT",
   "path": "/mockserver/reset"
  },
  {
