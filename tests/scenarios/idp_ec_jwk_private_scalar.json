          "replace": "content-length: <varies>"
        },
        {
          "regex": "\"(iat|nbf|exp)\" : \\d+",
          "replace": "\"${1}\" : <time>"
        }
      ]
    },
    {
      "note": "the ERROR entry and its throwable chain",
      "method": "PUT",
      "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES",
      "mask": [
        {
          "regex": "\"stackTrace\" : \\[[^\\]]*\\]",
          "replace": "\"stackTrace\" : <frames>"
        },
        {
          "regex": "(\"epochTime\" : )\\d+",
          "replace": "${1}0"
