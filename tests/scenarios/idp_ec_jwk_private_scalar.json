{
  "note": "EC JWKs whose d is not in [1, n - 1] are accepted by PUT /mockserver/oidc and published; signing a token fails in the JDK's ECUtil.checkPrivateKey, so /token answers 404 with the callback's ERROR and its throwable chain; the RSA signing failures' chains beside it.",
  "steps": [
    {
      "method": "PUT",
      "path": "/mockserver/reset"
    },
    {
      "note": "a P-256 JWK with d = 0 is accepted at generate time",
      "method": "PUT",
      "path": "/mockserver/oidc",
      "body": {
        "jwkJson": "{\"kty\": \"EC\", \"crv\": \"P-256\", \"kid\": \"ec-p256\", \"x\": \"tKcE-R7XISCbOFqh1_FZGRFbF8BQtCjx1KW1jp5gog8\", \"y\": \"aDnKmtiTbVVcyHipo___81hapa_W6vNZSqww3Etu3N8\", \"d\": \"AA\"}",
        "signingAlgorithm": "ES256"
      },
      "mask": [
        "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}",
        {
          "regex": "eyJ[\\w-]+\\.[\\w-]+\\.[\\w-]*",
          "replace": "<jwt>"
        },
        {
          "regex": "content-length: \\d+",
          "replace": "content-length: <varies>"
        },
        {
          "regex": "\"(iat|nbf|exp)\" : \\d+",
          "replace": "\"${1}\" : <time>"
        }
      ]
    },
    {
      "note": "its JWKS publishes the JWK's public key",
      "method": "GET",
      "path": "/.well-known/jwks.json",
      "mask": [
        "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}",
        {
          "regex": "eyJ[\\w-]+\\.[\\w-]+\\.[\\w-]*",
          "replace": "<jwt>"
        },
        {
          "regex": "content-length: \\d+",
          "replace": "content-length: <varies>"
        },
        {
          "regex": "\"(iat|nbf|exp)\" : \\d+",
          "replace": "\"${1}\" : <time>"
        }
      ]
    },
    {
      "note": "ECDSASignature.engineInitSign range-checks d: the token callback throws, 404",
      "method": "POST",
      "path": "/token",
      "headers": {
        "Content-Type": "application/x-www-form-urlencoded"
      },
      "body": "grant_type=client_credentials&scope=openid",
      "mask": [
        "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}",
        {
          "regex": "eyJ[\\w-]+\\.[\\w-]+\\.[\\w-]*",
