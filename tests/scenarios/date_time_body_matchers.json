{
  "source": "hand-written: JSON_PATH and XPATH bodies with a dateTime (BodyDateTimeField, JsonPathMatcher, XPathMatcher); isolated: the clock is frozen.",
  "isolated": true,
  "steps": [
    {
      "method": "PUT",
      "path": "/mockserver/reset"
    },
    {
      "method": "PUT",
      "path": "/mockserver/clock",
      "body": {
        "action": "freeze",
        "instant": "2026-06-15T12:30:45Z"
      },
      "note": "now is 2026-06-15T12:30:45Z"
    },
    {
      "method": "PUT",
      "path": "/mockserver/expectation",
      "body": {
        "httpRequest": {
          "method": "POST",
          "path": "/jsonpath-date-time",
          "body": {
            "type": "JSON_PATH",
            "jsonPath": "$.order.created",
            "dateTime": {
              "after": "now -1 days",
              "actualFormat": "iso",
              "truncateExpected": "startOfDay",
              "zone": "Europe/London"
            }
          }
        },
        "httpResponse": {
          "body": "recent order"
        }
      },
      "note": "upstream's test fixture: a JSON_PATH body with a dateTime"
    },
    {
      "method": "PUT",
      "path": "/mockserver/expectation",
      "body": {
        "httpRequest": {
          "method": "POST",
          "path": "/many",
          "body": {
            "jsonPath": "$..created",
            "dateTime": {
              "truncateActual": "startOfDay",
              "equalToDateTime": "2026-06-10"
            }
          }
        },
        "httpResponse": {
          "body": "many"
        }
      }
    },
    {
      "method": "PUT",
      "path": "/mockserver/expectation",
      "body": {
        "httpRequest": {
          "method": "POST",
          "path": "/epoch",
          "body": {
            "type": "JSON_PATH",
            "jsonPath": "$.at",
            "dateTime": {
              "not": true,
              "before": "now"
            }
          }
        },
        "httpResponse": {
          "body": "epoch"
        }
      }
    },
    {
      "method": "PUT",
      "path": "/mockserver/expectation",
      "body": {
        "httpRequest": {
          "method": "POST",
          "path": "/xml",
          "body": {
            "type": "XPATH",
            "xpath": "//order/@created",
            "dateTime": {
              "after": "now -7 days",
              "actualFormat": "dd MMM yyyy HH:mm"
            }
          }
        },
        "httpResponse": {
          "body": "xml"
        }
      }
    },
    {
      "method": "PUT",
      "path": "/mockserver/expectation",
      "body": {
        "httpRequest": {
          "method": "POST",
          "path": "/xmlns",
          "body": {
            "dateTime": {
              "before": "2026-01-01T00:00:00Z"
            },
            "type": "XPATH",
            "xpath": "/a:order/a:created",
            "namespacePrefixes": {
              "a": "urn:a"
            }
          }
        },
        "httpResponse": {
          "body": "xmlns"
        }
      }
    },
    {
      "method": "PUT",
      "path": "/mockserver/expectation",
      "body": {
        "httpRequest": {
          "method": "POST",
          "path": "/content",
          "body": {
            "id": 1,
            "dateTime": {
              "after": "now"
            }
          }
        },
        "httpResponse": {
          "body": "content"
        }
      }
    },
    {
      "method": "PUT",
      "path": "/mockserver/retrieve?type=ACTIVE_EXPECTATIONS",
      "note": "the echo: dateTime last, in its canonical form"
    },
    {
      "method": "POST",
      "path": "/jsonpath-date-time",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "order": {
          "created": "2026-06-14T09:00:00+01:00"
        }
      },
      "note": "after the start of yesterday in London"
    },
    {
      "method": "POST",
      "path": "/jsonpath-date-time",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "order": {
          "created": "2026-06-13T22:00:00Z"
        }
      },
      "note": "before it"
    },
    {
      "method": "POST",
      "path": "/jsonpath-date-time",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "order": {
          "created": 1781526645
        }
      },
      "note": "iso only: a number is not read"
    },
    {
      "method": "POST",
      "path": "/jsonpath-date-time",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "order": {}
      },
      "note": "no value selected"
    },
    {
      "method": "POST",
      "path": "/many",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "items": [
          {
            "created": "x"
          },
          {
            "created": "2026-06-10T23:59:59Z"
          }
        ]
      },
      "note": "any selected value"
    },
    {
      "method": "POST",
      "path": "/many",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "items": [
          {
            "created": "2026-06-11T00:00:00Z"
          }
        ]
      },
      "note": "none equal once truncated"
    },
    {
      "method": "POST",
      "path": "/epoch",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "at": 1781526646
      },
      "note": "epoch seconds, not before now"
    },
    {
      "method": "POST",
      "path": "/epoch",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "at": 1781526644000
      },
      "note": "epoch millis before now"
    },
    {
      "method": "POST",
      "path": "/epoch",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "at": 1.5
      },
      "note": "a decimal is not a date-time, even negated"
    },
    {
      "method": "POST",
      "path": "/xml",
      "headers": {
        "Content-Type": "application/xml"
      },
      "body": "<orders><order created=\"14 Jun 2026 10:00\"/></orders>",
      "note": "an attribute's text"
    },
    {
      "method": "POST",
      "path": "/xml",
      "headers": {
        "Content-Type": "application/xml"
      },
      "body": "<orders><order created=\"14 May 2026 10:00\"/><order created=\"bad\"/></orders>",
      "note": "too old"
    },
    {
      "method": "POST",
      "path": "/xmlns",
      "headers": {
        "Content-Type": "application/xml"
      },
      "body": "<a:order xmlns:a=\"urn:a\"><a:created>2025-12-31T23:00:00Z</a:created></a:order>",
      "note": "with namespaces"
    },
    {
      "method": "POST",
      "path": "/content",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "id": 1,
        "dateTime": {
          "after": "now"
        }
      },
      "note": "an untyped body's dateTime is JSON content"
    },
    {
      "method": "PUT",
      "path": "/mockserver/expectation",
      "body": {
        "httpRequest": {
          "body": {
            "type": "JSON_PATH",
            "jsonPath": "$.a",
            "dateTime": "x"
          }
        },
        "httpResponse": {
          "body": "ok"
        }
      },
      "note": "refused: a string dateTime"
    },
    {
      "method": "PUT",
      "path": "/mockserver/expectation",
      "body": {
        "httpRequest": {
          "body": {
            "type": "JSON_PATH",
            "jsonPath": "$.a",
            "dateTime": {
              "zone": "UTC"
            }
          }
        },
        "httpResponse": {
          "body": "ok"
        }
      },
      "note": "refused: options without an operator"
    },
    {
      "method": "PUT",
      "path": "/mockserver/expectation",
      "body": {
        "httpRequest": {
          "body": {
            "type": "STRING",
            "string": "a",
            "dateTime": {
              "after": "now"
            }
          }
        },
        "httpResponse": {
          "body": "ok"
        }
      },
      "note": "refused: on a STRING body"
    },
    {
      "method": "PUT",
      "path": "/mockserver/expectation",
      "body": {
        "httpRequest": {
          "body": {
            "type": "JSON",
            "json": {
              "a": 1
            },
            "dateTime": {
              "after": "now"
            }
          }
        },
        "httpResponse": {
          "body": "ok"
        }
      },
      "note": "refused: on a JSON body"
    },
    {
      "method": "PUT",
      "path": "/mockserver/expectation",
      "body": {
        "httpRequest": {
          "body": {
            "type": "XPATH",
            "xpath": "/a",
            "dateTime": {
              "after": "x"
            }
          }
        },
        "httpResponse": {
          "body": "ok"
        }
      },
      "note": "refused: unreadable expected on an XPATH body"
    },
    {
      "method": "PUT",
      "path": "/mockserver/expectation",
      "body": {
        "httpRequest": {
          "body": {
            "type": "JSON_PATH",
            "jsonPath": "$.a",
            "dateTime": {
              "value": "x"
            }
          }
        },
        "httpResponse": {
          "body": "ok"
        }
      },
      "note": "refused: a value without an operator"
    },
    {
      "method": "PUT",
      "path": "/mockserver/expectation",
      "body": {
        "httpRequest": {
          "body": {
            "type": "XPATH",
            "xpath": "/a",
            "dateTime": {}
          }
        },
        "httpResponse": {
          "body": "ok"
        }
      },
      "note": "refused: an empty object"
    },
    {
      "method": "PUT",
      "path": "/mockserver/verify",
      "body": {
        "httpRequest": {
          "path": "/epoch",
          "body": {
            "type": "JSON_PATH",
            "jsonPath": "$.at",
            "dateTime": {
              "after": "now -1 days"
            }
          }
        },
        "times": {
          "atLeast": 1
        }
      },
      "note": "a verification with a body date-time"
    },
    {
      "method": "PUT",
      "path": "/mockserver/retrieve?type=LOGS",
      "mask": [
        "[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9:.]{12}"
      ],
      "note": "what was logged, the body match failures included"
    },
    {
      "method": "PUT",
      "path": "/mockserver/clock",
      "body": {
        "action": "reset"
      },
      "mask": [
        "\"currentInstant\" : \"[^\"]+\"",
        "\"currentEpochMillis\" : -?[0-9]+"
      ]
    }
  ]
}
