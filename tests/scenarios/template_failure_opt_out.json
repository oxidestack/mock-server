{
 "source": "with templateFailureAsServerError false a failed template answers as before 9.1.0: 404 for a response template, 502 for a forward template or a throwing forward responseTemplate, the upstream's response for invalid forward responseTemplate output (TemplateFailureIntegrationTest)",
 "properties": {
  "templateFailureAsServerError": "false"
 },
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "path": "/upstream"
    },
    "httpResponse": {
     "statusCode": 200,
     "body": "from upstream"
    }
   },
   "mask": [
    "content-length: \\d+"
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "path": "/fr-throw"
    },
    "httpOverrideForwardedRequest": {
     "requestOverride": {
      "path": "/upstream",
      "headers": {
       "Host": [
        "{{host}}"
       ]
      }
     },
     "responseTemplate": {
      "templateType": "VELOCITY",
      "template": "#foreach("
     }
    }
   },
   "mask": [
    "content-length: \\d+"
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "path": "/fr-invalid"
    },
    "httpOverrideForwardedRequest": {
     "requestOverride": {
      "path": "/upstream",
      "headers": {
       "Host": [
        "{{host}}"
       ]
      }
     },
     "responseTemplate": {
      "templateType": "VELOCITY",
      "template": "{ 'statusCode': 'two hundred' }"
     }
    }
   },
   "mask": [
    "content-length: \\d+"
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "path": "/f-invalid"
    },
    "httpForwardTemplate": {
     "templateType": "VELOCITY",
     "template": "{ 'statusCode': 200 }"
    }
   },
   "mask": [
    "content-length: \\d+"
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "path": "/r-invalid"
    },
    "httpResponseTemplate": {
     "templateType": "VELOCITY",
     "template": "{ 'statusCode': 'two hundred' }"
    }
   },
   "mask": [
    "content-length: \\d+"
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "path": "/r-throw"
    },
    "httpResponseTemplate": {
     "templateType": "VELOCITY",
     "template": "#foreach("
    }
   },
   "mask": [
    "content-length: \\d+"
   ]
  },
  {
   "method": "GET",
   "path": "/fr-throw",
   "note": "a throwing forward response template fails the forward"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES",
   "body": {
    "path": "/fr-throw"
   },
   "mask": [
    "(?s)\"stackTrace\" : \\[.*?\\]",
    "\"epochTime\" : \\d+",
    "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)",
    "content-length: \\d+",
    {"regex": "(\"type\" : \"WARN\",\\n)    \"port\" : <port>,\\n(    \"messageFormat\" : \"org\\.mockserver\\.)", "replace": "$1$2", "reason": "the scheduler logs a failed forward future on whichever thread completes it, which carries a port only when it served a request before"}
   ]
  },
  {
   "method": "GET",
   "path": "/fr-invalid",
   "note": "invalid output leaves the upstream's response"
  },
  {
   "method": "GET",
   "path": "/f-invalid",
   "note": "502"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES",
   "body": {
    "path": "/f-invalid"
   },
   "mask": [
    "(?s)\"stackTrace\" : \\[.*?\\]",
    "\"epochTime\" : \\d+",
    "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)",
    "content-length: \\d+",
    {"regex": "(\"type\" : \"WARN\",\\n)    \"port\" : <port>,\\n(    \"messageFormat\" : \"org\\.mockserver\\.)", "replace": "$1$2", "reason": "the scheduler logs a failed forward future on whichever thread completes it, which carries a port only when it served a request before"}
   ],
   "compare": "unordered",
   "note": "the drift analysis re-matches the request on a scheduler thread, racing the forward entry"
  },
  {
   "method": "GET",
   "path": "/r-invalid",
   "note": "404"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES",
   "body": {
    "path": "/r-invalid"
   },
   "mask": [
    "(?s)\"stackTrace\" : \\[.*?\\]",
    "\"epochTime\" : \\d+",
    "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)",
    "content-length: \\d+",
    {"regex": "(\"type\" : \"WARN\",\\n)    \"port\" : <port>,\\n(    \"messageFormat\" : \"org\\.mockserver\\.)", "replace": "$1$2", "reason": "the scheduler logs a failed forward future on whichever thread completes it, which carries a port only when it served a request before"}
   ]
  },
  {
   "method": "GET",
   "path": "/r-throw",
   "note": "404"
  }
 ]
}
