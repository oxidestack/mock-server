{
 "source": "upstream 6dcc66b58, DataPlaneAuthenticationControlPlanePathIntegrationTest.shouldNotChangeRespondBeforeBodyStateForRequestWithoutCredentials. EarlyMatchingHandler checks data-plane credentials before firstMatchingEarlyExpectation, which uses up Times and moves scenarios; a request without them falls through to HttpRequestHandler's gate and its 401.",
 "properties": {
  "dataPlaneAuthenticationRequired": "true",
  "dataPlaneBearerAuthenticationToken": "bearer-token-123",
  "attemptToProxyIfNoMatchingExpectation": "false"
 },
 "steps": [
