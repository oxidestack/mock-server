{
 "source": "upstream #109 (8d28d6f4f) stops relocating com.sun.*, so the Kafka client's login-module deny-list (JaasContext.throwIfLoginModuleIsNotAllowed) refuses com.sun.security.auth.module.JndiLoginModule in the startup asyncKafkaSaslJaasConfig (system property), the only JAAS configuration since #119.",
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/reset"
  },
  {
   "method": "PUT",
   "path": "/mockserver/asyncapi",
   "body": {
    "spec": {
     "asyncapi": "2.6.0",
     "info": {
      "title": "Startup JAAS"
     },
     "channels": {
      "orders": {
       "publish": {
        "message": {
         "payload": {
          "type": "object"
         }
        }
       }
      }
     }
    },
    "brokerConfig": {
     "publishOnLoad": false,
     "kafkaSecurity": {
      "securityProtocol": "SASL_PLAINTEXT",
      "saslMechanism": "PLAIN"
     }
    }
   },
   "note": "SASL with the startup JAAS naming JndiLoginModule: producer construction fails"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES",
   "note": "the log: the deny-list refusal",
   "mask": [
    "(?s)\"stackTrace\" : \\[.*?\\]",
    "\"epochTime\" : \\d+",
    "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)",
    "content-length: \\d+",
    {
     "regex": "\"content-length\" : \\[\\s*\"\\d+\"\\s*\\]",
     "reason": "the logged request's length varies with the dead host's port"
    },
    {
     "regex": "\\n\\s*\"port\" : (<port>|\\d+),",
     "replace": ""
    }
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/asyncapi",
   "body": {
    "spec": {
     "asyncapi": "2.6.0",
     "info": {
      "title": "Startup JAAS"
     },
     "channels": {
      "orders": {
       "publish": {
        "message": {
         "payload": {
          "type": "object"
         }
        }
       }
      }
     }
    },
    "brokerConfig": {
     "publishOnLoad": false,
     "consume": true,
     "kafkaSecurity": {
      "securityProtocol": "SASL_SSL",
      "saslMechanism": "SCRAM-SHA-256"
     }
    }
   },
   "note": "SASL_SSL and SCRAM, with consume: producer construction fails first"
  },
  {
   "method": "PUT",
   "path": "/mockserver/reset"
  }
 ],
 "properties": {
  "asyncKafkaBootstrapServers": "{{deadhost}}",
  "asyncKafkaSaslJaasConfig": "com.sun.security.auth.module.JndiLoginModule required user.provider.url=\"ldap://elsewhere.invalid/\" useFirstPass=true;"
 }
}
