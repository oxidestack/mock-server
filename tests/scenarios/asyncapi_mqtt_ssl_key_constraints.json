                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "brokerConfig": {
          "mqttBrokerUrl": "ssl://localhost:{{port}}",
          "publishOnLoad": false,
          "mqttSecurity": {
            "sslProperties": {
              "com.ibm.ssl.keyStore": "{{files}}/asyncapi/mqtt-ssl/key-choice/md5-good.p12",
              "com.ibm.ssl.keyStorePassword": "changeit",
              "com.ibm.ssl.trustStore": "{{files}}/asyncapi/mqtt-ssl/trust.jks",
              "com.ibm.ssl.trustStorePassword": "changeit",
              "com.ibm.ssl.keyManager": "NewSunX509"
            }
          }
        }
      },
      "maxMillis": 60000
    },
