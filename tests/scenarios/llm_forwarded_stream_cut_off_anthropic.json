{
  "source": "hand-written (generated from upstream's ProviderStreamFixtures): HttpActionHandlerStreamedLlmUsageTest's shouldCountOnlyWhatWasReportedWhenAnAnthropicStreamIsCutOff and shouldCountAStreamForwardedAfterARequestBreakpointIsContinued's sibling cases; an upstream that closes mid-body is an httpError dropping the connection after part of a chunked body, forwarded to this server's own mocks",
  "properties": {
    "metricsEnabled": "true",
    "llmMetricsEnabled": "true",
    "llmProvider": "ANTHROPIC",
    "llmCostBudgetUsd": "100",
    "logLevel": "WARN"
  },
  "steps": [
    {
      "method": "PUT",
      "path": "/mockserver/expectation",
      "body": [
        {
          "id": "upstream-anthropic-cut",
          "priority": 10,
          "httpRequest": {
            "method": "POST",
            "path": "/v1/messages",
            "headers": {
              "x-case": [
                "anthropic-cut"
              ]
            }
          },
          "httpError": {
            "dropConnection": true,
            "responseBytes": ""
          }
        },
        {
          "id": "forward-anthropic-cut",
          "httpRequest": {
            "method": "POST",
            "path": "/client/anthropic-cut"
          },
          "httpOverrideForwardedRequest": {
            "requestOverride": {
              "path": "/v1/messages",
              "headers": {
                "Host": [
                  "localhost:{{port}}"
                ],
                "x-case": [
                  "anthropic-cut"
                ]
              }
            }
          }
        }
      ]
    },
    {
      "note": "Anthropic cut off after message_start: 25 in, 1 out counted, and a WARN that it ended before its final usage event",
      "method": "POST",
      "path": "/client/anthropic-cut",
      "body": "{\"model\":\"claude-sonnet-4-5\",\"stream\":true}",
      "headers": {
        "Content-Type": "application/json"
      }
    },
    {
      "sleepMillis": 500,
      "note": "a relayed stream is accounted once its relay has ended, which may be after the client read it"
    },
    {
      "note": "the LLM token and cost counters",
      "method": "GET",
      "path": "/mockserver/metrics",
      "mask": [
        {
          "regex": "(?m)^(?!(# (HELP|TYPE) )?mock_server_llm_)[^\\n]*\\n",
          "replace": ""
        },
        "content-length: \\d+"
      ]
    },
    {
      "note": "the streamed-usage lines of the event log",
      "method": "PUT",
      "path": "/mockserver/retrieve?type=LOGS",
      "mask": [
        {
          "regex": "(?s)(?:\\A|(?<=------------------------------------\\n))(?!\\S+ - (?:no token usage|the streamed ))(?:(?!------------------------------------).)*(?:------------------------------------\\n|\\z)",
          "replace": "",
          "reason": "every entry but the streamed-usage lines"
        }
      ]
    }
  ]
}
