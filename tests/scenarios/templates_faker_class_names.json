{
 "source": "template faker objects report their real (shaded) class names, themed providers in their own packages",
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/reset"
  },
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "path": "/velocity"
    },
    "httpResponseTemplate": {
     "templateType": "VELOCITY",
     "template": "{\n    'statusCode': 200,\n    'body': \"faker=$faker.getClass().getName() | faker.random()=$faker.random().getClass().getName() | faker.name()=$faker.name().getClass().getName() | faker.cat()=$faker.cat().getClass().getName() | faker.dune()=$faker.dune().getClass().getName() | faker.food()=$faker.food().getClass().getName() | faker.esports()=$faker.esports().getClass().getName() | faker.football()=$faker.football().getClass().getName() | faker.medicalProcedure()=$faker.medicalProcedure().getClass().getName() | class=$faker.dune().getClass()\"\n}"
    }
   }
  },
  {
   "method": "GET",
   "path": "/velocity"
  }
 ]
}
