{"steps": [
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"httpRequest": {"path": "/upstream"}, "httpResponse": {"body": "from upstream"}}},
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"httpRequest": {"path": "/override"}, "httpOverrideForwardedRequest": {"httpRequest": {"path": "/upstream", "headers": {"Host": ["localhost:{{port}}"]}}, "httpResponse": {"statusCode": 200, "body": {"type": "FILE", "filePath": "{{files}}/body.mustache", "contentType": "application/xml"}}}}},
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"httpRequest": {"path": "/override-plain"}, "httpOverrideForwardedRequest": {"httpRequest": {"path": "/upstream", "headers": {"Host": ["localhost:{{port}}"]}}, "httpResponse": {"body": {"type": "FILE", "filePath": "{{files}}/plain.txt"}}}}},
  {"note": "file contents, content type", "method": "GET", "path": "/override"},
  {"note": "file contents, no content type", "method": "GET", "path": "/override-plain"}
]}
