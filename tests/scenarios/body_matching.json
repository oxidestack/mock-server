{"steps": [
  {"method": "PUT", "path": "/mockserver/expectation", "body": [
    {"httpRequest": {"path": "/s", "body": "exact"}, "httpResponse": {"body": "string"}},
    {"httpRequest": {"path": "/sub", "body": {"type": "STRING", "string": "needle", "subString": true}}, "httpResponse": {"body": "substring"}},
    {"httpRequest": {"path": "/re", "body": {"type": "REGEX", "regex": "id=[0-9]+"}}, "httpResponse": {"body": "regex"}},
    {"httpRequest": {"path": "/j", "body": {"type": "JSON", "json": {"a": 1, "arr": [1, 2]}}}, "httpResponse": {"body": "json-lenient"}},
    {"httpRequest": {"path": "/js", "body": {"type": "JSON", "json": {"a": 1, "arr": [1, 2]}, "matchType": "STRICT"}}, "httpResponse": {"body": "json-strict"}},
    {"httpRequest": {"path": "/jraw", "body": {"user": {"name": "bob"}}}, "httpResponse": {"body": "json-raw"}},
    {"httpRequest": {"path": "/jph", "body": {"type": "JSON", "json": {"id": "${json-unit.any-number}", "name": "${json-unit.any-string}", "x": "${json-unit.ignore}"}}}, "httpResponse": {"body": "json-placeholders"}},
    {"httpRequest": {"path": "/schema", "body": {"type": "JSON_SCHEMA", "jsonSchema": {"type": "object", "required": ["id"], "properties": {"id": {"type": "integer"}}}}}, "httpResponse": {"body": "json-schema"}},
    {"httpRequest": {"path": "/jp", "body": {"type": "JSON_PATH", "jsonPath": "$.items[?(@.price > 10)]"}}, "httpResponse": {"body": "json-path"}},
    {"httpRequest": {"path": "/x", "body": {"type": "XML", "xml": "<a><b>1</b></a>"}}, "httpResponse": {"body": "xml"}},
    {"httpRequest": {"path": "/xp", "body": {"type": "XPATH", "xpath": "/order/item[@qty > 2]"}}, "httpResponse": {"body": "xpath"}},
    {"httpRequest": {"path": "/form", "body": {"type": "PARAMETERS", "parameters": {"name": ["bob"]}}}, "httpResponse": {"body": "form"}},
    {"httpRequest": {"path": "/bin", "body": {"type": "BINARY", "base64Bytes": "AAEC"}}, "httpResponse": {"body": "binary"}},
    {"httpRequest": {"path": "/not", "body": {"not": true, "type": "STRING", "string": "bad"}}, "httpResponse": {"body": "not-body"}}
  ]},
  {"note": "string exact", "method": "POST", "path": "/s", "body": "exact"},
  {"note": "string case", "method": "POST", "path": "/s", "body": "EXACT"},
  {"note": "string differs", "method": "POST", "path": "/s", "body": "exact!"},
  {"note": "substring", "method": "POST", "path": "/sub", "body": "hay needle hay"},
  {"note": "regex full match only", "method": "POST", "path": "/re", "body": "x id=12"},
  {"note": "regex ok", "method": "POST", "path": "/re", "body": "id=12"},
  {"note": "json extra fields and reordered array", "method": "POST", "path": "/j", "body": {"arr": [2, 1, 3], "a": 1, "b": 2}},
  {"note": "json wrong value", "method": "POST", "path": "/j", "body": {"a": 2, "arr": [1, 2]}},
  {"note": "json number format", "method": "POST", "path": "/j", "body": "{\"a\": 1.0, \"arr\": [1, 2]}"},
  {"note": "strict exact", "method": "POST", "path": "/js", "body": {"a": 1, "arr": [1, 2]}},
  {"note": "strict extra field", "method": "POST", "path": "/js", "body": {"a": 1, "arr": [1, 2], "b": 1}},
  {"note": "strict array order", "method": "POST", "path": "/js", "body": {"a": 1, "arr": [2, 1]}},
  {"note": "raw json nested extra", "method": "POST", "path": "/jraw", "body": {"user": {"name": "bob", "age": 3}}},
  {"note": "raw json not json", "method": "POST", "path": "/jraw", "body": "not json"},
  {"note": "placeholders ok", "method": "POST", "path": "/jph", "body": {"id": 5, "name": "n", "x": [1]}},
  {"note": "placeholders wrong type", "method": "POST", "path": "/jph", "body": {"id": "5", "name": "n", "x": 1}},
  {"note": "schema ok", "method": "POST", "path": "/schema", "body": {"id": 1}},
  {"note": "schema bad", "method": "POST", "path": "/schema", "body": {"id": "1"}},
  {"note": "jsonpath ok", "method": "POST", "path": "/jp", "body": {"items": [{"price": 5}, {"price": 15}]}},
  {"note": "jsonpath none", "method": "POST", "path": "/jp", "body": {"items": [{"price": 5}]}},
  {"note": "xml whitespace", "method": "POST", "path": "/x", "body": "<a>\n  <b>1</b>\n</a>"},
  {"note": "xml differs", "method": "POST", "path": "/x", "body": "<a><b>2</b></a>"},
  {"note": "xpath ok", "method": "POST", "path": "/xp", "body": "<order><item qty=\"3\"/></order>"},
  {"note": "xpath none", "method": "POST", "path": "/xp", "body": "<order><item qty=\"1\"/></order>"},
  {"note": "form ok", "method": "POST", "path": "/form", "headers": {"Content-Type": "application/x-www-form-urlencoded"}, "body": "name=bob&x=1"},
  {"note": "form wrong", "method": "POST", "path": "/form", "headers": {"Content-Type": "application/x-www-form-urlencoded"}, "body": "name=alice"},
  {"note": "binary ok", "method": "POST", "path": "/bin", "body": "\u0000\u0001\u0002"},
  {"note": "not body ok", "method": "POST", "path": "/not", "body": "good"},
  {"note": "not body bad", "method": "POST", "path": "/not", "body": "bad"}
]}
