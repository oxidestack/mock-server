{
 "properties": {
  "metricsEnabled": "true",
  "chaosAutoHaltEnabled": "true",
  "chaosAutoHaltErrorThreshold": "2"
 },
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/serviceChaos",
   "body": {
    "host": "svc.test",
    "chaos": {
     "errorStatus": 503,
     "latency": {
      "timeUnit": "MILLISECONDS",
      "value": 1
     }
    }
   }
  },
  {
   "method": "PUT",
   "path": "/mockserver/serviceChaos",
   "body": {
    "host": "other.test",
    "chaos": {
     "dropConnectionProbability": 0.0,
     "truncateBodyAtFraction": 0.5,
     "malformedBody": true,
     "quotaName": "q",
     "quotaLimit": 1,
     "quotaWindowMillis": 1000,
     "graphqlErrors": true,
     "slowResponseChunkSize": 1,
     "slowResponseChunkDelay": {
      "timeUnit": "MILLISECONDS",
      "value": 1
     }
    }
   }
  },
  {
   "method": "PUT",
   "path": "/mockserver/tcpChaos",
   "body": {
    "host": "tcp.test",
    "chaos": {
     "latencyMs": 1
    }
   }
  },
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": [
    {
     "httpRequest": {
      "path": "/e"
     },
     "httpResponse": {
      "body": "ok"
     },
     "chaos": {
      "errorStatus": 500
     }
    },
    {
     "httpRequest": {
      "path": "/t"
     },
     "httpResponse": {
      "body": "abcdef"
     },
     "chaos": {
      "truncateBodyAtFraction": 0.5,
      "latency": {
       "timeUnit": "MILLISECONDS",
       "value": 1
      }
     }
    }
   ]
  },
  {
   "note": "metrics with service chaos",
   "method": "GET",
   "path": "/mockserver/metrics",
   "mask": [
    {
     "regex": "(?m)^(# (HELP|TYPE) )?(jvm|process|tokio|http_server|http_client|mock_server_(?:native_build_info|active_connections|connection_duration_seconds|tls_handshake_duration_seconds))[^\\n]*\\n",
     "replace": ""
    },
    "(_seconds_bucket\\{[^}]*\\}|_seconds_count(\\{[^}]*\\})?|_seconds_sum(\\{[^}]*\\})?) [0-9.E-]+",
    "mock_server_requests_received_total [0-9.E]+",
    "content-length: \\d+"
   , {"regex": "(?m)^(# (HELP|TYPE|UNIT) )?netty_[^\\n]*\\n", "replace": "", "reason": "JvmMetricsCollector's Netty direct-memory gauge, as jvm_*: no counterpart outside the JVM"}, {"regex": "(?m)^(# (HELP|TYPE|UNIT) )?mock_server_accept_queue_backlog_effective[^\\n]*\\n", "replace": "", "reason": "exported only where /proc/sys/net/core/somaxconn is readable (the oracle's Linux container, not a macOS host)"}, {"regex": "(?m)^(mock_server_event_log_retained_bytes|mock_server_expectations_bytes) \\S+", "replace": "${1} <heap-estimate>", "reason": "upstream's JVM heap-size estimates of log entries and expectations"}, {"regex": "(?m)^mock_server_inbound_connections_open \\S+", "replace": "mock_server_inbound_connections_open <connections>", "reason": "the oracle's gauge stays one above its open sockets after its JVM start-up warm-up request (1 with MOCKSERVER_STARTUP_WARMUP=false, no extra socket in its /proc/net/tcp); ours counts open sockets"}]
  },
  {
   "method": "GET",
   "path": "/t"
  },
  {
   "note": "first error",
   "method": "GET",
   "path": "/e"
  },
  {
   "note": "still registered",
   "method": "GET",
   "path": "/mockserver/serviceChaos"
  },
  {
   "note": "second error trips the breaker",
   "method": "GET",
   "path": "/e"
  },
  {
   "note": "service chaos cleared",
   "method": "GET",
   "path": "/mockserver/serviceChaos"
  },
  {
   "note": "tcp chaos cleared",
   "method": "GET",
   "path": "/mockserver/tcpChaos"
  },
  {
   "note": "no active chaos: no halt",
   "method": "GET",
   "path": "/e"
  },
  {
   "method": "GET",
   "path": "/e"
  },
  {
   "note": "metrics after halt",
   "method": "GET",
   "path": "/mockserver/metrics",
   "mask": [
    {
     "regex": "(?m)^(# (HELP|TYPE) )?(jvm|process|tokio|http_server|http_client|mock_server_(?:native_build_info|active_connections|connection_duration_seconds|tls_handshake_duration_seconds))[^\\n]*\\n",
     "replace": ""
    },
    "(_seconds_bucket\\{[^}]*\\}|_seconds_count(\\{[^}]*\\})?|_seconds_sum(\\{[^}]*\\})?) [0-9.E-]+",
    "mock_server_requests_received_total [0-9.E]+",
    "content-length: \\d+"
   , {"regex": "(?m)^(# (HELP|TYPE|UNIT) )?netty_[^\\n]*\\n", "replace": "", "reason": "JvmMetricsCollector's Netty direct-memory gauge, as jvm_*: no counterpart outside the JVM"}, {"regex": "(?m)^(# (HELP|TYPE|UNIT) )?mock_server_accept_queue_backlog_effective[^\\n]*\\n", "replace": "", "reason": "exported only where /proc/sys/net/core/somaxconn is readable (the oracle's Linux container, not a macOS host)"}, {"regex": "(?m)^(mock_server_event_log_retained_bytes|mock_server_expectations_bytes) \\S+", "replace": "${1} <heap-estimate>", "reason": "upstream's JVM heap-size estimates of log entries and expectations"}, {"regex": "(?m)^mock_server_inbound_connections_open \\S+", "replace": "mock_server_inbound_connections_open <connections>", "reason": "the oracle's gauge stays one above its open sockets after its JVM start-up warm-up request (1 with MOCKSERVER_STARTUP_WARMUP=false, no extra socket in its /proc/net/tcp); ours counts open sockets"}]
  },
  {
   "method": "PUT",
   "path": "/mockserver/reset"
  },
  {
   "note": "metrics after reset",
   "method": "GET",
   "path": "/mockserver/metrics",
   "mask": [
    {
     "regex": "(?m)^(# (HELP|TYPE) )?(jvm|process|tokio|http_server|http_client|mock_server_(?:native_build_info|active_connections|connection_duration_seconds|tls_handshake_duration_seconds))[^\\n]*\\n",
     "replace": ""
    },
    "(_seconds_bucket\\{[^}]*\\}|_seconds_count(\\{[^}]*\\})?|_seconds_sum(\\{[^}]*\\})?) [0-9.E-]+",
    "mock_server_requests_received_total [0-9.E]+",
    "content-length: \\d+"
   , {"regex": "(?m)^(# (HELP|TYPE|UNIT) )?netty_[^\\n]*\\n", "replace": "", "reason": "JvmMetricsCollector's Netty direct-memory gauge, as jvm_*: no counterpart outside the JVM"}, {"regex": "(?m)^(# (HELP|TYPE|UNIT) )?mock_server_accept_queue_backlog_effective[^\\n]*\\n", "replace": "", "reason": "exported only where /proc/sys/net/core/somaxconn is readable (the oracle's Linux container, not a macOS host)"}, {"regex": "(?m)^(mock_server_event_log_retained_bytes|mock_server_expectations_bytes) \\S+", "replace": "${1} <heap-estimate>", "reason": "upstream's JVM heap-size estimates of log entries and expectations"}, {"regex": "(?m)^mock_server_inbound_connections_open \\S+", "replace": "mock_server_inbound_connections_open <connections>", "reason": "the oracle's gauge stays one above its open sockets after its JVM start-up warm-up request (1 with MOCKSERVER_STARTUP_WARMUP=false, no extra socket in its /proc/net/tcp); ours counts open sockets"}]
  }
 ]
}