   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "path": "/jvm/m"
    },
    "httpResponseTemplate": {
     "templateType": "MUSTACHE",
     "template": "{\n    \"statusCode\": 200,\n    \"body\": \"java.version=[{{#systemValue.property}}java.version{{/systemValue.property}}] user.home=[{{#systemValue.property}}user.home{{/systemValue.property}}] user.dir=[{{#systemValue.property}}user.dir{{/systemValue.property}}] os.name=[{{#systemValue.property}}os.name{{/systemValue.property}}] file.encoding=[{{#systemValue.property}}file.encoding{{/systemValue.property}}]\"\n}"
    }
   }
  },
  {
   "method": "GET",
   "path": "/jvm/v"
  },
  {
   "method": "GET",
   "path": "/jvm/m"
