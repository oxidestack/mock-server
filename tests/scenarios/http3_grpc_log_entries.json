{
 "quic": true,
 "properties": {
  "http3Port": "19483"
 },
 "steps": [
  {"method": "GET", "path": "/mockserver/http3status", "pollUntil": "\"enabled\" ?: ?true", "note": "wait for the HTTP/3 server"},
  {"h3": true, "method": "GET", "path": "/warm-up", "note": "lets the oracle's startup logging finish"},
  {"method": "PUT", "path": "/mockserver/reset", "note": "the oracle may log its startup entries after the opening reset: reset again"},
  {"method": "PUT", "path": "/mockserver/grpc/descriptors", "bodyFile": "grpc/greeting.dsc", "note": "descriptors"},
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {"httpRequest": {"path": "/com.example.grpc.GreetingService/Greeting"}, "httpResponse": {"body": {"greeting": "hi"}, "delay": {"timeUnit": "MILLISECONDS", "value": 1500}}},
   "mask": ["\"id\" : \"[0-9a-f-]+\""]
  },
  {"h3": true, "method": "POST", "path": "/com.example.grpc.Unknown/Nope", "headers": {"content-type": "application/grpc"}, "bodyBase64": "AAAAAAcKBUFsaWNl", "note": "an unknown gRPC method over HTTP/3"},
  {"h3": true, "method": "POST", "path": "/com.example.grpc.GreetingService/Greeting", "headers": {"content-type": "application/grpc", "grpc-timeout": "200m"}, "bodyBase64": "AAAAAAcKBUFsaWNl", "note": "a grpc-timeout shorter than the response's delay over HTTP/3"},
  {"method": "PUT", "path": "/mockserver/retrieve?type=LOGS", "mask": [{"regex": "(\"totalTimeInMillis\" : )\\d+", "replace": "${1}0"}], "note": "the gRPC-over-HTTP/3 entries; the measured total masked"}
 ]
}
