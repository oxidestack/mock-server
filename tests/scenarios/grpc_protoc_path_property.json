{
 "properties": {
  "proxySetupLogging": "false",
  "grpcProtoDirectory": "{{files}}/grpc/proto",
  "grpcProtocPath": "{{files}}/grpc/no-such-protoc"
 },
 "startupLog": true,
 "steps": [
  {
   "note": "grpcProtocPath names the compiler run for each .proto file",
   "method": "PUT",
   "path": "/mockserver/grpc/services"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS"
  }
 ]
}
