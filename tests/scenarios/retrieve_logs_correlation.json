{"steps": [
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"httpRequest": {"path": "/corr-a"}, "httpResponse": {"body": "a"}}, "mask": ["content-length: \\d+"]},
  {"method": "GET", "path": "/corr-a", "note": "traffic that gets a log correlation id"},
  {"method": "GET", "path": "/corr-b", "note": "traffic that gets another"},
  {"method": "PUT", "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES", "body": {"path": "/corr-a"}, "capture": {"bodyRegex": "\"correlationId\" : \"([^\"]+)\"", "as": "corr"}, "note": "the correlation id of the first /corr-a entry, read from a log entry", "mask": ["\"epochTime\" : \\d+", "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)", "content-length: \\d+"]},
  {"method": "PUT", "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES&correlationId={{capture:corr}}", "note": "LOGS as log entries: only the entries of that correlation id", "mask": ["\"epochTime\" : \\d+", "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)", "content-length: \\d+"]},
  {"method": "PUT", "path": "/mockserver/retrieve?type=LOGS&correlationId={{capture:corr}}", "note": "LOGS as text (default format): the same entries", "mask": ["content-length: \\d+", "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)"]},
  {"method": "PUT", "path": "/mockserver/retrieve?type=LOGS&format=JSON&correlationId={{capture:corr}}", "note": "LOGS as JSON", "mask": ["content-length: \\d+", "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)"]},
  {"method": "PUT", "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES&correlationId={{capture:corr}}", "body": {"path": "/corr-b"}, "note": "the correlation id wins over a request filter in the body", "mask": ["\"epochTime\" : \\d+", "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)", "content-length: \\d+"]},
  {"method": "PUT", "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES&correlationId=no-such-correlation-id", "note": "an unknown correlation id", "mask": ["content-length: \\d+"]},
  {"method": "PUT", "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES&correlationId=", "body": {"path": "/corr-a"}, "note": "a blank correlation id is no filter", "mask": ["\"epochTime\" : \\d+", "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)", "content-length: \\d+"]},
  {"method": "PUT", "path": "/mockserver/retrieve?type=REQUESTS&format=JSON&correlationId=no-such-correlation-id", "body": {"path": "/corr-a"}, "note": "other types ignore the correlation id", "mask": ["content-length: \\d+", "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)"]},
  {"method": "POST", "path": "/mockserver/mcp", "body": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-03-26"}}, "capture": {"header": "Mcp-Session-Id", "as": "s"}, "mask": ["[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", "\"(ports|timestamp)\" ?: ?[^,}]+", "\\d+\\.\\d+\\.\\d+\\.\\d+:(\\d+|<port>)", "\\d{4}-\\d\\d-\\d\\dT[0-9:.]+Z", "content-length: \\d+"]},
  {"method": "POST", "path": "/mockserver/mcp", "headers": {"Mcp-Session-Id": ["{{capture:s}}"]}, "body": {"jsonrpc": "2.0", "method": "notifications/initialized"}},
  {"method": "POST", "path": "/mockserver/mcp", "headers": {"Mcp-Session-Id": ["{{capture:s}}"]}, "body": {"jsonrpc": "2.0", "id": 2, "method": "tools/call", "params": {"name": "retrieve_logs", "arguments": {"correlationId": "{{capture:corr}}"}}}, "note": "retrieve_logs with a known correlationId (upstream shouldRetrieveLogsFilteredByCorrelationId)", "mask": ["content-length: \\d+", "epochTime\\\\*\" : \\d+", "\\d{4}-\\d\\d-\\d\\d \\d\\d:\\d\\d:\\d\\d\\.\\d+", "\\\\*\"port\\\\*\" : \\d+", "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)"]},
  {"method": "POST", "path": "/mockserver/mcp", "headers": {"Mcp-Session-Id": ["{{capture:s}}"]}, "body": {"jsonrpc": "2.0", "id": 3, "method": "tools/call", "params": {"name": "retrieve_logs", "arguments": {"correlationId": "{{capture:corr}}", "limit": 1}}}, "note": "retrieve_logs with a known correlationId and a limit", "mask": ["content-length: \\d+", "epochTime\\\\*\" : \\d+", "\\d{4}-\\d\\d-\\d\\d \\d\\d:\\d\\d:\\d\\d\\.\\d+", "\\\\*\"port\\\\*\" : \\d+", "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)"]},
  {"method": "POST", "path": "/mockserver/mcp", "headers": {"Mcp-Session-Id": ["{{capture:s}}"]}, "body": {"jsonrpc": "2.0", "id": 4, "method": "tools/call", "params": {"name": "raw_retrieve", "arguments": {"type": "LOGS", "format": "LOG_ENTRIES", "correlationId": "{{capture:corr}}"}}}, "note": "raw_retrieve LOGS with a known correlationId", "mask": ["content-length: \\d+", "epochTime\\\\*\" : \\d+", "\\d{4}-\\d\\d-\\d\\d \\d\\d:\\d\\d:\\d\\d\\.\\d+", "\\\\*\"port\\\\*\" : \\d+", "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)"]},
  {"method": "POST", "path": "/mockserver/mcp", "headers": {"Mcp-Session-Id": ["{{capture:s}}"]}, "body": {"jsonrpc": "2.0", "id": 5, "method": "tools/call", "params": {"name": "raw_retrieve", "arguments": {"type": "LOGS", "format": "JSON", "correlationId": "{{capture:corr}}"}}}, "note": "raw_retrieve LOGS as JSON with a known correlationId", "mask": ["content-length: \\d+", "epochTime\\\\*\" : \\d+", "\\d{4}-\\d\\d-\\d\\d \\d\\d:\\d\\d:\\d\\d\\.\\d+", "\\\\*\"port\\\\*\" : \\d+", "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)"]}
]}
