       "matchJson": ".*",
       "responses": [
        {
         "json": "{\"greeting\": \"Hello $jsonPath.find(\"$.name\")\"}",
         "templateType": "VELOCITY"
        }
       ]
      }
     ]
    }
   }
  },
  {
