{
 "properties": {
  "grpcBidiStreamingEnabled": "true"
 },
 "steps": [
  {
   "note": "upload greeting descriptor",
   "method": "PUT",
   "path": "/mockserver/grpc/descriptors",
   "bodyFile": "grpc/greeting.dsc"
  },
  {
   "note": "clear expectations",
   "method": "PUT",
   "path": "/mockserver/clear?type=EXPECTATIONS"
  },
  {
   "note": "expectation: static json with a $ref is not a template",
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "path": "/com.example.grpc.GreetingService/Chat"
    },
    "grpcBidiResponse": {
     "statusName": "OK",
     "rules": [
      {
       "matchJson": ".*",
       "responses": [
        {
         "json": "{\"greeting\": \"Hi $ref #/not/a/template\"}"
        }
       ]
      }
     ]
    }
   }
  },
  {
   "note": "no templateType: emitted verbatim",
   "h2": true,
   "method": "POST",
   "path": "/com.example.grpc.GreetingService/Chat",
   "headers": {
    "content-type": "application/grpc",
    "te": "trailers"
   },
   "trailers": true,
   "bodyBase64": "AAAAAAcKBUFsaWNl"
  },
  {
   "note": "clear expectations",
   "method": "PUT",
   "path": "/mockserver/clear?type=EXPECTATIONS"
  },
  {
   "note": "expectation: velocity jsonPath",
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "path": "/com.example.grpc.GreetingService/Chat"
    },
    "grpcBidiResponse": {
     "statusName": "OK",
