  {
   "method": "PUT",
   "path": "/mockserver/clock",
   "body": {
    "action": "reset"
   },
   "note": "start from the real clock: reset does not touch it, so an earlier scenario may have left it frozen",
   "mask": [
    "\"currentInstant\" : \"[^\"]+\"",
    "\"currentEpochMillis\" : -?[0-9]+"
   ]
  },
