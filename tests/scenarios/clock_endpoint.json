  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": [
    {
     "httpRequest": {
      "path": "/clock/velocity"
     },
     "httpResponseTemplate": {
      "templateType": "VELOCITY",
      "template": "{ \"statusCode\": 200, \"body\": \"$now|$now_epoch|$now_iso_8601|$now_rfc_1123|$dates|$dates.plusSeconds(5)|$dates.plusMinutes(5)|$dates.plusHours(5)|$dates.plusDays(1)|$dates.minusSeconds(5)|$dates.minusMinutes(5)|$dates.minusHours(5)|$dates.minusDays(1)|$dates.epochSeconds()|$dates.epochMillis()|$dates.epochSecondsPlus(60)|$dates.epochSecondsMinus(60)|$dates.format('yyyy-MM-dd HH:mm:ss.SSS')\" }"
     }
    },
    {
     "httpRequest": {
      "path": "/clock/mustache"
     },
     "httpResponseTemplate": {
      "templateType": "MUSTACHE",
      "template": "{ \"statusCode\": 200, \"body\": \"{{ now }}|{{ now_epoch }}|{{ now_iso_8601 }}|{{ now_rfc_1123 }}|{{ dates }}|{{ dates.epochMillis }}\" }"
     }
    }
   ],
   "note": "templates under the frozen clock"
  },
