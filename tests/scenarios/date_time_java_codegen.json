{
  "source": "hand-written: retrieve format=JAVA of date-time matchers (NottableStringToJavaSerializer.serializeDateTime, CookieToJavaSerializer, HttpRequestToJavaSerializer's JSON_PATH and XPATH dateTime); isolated: no clock is read.",
  "isolated": true,
  "steps": [
    { "method": "PUT", "path": "/mockserver/reset" },
    {
      "method": "PUT",
      "path": "/mockserver/expectation",
      "body": [
        {
          "httpRequest": {
            "method": "GET",
            "path": "/date-time",
            "headers": {
              "X-Issued-At": [ { "after": "now -1 hours" }, "plain" ],
              "If-Modified-Since": [ { "before": "2026-10-21T00:00:00Z", "actualFormat": "rfc1123" } ],
              "X-Plain": [ "before:2026-01-01" ]
            },
            "queryStringParameters": {
              "from": [ { "after": "2026-01-01", "actualFormat": "dd/MM/yyyy", "zone": "Europe/London" } ]
            },
            "cookies": {
              "seen": {
                "not": true,
                "equalToDateTime": "now +1 days",
                "truncateExpected": "first day of month",
                "truncateActual": "startOfDay",
                "applyTruncationLast": true
              },
              "plain": "x"
            }
          },
          "httpResponse": { "statusCode": 200, "body": "dated" }
        },
        {
          "httpRequest": {
            "path": "/epoch",
            "headers": {
              "X-Epoch": [
                { "equalToDateTime": "2026-06-15T12:30:45Z", "actualFormat": "epochMillis" },
                { "not": true, "before": "now PT1H", "truncateActual": "startOfHour", "zone": "+02:00" }
              ]
            },
            "queryStringParameters": [
              { "name": "!at", "values": [ { "after": "Mon, 15 Jun 2026 12:00:00 GMT", "truncateExpected": "startOfDay" } ] }
            ],
            "pathParameters": {
              "id": [ { "before": "now -2 hours" } ]
            }
          },
          "httpResponse": { "body": "epoch" }
        },
        {
          "httpRequest": {
            "path": "/json-path",
            "body": {
              "type": "JSON_PATH",
              "jsonPath": "$.issuedAt",
              "dateTime": { "not": true, "after": "now -1 days", "zone": "UTC" }
            }
          },
          "httpResponse": { "body": "jp" }
        },
        {
          "httpRequest": {
            "path": "/xpath",
            "body": {
              "type": "XPATH",
              "xpath": "/root/issuedAt",
              "dateTime": { "before": "now +1 days", "actualFormat": "yyyy-MM-dd" }
            }
          },
          "httpResponse": { "body": "xp" }
        },
        {
          "httpRequest": {
            "path": "/xpath-ns",
            "body": {
              "type": "XPATH",
              "xpath": "/a:root/a:issuedAt",
              "namespacePrefixes": { "a": "urn:a" },
              "dateTime": { "equalToDateTime": "2026-01-01" }
            }
          },
          "httpResponse": { "body": "xpn" }
        }
      ]
    },
    {
      "method": "PUT",
      "path": "/mockserver/retrieve?type=ACTIVE_EXPECTATIONS&format=JAVA",
      "note": "every date-time value as NottableDateTimeString.<operator>(...) with its options"
    }
  ]
}
