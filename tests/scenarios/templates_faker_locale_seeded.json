{
 "source": "seeded locale fakers, each with its own new Random(templateFakerSeed)",
 "properties": {
  "templateFakerSeed": "99"
 },
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/reset"
  },
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "path": "/t0"
    },
    "httpResponseTemplate": {
     "templateType": "VELOCITY",
     "template": "{\n    'statusCode': 200,\n    'body': \"de=$faker.locale('de').name().firstName() $faker.locale('de-DE').name().firstName() | ja=$faker.locale('ja').name().lastName() | fr=$faker.locale('fr-FR').address().city() | gb=$faker.locale('en-GB').address().postcode() | ru=$faker.locale('ru').name().fullName() | root=$faker.name().firstName() | br=$faker.locale('pt-BR').address().cityName()\"\n}"
    }
   }
  },
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "path": "/t1"
    },
    "httpResponseTemplate": {
     "templateType": "MUSTACHE",
     "template": "{\n    \"statusCode\": 200,\n    \"body\": \"de={{faker.locale.de.name.firstName}} | fr={{faker.locale.fr.address.city}} | ja={{faker.locale.ja.name.lastName}} | root={{faker.name.firstName}}\"\n}"
    }
   }
  },
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "path": "/t2"
    },
    "httpResponseTemplate": {
     "templateType": "VELOCITY",
     "template": "{\n    'statusCode': 200,\n    'body': \"de=$faker.locale('de').name().firstName() $faker.locale('de-DE').name().firstName() | ja=$faker.locale('ja').name().lastName() | fr=$faker.locale('fr-FR').address().city() | gb=$faker.locale('en-GB').address().postcode() | ru=$faker.locale('ru').name().fullName() | root=$faker.name().firstName() | br=$faker.locale('pt-BR').address().cityName()\"\n}"
    }
   }
  },
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "path": "/t3"
    },
    "httpResponseTemplate": {
     "templateType": "MUSTACHE",
     "template": "{\n    \"statusCode\": 200,\n    \"body\": \"de={{faker.locale.de.name.firstName}} | fr={{faker.locale.fr.address.city}} | ja={{faker.locale.ja.name.lastName}} | root={{faker.name.firstName}}\"\n}"
    }
   }
  },
  {
   "method": "GET",
   "path": "/t0",
   "mask": [
    {
     "regex": " at t\\d+\\[line ",
     "replace": " at t<n>[line ",
     "reason": "the Velocity engine names each template by how many it rendered before: on a shared server that counts earlier scenarios' templates too"
    }
   ]
  },
  {
   "method": "GET",
   "path": "/t1"
  },
  {
   "method": "GET",
   "path": "/t2",
   "mask": [
    {
     "regex": " at t\\d+\\[line ",
     "replace": " at t<n>[line ",
     "reason": "the Velocity engine names each template by how many it rendered before: on a shared server that counts earlier scenarios' templates too"
    }
   ]
  },
  {
   "method": "GET",
   "path": "/t3"
  }
 ]
}