{
  "quic": true,
  "properties": {
    "http3Port": "19629",
    "maxRequestBodySize": "1048576"
  },
  "steps": [
    {
      "method": "GET",
      "path": "/mockserver/http3status",
      "pollUntil": "\"enabled\" ?: ?true",
      "note": "wait for the HTTP/3 server"
    },
    {
      "h3": true,
      "method": "GET",
      "path": "/warm-up",
      "note": "lets the oracle's startup logging finish"
    },
    {
      "method": "PUT",
      "path": "/mockserver/reset",
      "note": "the oracle may log its startup entries after the opening reset: reset again"
    },
    {
      "method": "PUT",
      "path": "/mockserver/expectation",
      "body": [
        {
          "id": "h3gz-match",
          "httpRequest": {
            "path": "/h3_gzip",
            "body": {
              "type": "JSON",
              "json": "{\"name\":\"value\",\"text\":\"héllo wörld\"}"
            }
          },
          "httpResponse": {
            "body": "matched_gzip"
          }
        },
        {
          "id": "h3gz-bomb",
          "httpRequest": {
            "path": "/h3_gzip_bomb"
          },
          "httpResponse": {
            "body": "should_not_match"
          }
        },
        {
          "id": "h3gz-corrupt",
          "httpRequest": {
            "path": "/h3_gzip_corrupt"
          },
          "httpResponse": {
            "body": "should_not_match"
          }
        }
      ]
    },
    {
      "h3": true,
      "method": "POST",
      "path": "/h3_gzip",
      "headers": {
        "content-type": "application/json",
        "content-encoding": "gzip",
        "content-length": "58"
      },
      "bodyBase64": "H4sIAAAAAAACE6tWykvMTVWyUipLzClNVdJRKkmtKAFyMw6vzMnJVyg/vK0oJ0WpFgC4p6LGJwAAAA==",
      "note": "a gzip body over HTTP/3 is matched on its decompressed content"
    },
    {
      "h3": true,
      "method": "POST",
      "path": "/h3_gzip_bomb",
      "headers": {
        "content-encoding": "gzip"
      },
      "bodyBase64": "",
      "note": "a body that decompresses past maxRequestBodySize is answered 413"
    },
    {
      "h3": true,
      "method": "POST",
      "path": "/h3_gzip_corrupt",
      "headers": {
        "content-encoding": "gzip"
      },
      "body": "this is not gzip",
      "note": "a corrupt gzip body closes the stream without a response"
    },
    {
      "h3": true,
      "method": "POST",
      "path": "/h3_gzip_corrupt",
      "body": "plain",
      "note": "the server keeps serving"
    },
    {
      "method": "PUT",
      "path": "/mockserver/retrieve?type=REQUESTS&format=JSON",
      "body": {
        "path": "/h3_gzip"
      },
      "note": "the recorded request"
    }
  ]
}
