{
 "properties": {
  "binaryMessageFraming": "LENGTH_PREFIX",
  "binaryMessageLengthPrefixBytes": "2",
  "binaryMessageLengthPrefixByteOrder": "LITTLE_ENDIAN",
  "maxRequestBodySize": "16384"
 },
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "note": "BinaryMessageFramingIntegrationTest's length-prefixed messages",
   "mask": [
    "\"id\" : \"[0-9a-f-]+\""
   ],
   "body": [
    {
     "httpRequest": {
      "binaryData": ""
     },
     "binaryResponse": {
      "binaryData": "AQBM"
     }
    },
    {
     "httpRequest": {
      "binaryData": "CgBhYWFhYWFhYWFh"
     },
     "binaryResponse": {
      "binaryData": "AQBB"
     }
    },
    {
     "httpRequest": {
      "binaryData": "AAA="
     },
     "binaryResponse": {
      "binaryData": "AQBC"
     }
    }
   ]
  },
  {
   "tcp": [
    "",
    "",
    "CgBhYWFhYWFhYWFhAAA="
   ],
   "note": "a message in two parts is one message; two written together are two"
  },
  {
   "tcp": [
    "IE4="
   ],
   "note": "a declared length over maxRequestBodySize closes the connection"
  },
  {
   "sleepMillis": 300
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS",
   "note": "the refusal's WARN",
   "mask": [
    "content-length: \\d+",
    "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)"
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/reset"
  }
 ]
}
