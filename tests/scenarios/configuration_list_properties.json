{
 "properties": {
  "logLevel": "INFO"
 },
 "steps": [
  {
   "method": "GET",
   "path": "/mockserver/configuration",
   "note": "defaults"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "loadGenerationMetricLabels": [
     "a,b",
     "c"
    ]
   },
   "note": "a list keeps every element as given: a comma inside one stays inside it"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "loadGenerationMetricLabels": [
     "a",
     null,
     "c"
    ]
   },
   "note": "null elements, blank and padded elements, duplicates are all kept"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "loadGenerationMetricLabels": [
     null
    ]
   },
   "note": "only nulls"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "loadGenerationMetricLabels": [
     "",
     " x ",
     "y "
    ]
   },
   "note": "blank and padded text"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "loadGenerationMetricLabels": [
     "a",
     "a",
     "b"
    ]
   },
   "note": "duplicates"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "loadGenerationMetricLabels": "a,b,c"
   },
   "note": "a text is one element, commas and all"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "loadGenerationMetricLabels": "a, b"
   },
   "note": "a padded text"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "loadGenerationMetricLabels": [
     1,
     true,
     2.5
    ]
   },
   "note": "numbers and booleans become text"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "loadGenerationMetricLabels": []
   },
   "note": "empty list"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "loadGenerationMetricLabels": [
     ""
    ]
   },
   "note": "a list with one empty text"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "loadGenerationMetricLabels": [
     "k",
     "m"
    ]
   },
   "note": "set to something before a blank text"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "loadGenerationMetricLabels": ""
   },
   "note": "a blank text"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "loadGenerationMetricLabels": [
     "k",
     "m"
    ]
   },
   "note": "set again before a null"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "loadGenerationMetricLabels": null
   },
   "note": "a null"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "loadGenerationMetricLabels": [
     "x\"q",
     "back\\slash"
    ]
   },
   "note": "quotes and backslashes"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "loadGenerationMetricLabels": [
     [
      "a"
     ]
    ]
   },
   "note": "a nested array fails"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "loadGenerationMetricLabels": {
     "a": 1
    }
   },
   "note": "an object fails"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "controlPlaneJWTAuthenticationRequiredClaims": [
     "a,b",
     "c"
    ]
   },
   "note": "a set keeps a comma inside an element and prints in hash order"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "controlPlaneJWTAuthenticationRequiredClaims": [
     "a",
     null
    ]
   },
   "note": "a null element is allowed"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "controlPlaneJWTAuthenticationRequiredClaims": [
     null
    ]
   },
   "note": "only a null"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "controlPlaneJWTAuthenticationRequiredClaims": [
     "",
     " x ",
     "y "
    ]
   },
   "note": "blank and padded elements"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "controlPlaneJWTAuthenticationRequiredClaims": "a,b,c"
   },
   "note": "a text is one element"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "controlPlaneJWTAuthenticationRequiredClaims": []
   },
   "note": "empty"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "controlPlaneJWTAuthenticationRequiredClaims": [
     ""
    ]
   },
   "note": "one empty text"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "controlPlaneJWTAuthenticationRequiredClaims": [
     "x",
     "x",
     "y"
    ]
   },
   "note": "duplicates collapse"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "controlPlaneOidcRequiredScopes": [
     "a b",
     "c,d"
    ]
   },
   "note": "scopes: spaces and commas inside elements"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "controlPlaneOidcRequiredScopes": [
     "a",
     null
    ]
   },
   "note": "a null element"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "controlPlaneOidcRequiredScopes": "s1,s2"
   },
   "note": "a text"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "controlPlaneOidcRequiredScopes": [
     "x",
     "x"
    ]
   },
   "note": "duplicates"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "controlPlaneOidcRequiredScopes": [
     ""
    ]
   },
   "note": "one empty text"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "controlPlaneOidcRequiredScopes": []
   },
   "note": "empty"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "sslSubjectAlternativeNameDomains": [
     "a,b",
     "c"
    ]
   },
   "note": "domains: a comma inside an element"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "sslSubjectAlternativeNameDomains": [
     "A.Example",
     " b.example "
    ]
   },
   "note": "case and padding are not touched"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "sslSubjectAlternativeNameDomains": [
     ""
    ]
   },
   "note": "one empty text"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "maxExpectations": 31,
    "sslSubjectAlternativeNameDomains": [
     "a",
     null
    ]
   },
   "note": "a null element refuses the update; what comes before it in the update is already in force"
  },
  {
   "method": "GET",
   "path": "/mockserver/configuration",
   "note": "maxExpectations shows whether the first member applied"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "sslSubjectAlternativeNameDomains": []
   },
   "note": "empty"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "sslSubjectAlternativeNameIps": [
     "1.2.3.4,5.6.7.8"
    ]
   },
   "note": "ips: a comma inside an element"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "sslSubjectAlternativeNameIps": [
     "1.2.3.4",
     ""
    ]
   },
   "note": "an empty text among others"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "sslSubjectAlternativeNameIps": [
     "1.2.3.4",
     null
    ]
   },
   "note": "a null ip"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "sslSubjectAlternativeNameIps": []
   },
   "note": "empty"
  },
  {
   "method": "GET",
   "path": "/mockserver/configuration",
   "note": "whole configuration"
  }
 ]
}
