{
 "source": "the load scenario registry lives in the state backend, so PUT /mockserver/reset leaves loaded scenarios registered (found by the loadreg harvest)",
 "steps": [
  {"method": "DELETE", "path": "/mockserver/loadScenario", "note": "start empty"},
  {"method": "PUT", "path": "/mockserver/loadScenario", "body": {"name": "kept", "steps": [{"request": {"path": "/harvested"}}], "profile": {"stages": [{"type": "VU", "vus": 1, "durationMillis": 1000}]}}, "note": "load"},
  {"method": "PUT", "path": "/mockserver/reset", "note": "reset"},
  {"method": "GET", "path": "/mockserver/loadScenario", "note": "still listed after the reset"},
  {"method": "GET", "path": "/mockserver/loadScenario/kept", "note": "still readable after the reset"},
  {"method": "DELETE", "path": "/mockserver/loadScenario", "note": "clean up"}
 ]
}
