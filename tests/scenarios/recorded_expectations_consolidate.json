{
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/import?format=recording&redactSensitiveData=false",
   "bodyFile": "import/recording_dedup.ndjson",
   "note": "recording archive"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS",
   "note": "verbatim by default"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&consolidate=true",
   "note": "consolidated"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&parameterize=true",
   "note": "parameterized"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&consolidate=TRUE&format=PYTHON",
   "note": "consolidated python"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&consolidate=false",
   "note": "consolidate false is verbatim"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS",
   "note": "log messages"
  }
 ]
}
