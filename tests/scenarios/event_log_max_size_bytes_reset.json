{
 "source": "CircularConcurrentLinkedDequeTest.shouldResetByteTotalOnClearSoLaterAddsAreNotSpuriouslyEvicted: a reset clears the byte total with the entries, so after filling the maxEventLogSizeInBytes budget and resetting, later entries that fit are all kept. Entries weigh as in event_log_max_size_bytes: 145 bytes per matched request.",
 "properties": {
  "maxEventLogSizeInBytes": "300"
 },
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "id": "budget-reset",
    "httpRequest": {
     "path": "/budget"
    },
    "httpResponse": {
     "statusCode": 200,
     "body": "a-very-long-response-body"
    }
   }
  },
  {
   "method": "POST",
   "path": "/budget",
   "body": "0123456789012345678901234567890123456789"
  },
  {
   "method": "POST",
   "path": "/budget",
   "body": "0123456789012345678901234567890123456789",
   "note": "fills the budget: the oldest entries are evicted"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES",
   "mask": [
    {
     "regex": "(\"epochTime\" : )\\d+",
     "replace": "${1}0"
    }
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/reset"
  },
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "id": "budget-reset",
    "httpRequest": {
     "path": "/budget"
    },
    "httpResponse": {
     "statusCode": 200,
     "body": "a-very-long-response-body"
    }
   }
  },
  {
   "method": "POST",
   "path": "/budget",
   "body": "0123456789012345678901234567890123456789",
   "note": "one request's entries fit the empty budget"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES",
   "note": "every entry since the reset is kept",
   "mask": [
    {
     "regex": "(\"epochTime\" : )\\d+",
     "replace": "${1}0"
    }
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=REQUESTS"
  }
 ]
}
