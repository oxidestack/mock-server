{
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/reset"
  },
  {
   "note": "register logs",
   "method": "PUT",
   "path": "/mockserver/tcpChaos",
   "body": {
    "host": "a.svc",
    "chaos": {
     "latencyMs": "25",
     "down": "TRUE",
     "timeout": 1,
     "slicerChunkSize": 4.7
    }
   }
  },
  {
   "note": "string numbers coerced",
   "method": "GET",
   "path": "/mockserver/tcpChaos"
  },
  {
   "note": "ttl as string",
   "method": "PUT",
   "path": "/mockserver/tcpChaos",
   "body": {
    "host": "b.svc",
    "chaos": {
     "resetPeer": true
    },
    "ttlMillis": "abc"
   }
  },
  {
   "note": "host as number",
   "method": "PUT",
   "path": "/mockserver/tcpChaos",
   "body": {
    "host": 42,
    "chaos": {
     "slowClose": true
    }
   }
  },
  {
   "note": "host as object",
   "method": "PUT",
   "path": "/mockserver/tcpChaos",
   "body": {
    "host": {
     "x": 1
    },
    "chaos": {
     "slowClose": true
    }
   }
  },
  {
   "note": "clear as string",
   "method": "PUT",
   "path": "/mockserver/tcpChaos",
   "body": {
    "clear": "true",
    "host": ""
   }
  },
  {
   "note": "chaos not an object",
   "method": "PUT",
   "path": "/mockserver/tcpChaos",
   "body": {
    "host": "c.svc",
    "chaos": "fast"
   }
  },
  {
   "note": "bad boolean",
   "method": "PUT",
   "path": "/mockserver/tcpChaos",
   "body": {
    "host": "c.svc",
    "chaos": {
     "down": "maybe"
    }
   }
  },
  {
   "note": "long from bool",
   "method": "PUT",
   "path": "/mockserver/tcpChaos",
   "body": {
    "host": "c.svc",
    "chaos": {
     "latencyMs": true
    }
   }
  },
  {
   "note": "long from object",
   "method": "PUT",
   "path": "/mockserver/tcpChaos",
   "body": {
    "host": "c.svc",
    "chaos": {
     "latencyMs": {}
    }
   }
  },
  {
   "note": "bool from array",
   "method": "PUT",
   "path": "/mockserver/tcpChaos",
   "body": {
    "host": "c.svc",
    "chaos": {
     "down": []
    }
   }
  },
  {
   "note": "chaos number",
   "method": "PUT",
   "path": "/mockserver/tcpChaos",
   "body": {
    "host": "c.svc",
    "chaos": 5
   }
  },
  {
   "note": "chaos array",
   "method": "PUT",
   "path": "/mockserver/tcpChaos",
   "body": {
    "host": "c.svc",
    "chaos": []
   }
  },
  {
   "note": "chaos bool",
   "method": "PUT",
   "path": "/mockserver/tcpChaos",
   "body": {
    "host": "c.svc",
    "chaos": true
   }
  },
  {
   "note": "delay not an object",
   "method": "PUT",
   "path": "/mockserver/tcpChaos",
   "body": {
    "host": "c.svc",
    "chaos": {
     "slowCloseDelay": "1s"
    }
   }
  },
  {
   "note": "int overflow",
   "method": "PUT",
   "path": "/mockserver/tcpChaos",
   "body": {
    "host": "c.svc",
    "chaos": {
     "slicerChunkSize": 99999999999
    }
   }
  },
  {
   "note": "limit data invalid",
   "method": "PUT",
   "path": "/mockserver/tcpChaos",
   "body": {
    "host": "c.svc",
    "chaos": {
     "limitDataBytes": 0
    }
   }
  },
  {
   "note": "reset chunks invalid",
   "method": "PUT",
   "path": "/mockserver/tcpChaos",
   "body": {
    "host": "c.svc",
    "chaos": {
     "resetAfterResponseChunks": -1
    }
   }
  },
  {
   "note": "last stream invalid",
   "method": "PUT",
   "path": "/mockserver/tcpChaos",
   "body": {
    "host": "c.svc",
    "chaos": {
     "http2GoAwayLastStreamId": -2
    }
   }
  },
  {
   "note": "invalid json",
   "method": "PUT",
   "path": "/mockserver/tcpChaos",
   "body": "{\"host\": }"
  },
  {
   "note": "patch invalid json",
   "method": "PATCH",
   "path": "/mockserver/tcpChaos",
   "body": "{\"host\": }"
  },
  {
   "note": "case-insensitive properties",
   "method": "PATCH",
   "path": "/mockserver/tcpChaos",
   "body": {
    "host": "a.svc",
    "chaos": {
     "LATENCYMS": 7,
     "slowclosedelay": {
      "timeUnit": "SECONDS",
      "value": 1
     }
    }
   }
  },
  {
   "note": "ipv6 host",
   "method": "PUT",
   "path": "/mockserver/tcpChaos",
   "body": {
    "host": "[::1]:8080",
    "chaos": {
     "latencyMs": 1
    }
   }
  },
  {
   "note": "colon host",
   "method": "PUT",
   "path": "/mockserver/tcpChaos",
   "body": {
    "host": "::1",
    "chaos": {
     "latencyMs": 1
    }
   }
  },
  {
   "note": "list",
   "method": "GET",
   "path": "/mockserver/tcpChaos"
  },
  {
   "method": "PUT",
   "path": "/mockserver/tcpChaos",
   "body": {
    "host": "a.svc",
    "remove": true
   }
  },
  {
   "method": "PUT",
   "path": "/mockserver/tcpChaos",
   "body": {
    "clear": true
   }
  },
  {
   "note": "preemption mode unknown",
   "method": "PUT",
   "path": "/mockserver/preemption",
   "body": {
    "mode": "sideways"
   },
   "mask": [
    "\"drainRemainingMillis\" : \\d+"
   ]
  },
  {
   "note": "preemption array",
   "method": "PUT",
   "path": "/mockserver/preemption",
   "body": "[]"
  },
  {
   "note": "preemption bad long",
   "method": "PUT",
   "path": "/mockserver/preemption",
   "body": "{\"drainMillis\": \"abc\"}"
  },
  {
   "note": "preemption bool long",
   "method": "PUT",
   "path": "/mockserver/preemption",
   "body": "{\"mode\": \"goaway\",\n  \"ttlMillis\": true}"
  },
  {
   "note": "preemption spaced array",
   "method": "PUT",
   "path": "/mockserver/preemption",
   "body": "\n  [1]"
  },
  {
   "note": "preemption string",
   "method": "PUT",
   "path": "/mockserver/preemption",
   "body": "\"x\""
  },
  {
   "note": "preemption number",
   "method": "PUT",
   "path": "/mockserver/preemption",
   "body": "5"
  },
  {
   "note": "preemption mode number",
   "method": "PUT",
   "path": "/mockserver/preemption",
   "body": "{\"mode\": 1}",
   "mask": [
    "\"drainRemainingMillis\" : \\d+"
   ]
  },
  {
   "note": "preemption float drain",
   "method": "PUT",
   "path": "/mockserver/preemption",
   "body": "{\"drainMillis\": 2000.9, \"mode\": \"GoAway\"}",
   "mask": [
    "\"drainRemainingMillis\" : \\d+"
   ]
  },
  {
   "note": "preemption null",
   "method": "PUT",
   "path": "/mockserver/preemption",
   "body": "null",
   "mask": [
    "\"drainRemainingMillis\" : \\d+"
   ]
  },
  {
   "note": "preemption strings and ttl",
   "method": "PUT",
   "path": "/mockserver/preemption",
   "body": {
    "mode": "Reject503",
    "drainMillis": "0",
    "ttlMillis": 90000000,
    "lastStreamId": 3
   }
  },
  {
   "method": "DELETE",
   "path": "/preemption"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS"
  },
  {"note": "the same entries as LOG_ENTRIES (a Java throwable, stack frames and all, is left out: docs/divergences.md)", "method": "PUT", "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES", "mask": [{"regex": ",\\s*\"throwable\" : \\{[\\s\\S]*?\\n    \\}", "replace": ""}, {"regex": "(\"epochTime\" : )\\d+", "replace": "${1}0"}, "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)", {"regex": "(Millis\\\\?\" : )\\d+", "replace": "${1}0"}, {"regex": "(x-mockserver-response-time-ms\\\\?\" : \\[\\s*\\\\?\")\\d+", "replace": "${1}0"}]}
]
}