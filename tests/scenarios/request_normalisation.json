   },
   "bodyBase64": "H4sIADT9tWoAA6vKLChITVFIyk+pBADAE813CwAAAA=="
  },
  {
   "note": "recorded gzip request",
   "method": "PUT",
   "path": "/mockserver/retrieve?type=REQUESTS",
   "body": {
    "path": "/gzip"
   }
  },
  {
   "note": "recorded chunked request",
   "method": "PUT",
   "path": "/mockserver/retrieve?type=REQUESTS",
   "body": {
    "path": "/chunked"
   }
  }
 ]
