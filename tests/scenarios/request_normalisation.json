   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": "{\n  // a comment\n  'httpRequest': {'path': '/lenient',},\n  \"httpResponse\": {\"body\": \"ok\"},\n}"
  },
  {
   "method": "GET",
   "path": "/lenient"
  },
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": [
    {
     "httpRequest": {
      "path": "/query-case",
      "queryStringParameters": {
       "Name": [
        "v"
       ]
      }
     },
     "httpResponse": {
      "body": "query-case"
     }
    },
    {
     "httpRequest": {
      "path": "/chunked",
      "body": "hello chunks"
     },
     "httpResponse": {
      "body": "chunked"
     }
    }
   ]
  },
  {
   "note": "query name with other case",
   "method": "GET",
   "path": "/query-case?name=v"
  },
  {
   "note": "query name same case",
   "method": "GET",
   "path": "/query-case?Name=v"
  },
  {
   "note": "chunked request",
   "method": "POST",
   "path": "/chunked",
   "headers": {
