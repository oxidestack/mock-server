{
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": "[{\"httpRequest\": {\"path\": \"/target\"}, \"httpResponse\": {\"headers\": {\"some\": [\"header\"], \"cookie\": [\"some=parameter\"]}, \"body\": \"some_body_one\"}}, {\"httpRequest\": {\"path\": \"/fwd\"}, \"httpOverrideForwardedRequest\": {\"requestOverride\": {\"path\": \"/target\", \"headers\": {\"Host\": [\"localhost:{{port}}\"]}}}}, {\"httpRequest\": {\"path\": \"/direct-set\"}, \"httpResponse\": {\"headers\": {\"set-cookie\": [\"a=b\"]}, \"body\": \"x\"}}, {\"httpRequest\": {\"path\": \"/direct-cookies\"}, \"httpResponse\": {\"cookies\": {\"c\": \"d\"}, \"body\": \"x\"}}]"
  },
  {
   "method": "GET",
   "path": "/target",
   "note": "a response with a cookie header, served directly"
  },
  {
   "method": "GET",
   "path": "/fwd",
   "note": "the same response forwarded: upstream decodes its cookie header as a cookie and re-encodes it"
  },
  {
   "method": "GET",
   "path": "/direct-set",
   "note": "a set-cookie header"
  },
  {
   "method": "GET",
   "path": "/direct-cookies",
   "note": "response cookies"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&format=JSON",
   "note": "the recorded expectation of the forward"
  }
 ]
}
