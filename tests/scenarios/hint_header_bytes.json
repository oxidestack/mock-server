{
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "path": "/ctl",
     "body": "abc"
    },
    "httpResponse": {
     "statusCode": 200
    }
   }
  },
  {
   "method": "POST",
   "path": "/ctl",
   "headers": {
    "content-type": "text/plain"
   },
   "bodyBase64": "YRFi",
   "note": "a control character in the closest-match hint: Netty rejects the header, only the status line goes out and the connection stays open"
  },
  {
   "method": "POST",
   "path": "/ctl",
   "headers": {
    "content-type": "text/plain"
   },
   "bodyBase64": "YX9i",
   "note": "DEL is a control character too"
  },
  {
   "method": "POST",
   "path": "/ctl",
   "headers": {
    "content-type": "text/plain"
   },
   "body": "a\tb",
   "note": "a tab is fine"
  },
  {
   "method": "POST",
   "path": "/ctl",
   "headers": {
    "content-type": "text/plain"
   },
   "bodyBase64": "YcOp",
   "note": "non-ASCII: the text/plain body decodes as ISO-8859-1, the hint carries its bytes"
  }
 ]
}
