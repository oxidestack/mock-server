{"steps": [
  {"note": "a character java.net.URI refuses in a path: 400 with the URISyntaxException text", "method": "GET", "path": "/mockserver/dashboard/a[b"},
  {"note": "a vertical bar", "method": "GET", "path": "/mockserver/dashboard/a|b"},
  {"note": "a malformed escape", "method": "GET", "path": "/mockserver/dashboard/%zz"},
  {"note": "a malformed escape further in, after a subdirectory", "method": "GET", "path": "/mockserver/dashboard/assets/a%b"},
  {"note": "an escaped bracket is looked up as is", "method": "GET", "path": "/mockserver/dashboard/a%5Bb"},
  {"note": "a parent segment is refused before the URI is built", "method": "GET", "path": "/mockserver/dashboard/..[b"},
  {"note": "the exceptions are logged", "method": "PUT", "path": "/mockserver/retrieve?type=LOGS"}
]}
