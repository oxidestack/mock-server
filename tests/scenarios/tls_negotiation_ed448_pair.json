{
 "note": "a fixed Ed448 pair: the cipher suite (TLS 1.2: ECDHE_ECDSA in the server's order) and the ed448 signature, as the JDK picks them.",
 "properties": {
  "privateKeyPath": "{{files}}/tls/fixed-ed448-key.pem",
  "x509CertificatePath": "{{files}}/tls/fixed-ed448-cert.pem"
 },
 "steps": [
  {
   "note": "an HTTP request on each event loop",
   "method": "PUT",
   "path": "/mockserver/status"
  },
  {
   "method": "PUT",
   "path": "/mockserver/status"
  },
  {
   "method": "PUT",
   "path": "/mockserver/status"
  },
  {
   "method": "PUT",
   "path": "/mockserver/status"
  },
  {
   "method": "PUT",
   "path": "/mockserver/status"
  },
  {
   "note": "TLS 1.3",
   "tcp": [
    {
     "text": "GET /target HTTP/1.1\r\nHost: localhost:{{port}}\r\nConnection: close\r\n\r\n"
    }
   ],
   "tls": true,
   "text": true,
   "negotiated": true,
   "signatureSchemes": [
    "ED448",
    "RSA_PKCS1_SHA256"
   ]
  },
  {
   "note": "TLS 1.3, AES-256 first",
   "tcp": [
    {
     "text": "GET /target HTTP/1.1\r\nHost: localhost:{{port}}\r\nConnection: close\r\n\r\n"
    }
   ],
   "tls": true,
   "text": true,
   "negotiated": true,
   "signatureSchemes": [
    "ED448",
    "RSA_PKCS1_SHA256"
   ],
   "cipherSuites": [
    "TLS13_AES_256_GCM_SHA384",
    "TLS13_AES_128_GCM_SHA256",
    "TLS13_CHACHA20_POLY1305_SHA256"
   ]
  },
  {
   "note": "TLS 1.2",
   "tcp": [
    {
     "text": "GET /target HTTP/1.1\r\nHost: localhost:{{port}}\r\nConnection: close\r\n\r\n"
    }
   ],
   "tls": true,
   "text": true,
   "negotiated": true,
   "tls12": true,
   "signatureSchemes": [
    "ED448",
    "ECDSA_NISTP256_SHA256",
    "RSA_PKCS1_SHA256"
   ]
  },
  {
   "note": "TLS 1.2, AES-256 first",
   "tcp": [
    {
     "text": "GET /target HTTP/1.1\r\nHost: localhost:{{port}}\r\nConnection: close\r\n\r\n"
    }
   ],
   "tls": true,
   "text": true,
   "negotiated": true,
   "tls12": true,
   "signatureSchemes": [
    "ED448",
    "ECDSA_NISTP256_SHA256",
    "RSA_PKCS1_SHA256"
   ],
   "cipherSuites": [
    "TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384",
    "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256",
    "TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256",
    "TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384",
    "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256"
   ]
  }
 ]
}
