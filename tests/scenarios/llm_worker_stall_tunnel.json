{
 "source": "hand-written: a CONNECT tunnel's loopback leg is an accepted connection, which takes the worker group's next event loop and handles the tunnel's requests on it (see llm_worker_stall_semantic)",
 "peer": true,
 "properties": {
  "llmProvider": "OPENAI",
  "llmBaseUrl": "{{peerurl}}",
  "llmApiKey": "test-key",
  "llmModel": "gpt-test",
  "llmRequestTimeoutMillis": "1000",
  "llmSemanticMatchingEnabled": "true"
 },
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/reset",
   "node": "peer"
  },
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": [
    {
     "id": "yes",
     "priority": 0,
     "httpRequest": {
      "method": "POST",
      "path": "/v1/chat/completions",
      "body": {
       "type": "STRING",
       "string": "MESSAGE<<<I want my money back",
       "subString": true
      }
     },
     "httpResponse": {
      "statusCode": 200,
      "headers": {
       "content-type": [
        "application/json"
       ]
      },
      "body": "{\"id\": \"chatcmpl-1\", \"object\": \"chat.completion\", \"model\": \"gpt-4o-mini\", \"choices\": [{\"index\": 0, \"message\": {\"role\": \"assistant\", \"content\": \"  Yes, it does.\"}, \"finish_reason\": \"stop\"}], \"usage\": {\"prompt_tokens\": 10, \"completion_tokens\": 5, \"total_tokens\": 15}}"
     }
    },
    {
     "id": "no",
     "priority": -1,
     "httpRequest": {
      "method": "POST",
      "path": "/v1/chat/completions"
     },
     "httpResponse": {
      "statusCode": 200,
      "headers": {
       "content-type": [
        "application/json"
       ]
      },
      "body": "{\"id\": \"chatcmpl-1\", \"object\": \"chat.completion\", \"model\": \"gpt-4o-mini\", \"choices\": [{\"index\": 0, \"message\": {\"role\": \"assistant\", \"content\": \"no\"}, \"finish_reason\": \"stop\"}], \"usage\": {\"prompt_tokens\": 10, \"completion_tokens\": 5, \"total_tokens\": 15}}"
     }
    }
   ],
   "node": "peer"
  },
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": [
    {
     "id": "refund",
     "priority": 5,
     "httpRequest": {
      "method": "POST",
      "path": "/v1/chat/completions"
     },
     "httpLlmResponse": {
      "provider": "OPENAI",
      "conversationPredicates": {
       "semanticMatchAgainst": "the user asks for a refund"
      },
      "completion": {
       "text": "Refund issued."
      }
     }
    },
    {
     "id": "fallback",
     "httpRequest": {
      "method": "POST",
      "path": "/v1/chat/completions"
     },
     "httpResponse": {
      "statusCode": 418,
      "body": "no semantic match"
     }
    }
   ]
  },
  {
   "method": "POST",
   "path": "/v1/chat/completions",
   "headers": {
    "content-type": "application/json"
   },
   "body": {
    "model": "gpt-4o",
    "messages": [
     {
      "role": "user",
      "content": "I want my money back, order 1"
     }
    ]
   },
   "mask": [
    "\"id\" : \"[^\"]*\"",
    "\"created\" ?: ?\\d+",
    "chatcmpl-[A-Za-z0-9]+"
   ],
   "note": "the first judge call opens the pooled connection, the third registration"
  },
  {
   "method": "POST",
   "path": "/v1/chat/completions",
   "headers": {
    "content-type": "application/json"
   },
   "body": {
    "model": "gpt-4o",
    "messages": [
