    "chatcmpl-[A-Za-z0-9]+"
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=ACTIVE_EXPECTATIONS",
   "note": "no LLM call: one more connection in the worker group's turn"
  },
  {
   "method": "POST",
   "path": "/v1/chat/completions",
   "headers": {
    "content-type": "application/json"
   },
   "body": {
    "model": "gpt-4o",
    "messages": [
     {
      "role": "user",
      "content": "I want my money back, order 3"
