{
  "steps": [
    {"method": "PUT", "path": "/mockserver/expectation", "body": {"httpRequest": {"path": "/delayed"}, "httpResponse": {"body": "late", "delay": {"timeUnit": "MILLISECONDS", "value": 50}}}},
    {"method": "GET", "path": "/delayed", "minMillis": 50},
    {"method": "PUT", "path": "/mockserver/retrieve?type=REQUEST_RESPONSES", "note": "the timing block is not part of the retrieved response"},
    {"method": "PUT", "path": "/mockserver/retrieve?type=LOGS", "mask": ["(?<=\"totalTimeInMillis\" : )\\d+"], "note": "but the returning-response line carries it"}
  ]
}
