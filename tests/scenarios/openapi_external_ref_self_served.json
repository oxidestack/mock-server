{
 "steps": [
  {
   "note": "a schema document served by this same server",
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "path": "/ext/pet.json"
    },
    "httpResponse": {
     "headers": {
      "content-type": [
       "application/json"
      ]
     },
     "body": {
      "json": {
       "type": "object",
       "required": [
        "name"
       ],
       "properties": {
        "name": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  },
  {
   "note": "an inline spec whose external $ref points back at this server (swagger-parser fetches it while the PUT is handled); the generated id hashes the payload, which holds the server's own port, so it is masked",
   "method": "PUT",
   "path": "/mockserver/openapi",
   "body": {
    "specUrlOrPayload": {
     "openapi": "3.0.0",
     "info": {
      "title": "Ext",
      "version": "1"
     },
     "paths": {
      "/pets": {
       "post": {
        "operationId": "addPet",
        "requestBody": {
         "required": true,
         "content": {
          "application/json": {
           "schema": {
            "$ref": "http://localhost:{{port}}/ext/pet.json"
           }
          }
         }
        },
        "responses": {
         "200": {
          "description": "ok",
          "content": {
           "application/json": {
            "schema": {
             "$ref": "http://localhost:{{port}}/ext/pet.json"
            }
           }
          }
         }
        }
       }
      }
     }
    }
   },
   "mask": [
    "openapi:ext_[0-9a-f]{16}",
    "content-length: \\d+"
   ]
  },
  {
   "note": "a body valid against the fetched schema",
   "method": "POST",
   "path": "/pets",
   "headers": {
    "content-type": [
     "application/json"
    ]
   },
   "body": {
    "name": "rex"
   }
  },
  {
   "note": "a body the fetched schema rejects",
   "method": "POST",
   "path": "/pets",
   "headers": {
    "content-type": [
     "application/json"
    ]
   },
   "body": {
    "nome": "rex"
   }
  },
  {
   "note": "the same spec as an expectation's OpenAPI request matcher",
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "specUrlOrPayload": {
      "openapi": "3.0.0",
      "info": {
       "title": "Ext2",
       "version": "1"
      },
      "paths": {
       "/owners": {
        "post": {
         "operationId": "addOwner",
         "requestBody": {
          "required": true,
          "content": {
           "application/json": {
            "schema": {
             "$ref": "http://localhost:{{port}}/ext/pet.json"
            }
           }
          }
         },
         "responses": {
          "200": {
           "description": "ok"
          }
         }
        }
       }
      }
     }
    },
    "httpResponse": {
     "body": "owner"
    }
   }
  },
  {
   "method": "POST",
   "path": "/owners",
   "headers": {
    "content-type": [
     "application/json"
    ]
   },
   "body": {
    "name": "ann"
   }
  }
 ]
}
