   "path": "/mockserver/configuration",
   "body": {
    "maxRequestBodySize": "abc"
   }
  },
  {
   "note": "legacy alias",
   "method": "GET",
   "path": "/configuration"
  },
  {
   "note": "log",
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS",
   "body": {
    "path": "/mockserver/configuration"
   }
