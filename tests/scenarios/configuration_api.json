  {
   "note": "configuration",
   "method": "GET",
   "path": "/mockserver/configuration"
  },
  {
   "note": "set a limit",
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "maxRequestBodySize": 128,
    "corsMaxAgeInSeconds": "42",
    "unknownProperty": true
   }
  },
  {
   "note": "next response on a new connection",
   "method": "PUT",
   "path": "/mockserver/status"
  },
  {
   "note": "over the limit",
   "method": "POST",
   "path": "/body-size-probe",
   "body": ""
  },
  {
   "note": "under the limit",
   "method": "POST",
   "path": "/body-size-probe",
   "body": "small"
  },
  {
