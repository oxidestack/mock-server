{"steps": [
  {"note": "end of input inside an object", "method": "PUT", "path": "/mockserver/expectation", "body": "{\"httpRequest\": "},
  {"note": "end of input inside an array", "method": "PUT", "path": "/mockserver/expectation", "body": "[{\"httpRequest\": {}}, "},
  {"note": "end of input inside a string", "method": "PUT", "path": "/mockserver/expectation", "body": "{\"httpRequest\": {\"path\": \"/a"},
  {"note": "unrecognised token as a value", "method": "PUT", "path": "/mockserver/expectation", "body": "{\"httpRequest\": foo}"},
  {"note": "unrecognised token at the root", "method": "PUT", "path": "/mockserver/expectation", "body": "httpRequest"},
  {"note": "missing colon", "method": "PUT", "path": "/mockserver/expectation", "body": "{\"httpRequest\" {}}"},
  {"note": "missing comma between entries", "method": "PUT", "path": "/mockserver/expectation", "body": "{\"httpRequest\": {} \"httpResponse\": {}}"},
  {"note": "missing comma between array elements", "method": "PUT", "path": "/mockserver/expectation", "body": "[{} {}]"},
  {"note": "close marker mismatch", "method": "PUT", "path": "/mockserver/expectation", "body": "{\"httpRequest\": {\"path\": \"/a\"]}"},
  {"note": "a close brace at the root", "method": "PUT", "path": "/mockserver/expectation", "body": "}"},
  {"note": "a number with a bad character", "method": "PUT", "path": "/mockserver/expectation", "body": "{\"httpResponse\": {\"statusCode\": 2x0}}"},
  {"note": "a control character in a string", "method": "PUT", "path": "/mockserver/expectation", "body": "{\"httpRequest\": {\"path\": \"/a\u0001b\"}}"},
  {"note": "a bad escape is accepted leniently", "method": "PUT", "path": "/mockserver/expectation", "body": "{\"httpRequest\": {\"path\": \"/\\q\"}, \"httpResponse\": {}}"},
  {"note": "multi-line input reports the line", "method": "PUT", "path": "/mockserver/expectation", "body": "{\n  \"httpRequest\": {\n    \"path\": \"/a\",\n  ]\n}"},
  {"note": "a name that is a number", "method": "PUT", "path": "/mockserver/expectation", "body": "{1: {}}"},
  {"note": "verify with malformed json", "method": "PUT", "path": "/mockserver/verify", "body": "{\"httpRequest\": "},
  {"note": "clear with malformed json", "method": "PUT", "path": "/mockserver/clear", "body": "{\"path\": "},
  {"note": "retrieve with malformed json", "method": "PUT", "path": "/mockserver/retrieve?type=requests", "body": "{\"path\": "},
  {"note": "nothing was stored", "method": "PUT", "path": "/mockserver/retrieve?type=active_expectations"}
]}
