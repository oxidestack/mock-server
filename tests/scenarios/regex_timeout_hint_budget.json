     }
    },
    "httpResponse": {
     "body": "body"
    }
   }
  },
  {
   "note": "regex body",
   "method": "POST",
   "path": "/body",
   "body": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab",
   "maxMillis": 3000
  }
 ]
}
