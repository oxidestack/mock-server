{
 "isolated": true,
 "steps": [
  {"note": "StatefulScenarioExamples.crossProtocol: an expectation carrying crossProtocolScenarios registers them",
   "method": "PUT", "path": "/mockserver/expectation",
   "body": {"httpRequest": {"method": "GET", "path": "/w3c/events"},
            "httpResponse": {"statusCode": 200},
            "crossProtocolScenarios": [{"trigger": "HTTP_REQUEST", "scenarioName": "W3cConnFlow", "targetState": "Connected", "matchPattern": "/w3c/events"}]}},
  {"method": "PUT", "path": "/mockserver/expectation",
   "body": {"httpRequest": {"method": "GET", "path": "/w3c/conn-status"},
            "httpResponse": {"statusCode": 200, "body": "{\"status\":\"connected\"}"},
            "scenarioName": "W3cConnFlow", "scenarioState": "Connected"}},
  {"note": "a registration without a pattern fires on every HTTP_REQUEST event", "method": "PUT", "path": "/mockserver/expectation",
   "body": {"httpRequest": {"path": "/w3c/other"},
            "httpResponse": {"statusCode": 204},
            "crossProtocolScenarios": [{"trigger": "HTTP_REQUEST", "scenarioName": "W3cAny", "targetState": "Seen"}, {"trigger": "WEBSOCKET_CONNECT", "scenarioName": "W3cWs", "targetState": "Open"}]}},
  {"method": "PUT", "path": "/mockserver/expectation",
   "body": {"httpRequest": {"path": "/w3c/any-status"}, "httpResponse": {"statusCode": 200, "body": "seen"}, "scenarioName": "W3cAny", "scenarioState": "Seen"}},
  {"method": "PUT", "path": "/mockserver/retrieve?type=ACTIVE_EXPECTATIONS", "body": {"path": "/w3c/.*"}},
  {"method": "GET", "path": "/w3c/conn-status"},
  {"method": "GET", "path": "/w3c/any-status"},
  {"method": "GET", "path": "/w3c/events"},
  {"method": "GET", "path": "/w3c/conn-status"},
  {"method": "GET", "path": "/w3c/any-status"},
  {"method": "GET", "path": "/mockserver/scenario/W3cWs"},
  {"note": "clear does not unregister: the listener still fires from another matched expectation", "method": "PUT", "path": "/mockserver/clear", "body": {"path": "/w3c/events"}},
  {"method": "PUT", "path": "/mockserver/scenario/W3cConnFlow", "body": {"state": "Started"}},
  {"method": "GET", "path": "/w3c/other"},
  {"method": "GET", "path": "/w3c/conn-status"},
  {"method": "PUT", "path": "/mockserver/reset"},
  {"method": "PUT", "path": "/mockserver/expectation",
   "body": {"httpRequest": {"path": "/w3c/other"}, "httpResponse": {"statusCode": 204}, "crossProtocolScenarios": []}},
  {"method": "PUT", "path": "/mockserver/scenario/W3cConnFlow", "body": {"state": "Started"}},
  {"method": "GET", "path": "/w3c/other"},
  {"method": "GET", "path": "/mockserver/scenario/W3cConnFlow"}
 ]
}
