{
 "properties": {
  "sloTrackingEnabled": "true",
  "driftDetectionEnabled": "false"
 },
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": [
    {
     "httpRequest": {
      "path": "/ok"
     },
     "httpResponse": {
      "body": "ok"
     }
    },
    {
     "httpRequest": {
      "path": "/boom"
     },
     "httpResponse": {
      "statusCode": 503
     }
    },
    {
     "httpRequest": {
      "path": "/fwd-ok"
     },
     "httpOverrideForwardedRequest": {
      "requestOverride": {
       "path": "/ok",
       "headers": {
        "Host": [
         "localhost:{{port}}"
        ]
       }
      }
     }
    },
    {
     "httpRequest": {
      "path": "/fwd-boom"
     },
     "httpOverrideForwardedRequest": {
      "requestOverride": {
       "path": "/boom",
       "headers": {
        "Host": [
         "localhost:{{port}}"
        ]
       }
      }
     }
    }
   ]
  },
  {
   "note": "no samples",
   "method": "PUT",
   "path": "/mockserver/verifySLO",
   "body": {
    "name": "empty",
    "window": {
     "type": "LOOKBACK",
     "lookbackMillis": 60000
    },
    "objectives": [
     {
      "sli": "ERROR_RATE",
      "comparator": "LESS_THAN",
      "threshold": 0.5
     },
     {
      "sli": "LATENCY_P50",
      "comparator": "LESS_THAN",
      "threshold": 5000
     }
    ]
   },
   "mask": [
    "\"(windowFromEpochMillis|windowToEpochMillis)\" : \\d+",
    {
     "regex": "(\"observedValue\" : )[0-9.E]+(,\\n\\s+\"result\" : \"PASS\",\\n\\s+\"sli\" : \"LATENCY)",
     "replace": "${1}<latency>${2}"
    }
   ]
  },
  {
   "method": "GET",
   "path": "/fwd-ok"
  },
  {
   "method": "GET",
   "path": "/fwd-ok"
  },
  {
   "method": "GET",
   "path": "/fwd-ok"
  },
  {
   "method": "GET",
   "path": "/fwd-boom"
  },
  {
   "method": "GET",
   "path": "/ok"
  },
  {
   "note": "pass",
   "method": "PUT",
   "path": "/mockserver/verifySLO",
   "body": {
    "name": "checkout",
    "window": {
     "type": "LOOKBACK",
     "lookbackMillis": 60000
    },
    "minimumSampleCount": 2,
    "upstreamHosts": [
     "localhost"
    ],
    "objectives": [
     {
      "sli": "ERROR_RATE",
      "comparator": "LESS_THAN_OR_EQUAL",
      "threshold": 0.25
     },
     {
      "sli": "LATENCY_P95",
      "comparator": "LESS_THAN",
      "threshold": 5000,
      "scope": "FORWARD"
     }
    ]
   },
   "mask": [
    "\"(windowFromEpochMillis|windowToEpochMillis)\" : \\d+",
    {
     "regex": "(\"observedValue\" : )[0-9.E]+(,\\n\\s+\"result\" : \"PASS\",\\n\\s+\"sli\" : \"LATENCY)",
     "replace": "${1}<latency>${2}"
    },
    "content-length: \\d+"
   ]
  },
