{
 "source": "Netty's direct-memory limit (io.netty.maxDirectMemory) on a forward's gzip response: 10226 bytes on the wire that decode to 10 MiB and END, probed on the 9.2.0 oracle at an 8 MiB limit: the decompressor's output is heap memory and each raw read is released once decoded, so the limit is never met",
 "properties": {
  "logLevel": "DEBUG",
  "maxResponseBodySize": "104857600"
 },
 "jvmOptions": [
  "-Dio.netty.maxDirectMemory=8388608"
 ],
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": [
    {
     "httpRequest": {
      "path": "/dm/up"
     },
     "httpError": {
      "dropConnection": false,
      "responseBytes": ""
     }
    },
    {
     "httpRequest": {
      "path": "/dm/fwd"
     },
     "httpOverrideForwardedRequest": {
      "requestOverride": {
       "path": "/dm/up",
       "headers": {
        "Host": [
         "localhost:{{port}}"
        ]
       }
      }
     }
    },
    {
     "httpRequest": {
      "path": "/dm/echo"
     },
     "httpResponse": {
      "body": "ok"
     }
    }
   ],
   "mask": [
    "\"id\" : \"[0-9a-f-]+\""
   ]
  },
  {
   "note": "a gzip upstream response, small on the wire, 10 MiB decoded",
   "method": "GET",
   "path": "/dm/fwd",
   "maxMillis": 120000,
   "mask": [
    {
     "regex": "a{64,}",
     "replace": "<a-run>",
     "reason": "a 10 MiB run of one letter kept out of the golden; the END after it shows the body came whole (a counted repetition of thousands is too slow on 10 MB)"
    }
   ]
  },
  {
   "note": "what it logged",
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS",
   "compare": "unordered",
   "mask": [
    {
     "regex": "a{64,}",
     "replace": "<a-run>",
     "reason": "a 10 MiB run of one letter kept out of the golden; the END after it shows the body came whole (a counted repetition of thousands is too slow on 10 MB)"
    },
    {
     "regex": "id: 0x[0-9a-f]{8}",
     "replace": "id: 0x<id>",
     "reason": "Netty's random channel id"
    },
    {
     "regex": "L:/[^ \\]\"]+",
     "replace": "L:/<local>",
     "reason": "the oracle sits behind Docker's network, an address of its own"
    },
    {
     "regex": "R:[^ \\]\"]*/[^\\]\"]+",
     "replace": "R:<remote>",
     "reason": "the peer's address and port"
    },
    {
     "regex": "used: \\d+",
     "replace": "used: <used>",
     "reason": "what the pool holds at the failure depends on the sizes the socket's reads came in"
    },
    {
     "regex": "(?s)\\n[^\\n]* - streaming decision:\\n.*?\\n-{36}\\n",
     "replace": "\n",
     "reason": "the forwarding client's DEBUG `streaming decision` entry is not written yet, as in log_forward_upstream_negotiated"
    },
    {
     "regex": "(Millis\\\\?\" : )\\d+",
     "replace": "${1}0",
     "reason": "a forward's measured timing"
    }
   ]
  }
 ]
}