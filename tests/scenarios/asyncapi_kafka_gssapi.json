      "saslJaasConfig": "com.sun.security.auth.module.Krb5LoginModule required useKeyTab=true storeKey=true keyTab=\"/etc/kafka/client.keytab\" principal=\"client@EXAMPLE.COM\" serviceName=\"kafka\";"
     }
    }
