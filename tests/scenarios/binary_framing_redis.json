{
 "properties": {
  "binaryMessageFraming": "REDIS",
  "maxRequestBodySize": "16384"
 },
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "note": "BinaryMessageFramingIntegrationTest's Redis commands",
   "mask": [
    "\"id\" : \"[0-9a-f-]+\""
   ],
   "body": [
    {
     "httpRequest": {
      "binaryData": ""
     },
     "binaryResponse": {
      "binaryData": "K09LDQo="
     }
    },
    {
     "httpRequest": {
      "binaryData": "KjINCiQ0DQpJTkNSDQokNw0KY291bnRlcg0K"
     },
     "binaryResponse": {
      "binaryData": "OjENCg=="
     }
    },
    {
     "httpRequest": {
      "binaryData": "KjINCiQzDQpHRVQNCiQ3DQpjb3VudGVyDQo="
     },
     "binaryResponse": {
      "binaryData": "JDENCjENCg=="
     }
    },
    {
     "httpRequest": {
      "binaryData": "UElORw0K"
     },
     "binaryResponse": {
      "binaryData": "K1BPTkcNCg=="
     }
    }
   ]
  },
  {
   "tcp": [
    "",
    ""
   ],
   "note": "a command written in two parts with a pause is one message"
  },
  {
   "tcp": [
    "KjINCiQ0DQpJTkNSDQokNw0KY291bnRlcg0KKjINCiQzDQpHRVQNCiQ3DQpjb3VudGVyDQpQSU5HDQo="
   ],
   "note": "pipelined commands, and an inline one, one by one"
  },
  {
   "tcp": [
    "KjENCiQyMDAwMA0K"
   ],
   "note": "a bulk string over maxRequestBodySize closes the connection"
  },
  {
   "tcp": [
    "KjEK"
   ],
   "note": "a line not ended by CRLF closes the connection"
  },
  {
   "sleepMillis": 300
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS",
   "note": "the refusal's WARN",
   "mask": [
    "content-length: \\d+",
    "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)"
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/reset"
  }
 ]
}
