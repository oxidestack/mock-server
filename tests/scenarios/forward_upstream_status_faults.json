      "note": "the exchange log keeps the relayed status",
      "method": "PUT",
      "path": "/mockserver/retrieve?type=REQUEST_RESPONSES",
      "body": {
        "path": "/sf/fwd/above_u16"
      },
      "mask": [
        {
          "regex": "(x-mockserver-response-time-ms\" : \\[ \")[^\"]+",
          "replace": "${1}0"
        }
      ]
