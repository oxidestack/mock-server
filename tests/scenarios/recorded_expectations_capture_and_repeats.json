{
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/import?format=recording&redactSensitiveData=false",
   "bodyFile": "import/recording_options.ndjson",
   "note": "recording archive"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&repeatsAsScenarios=true",
   "note": "repeats as scenarios: same request, different responses"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&captureHeaders=Accept&repeatsAsScenarios=TRUE",
   "note": "captured headers decide which requests repeat"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&captureHeaders=accept",
   "note": "capture headers is case-insensitive"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&captureHeaders=",
   "note": "an empty capture list keeps no headers"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&captureHeaders=X-Trace,%20&captureHeaders=Accept",
   "note": "several values, blank names dropped"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&repeatsAsScenarios=false",
   "note": "repeats false is verbatim"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&captureHeaders=Accept&repeatsAsScenarios=true&consolidate=true",
   "note": "repeats then consolidation"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&captureHeaders=Accept&repeatsAsScenarios=true&format=JAVA",
   "note": "repeats in java"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&captureHeaders=Accept&repeatsAsScenarios=true&format=PYTHON",
   "note": "repeats in python"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&captureHeaders=Accept&repeatsAsScenarios=true&format=HAR",
   "note": "repeats in har"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&repeatsAsScenarios=true&format=LOG_ENTRIES",
   "note": "log entries are not post-processed",
   "mask": [
    "\"epochTime\" : \\d+"
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&extractBodiesLargerThan=abc",
   "note": "threshold not a number"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&extractBodiesLargerThan=-1",
   "note": "threshold negative"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&extractBodiesLargerThan=%2010%20",
   "note": "threshold without a directory"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&extractBodiesLargerThan=%20",
   "note": "blank threshold is ignored"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&extractBodiesLargerThan=abc&format=LOG_ENTRIES",
   "note": "log entries do not validate the threshold",
   "mask": [
    "\"epochTime\" : \\d+"
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&extractBodiesLargerThan=abc&format=CURL",
   "note": "curl does not validate the threshold"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&extractBodiesLargerThan=99999999999999999999",
   "note": "threshold overflowing a long"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS",
   "note": "log messages"
  }
 ]
}