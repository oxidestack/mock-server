{
 "note": "the same PKCS#12 key store without keyStorePassword under NewSunX509: no key is chosen, the server (mutual TLS) answers with a certificate_required alert, and the log shows the client reading it as SSLHandshakeException under MqttException(Connection lost, 32109)",
 "steps": [
  {
   "note": "client.p12, no password, NewSunX509, MQTT 3",
   "method": "PUT",
   "path": "/mockserver/asyncapi",
   "body": {
    "spec": {
     "asyncapi": "2.6.0",
     "info": {
      "title": "Ssl",
      "version": "1"
     },
     "channels": {
      "orders": {
       "publish": {
        "message": {
         "payload": {
          "type": "object"
         }
        }
       }
      }
     }
    },
    "brokerConfig": {
     "mqttBrokerUrl": "ssl://localhost:{{port}}",
     "publishOnLoad": false,
     "mqttSecurity": {
      "sslProperties": {
       "com.ibm.ssl.keyStore": "{{files}}/asyncapi/mqtt-ssl/client.p12",
       "com.ibm.ssl.trustStore": "{{files}}/asyncapi/mqtt-ssl/trust.jks",
       "com.ibm.ssl.trustStorePassword": "changeit",
       "com.ibm.ssl.keyManager": "NewSunX509"
      }
     }
    }
   },
   "maxMillis": 60000
  },
  {
   "note": "client.p12, no password, NewSunX509, MQTT 5",
