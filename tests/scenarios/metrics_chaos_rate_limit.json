  {"note": "chaos series after: rateLimit is not destructive, so auto-halt (threshold 1) has not fired", "method": "GET", "path": "/mockserver/metrics", "mask": [{"regex": "(?m)^(?!(# (HELP|TYPE) )?mock_server_(http_chaos_injected|chaos_auto_halt)_).*\\n", "replace": ""}, "content-length: \\d+"]},
