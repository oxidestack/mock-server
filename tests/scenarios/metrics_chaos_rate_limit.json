    {"httpRequest": {"path": "/err"}, "httpResponse": {"body": "never"}, "chaos": {"errorStatus": 503, "errorProbability": 1.0}},
    {"httpRequest": {"path": "/sse"}, "httpSseResponse": {"events": [{"data": "one"}]}, "rateLimit": {"limit": 1, "windowMillis": 600000}}
