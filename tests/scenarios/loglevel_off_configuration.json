{
 "properties": {
  "logLevel": "OFF"
 },
 "steps": [
  {
   "note": "startup logLevel OFF is reported as ERROR",
   "method": "GET",
   "path": "/mockserver/configuration"
  },
  {
   "note": "runtime INFO",
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "logLevel": "INFO"
   }
  },
  {
   "note": "runtime OFF is rejected",
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "logLevel": "OFF"
   }
  },
  {
   "method": "GET",
   "path": "/mockserver/configuration"
  }
 ]
}
