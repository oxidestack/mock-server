{
 "source": "hand-written: webhook httpRequestTemplate (upstream 6b790bfed, TemplatedWebhookIntegrationTest)",
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": [
    {
     "httpRequest": {
      "path": "/hook/.*"
     },
     "httpResponse": {
      "statusCode": 202
     }
    },
    {
     "httpRequest": {
      "path": "/velocity"
     },
     "httpResponse": {
      "body": "triggered"
     },
     "afterActions": [
      {
       "httpRequestTemplate": {
        "template": "{ \"method\": \"POST\", \"path\": \"/hook/velocity/$!request.headers['orderid'][0]\", \"headers\": [ { \"name\": \"Host\", \"values\": [ \"localhost:{{port}}\" ] }, { \"name\": \"X-Order\", \"values\": [ \"$!request.headers['orderid'][0]\" ] } ], \"body\": \"received $!request.method $!request.path with $!request.body\" }",
        "templateType": "VELOCITY"
       }
      }
     ]
    },
    {
     "httpRequest": {
      "path": "/mustache"
     },
     "httpResponse": {
      "body": "triggered"
     },
     "afterActions": [
      {
       "httpRequestTemplate": {
        "template": "{ \"method\": \"POST\", \"path\": \"/hook/mustache/{{ request.headers.orderid.0 }}\", \"headers\": [ { \"name\": \"Host\", \"values\": [ \"localhost:{{port}}\" ] }, { \"name\": \"X-Order\", \"values\": [ \"{{ request.headers.orderid.0 }}\" ] } ], \"body\": \"received {{ request.method }} {{ request.path }} with {{ request.body }}\" }",
        "templateType": "MUSTACHE"
       }
      }
     ]
    },
    {
     "httpRequest": {
      "path": "/javascript"
     },
     "httpResponse": {
      "body": "triggered"
     },
     "afterActions": [
      {
       "httpRequestTemplate": {
        "template": "return { 'method': 'POST', 'path': '/hook/javascript/' + request.headers['orderid'][0], 'headers': [ { 'name': 'Host', 'values': [ 'localhost:{{port}}' ] } ] };",
        "templateType": "JAVASCRIPT"
       }
      }
     ]
    },
    {
     "httpRequest": {
      "path": "/documented"
     },
     "httpResponse": {
      "body": "triggered"
     },
     "afterActions": [
      {
       "httpRequestTemplate": {
        "template": "{ \"method\": \"POST\", \"path\": \"/hook/orders/$!esc.url($request.headers['orderid'][0])/created\", \"headers\": { \"Host\": [ \"localhost:{{port}}\" ], \"Content-Type\": [ \"application/json\" ] }, \"body\": { \"received\": \"$!esc.java($request.body)\" } }",
        "templateType": "VELOCITY"
       }
      }
     ]
    },
    {
     "httpRequest": {
      "path": "/velocity-error"
     },
     "httpResponse": {
      "body": "triggered"
     },
     "afterActions": [
      {
       "httpRequestTemplate": {
        "template": "#if( broken",
        "templateType": "VELOCITY"
       }
      }
     ]
    },
    {
     "httpRequest": {
      "path": "/invalid"
     },
     "httpResponse": {
      "body": "triggered"
     },
     "afterActions": [
      {
       "httpRequestTemplate": {
        "template": "not a request",
        "templateType": "VELOCITY"
       }
      }
     ]
    },
    {
     "httpRequest": {
      "path": "/untyped"
     },
     "httpResponse": {
      "body": "never"
     },
     "beforeActions": [
      {
       "failurePolicy": "FAIL_FAST",
       "httpRequestTemplate": {
        "template": "{ \"path\": \"/hook/untyped\", \"headers\": { \"Host\": [ \"localhost:{{port}}\" ] } }"
       }
      }
     ]
    },
    {
     "httpRequest": {
      "path": "/before"
     },
     "httpResponse": {
      "body": "triggered"
     },
     "beforeActions": [
      {
       "failurePolicy": "FAIL_FAST",
       "httpRequestTemplate": {
        "template": "{ \"method\": \"PUT\", \"path\": \"/hook/before/$!request.headers['orderid'][0]\", \"headers\": [ { \"name\": \"Host\", \"values\": [ \"localhost:{{port}}\" ] }, { \"name\": \"X-Order\", \"values\": [ \"$!request.headers['orderid'][0]\" ] } ] }",
        "templateType": "VELOCITY"
       }
      }
     ]
    },
    {
     "httpRequest": {
      "path": "/before-invalid"
     },
     "httpResponse": {
      "body": "never"
     },
     "beforeActions": [
      {
       "failurePolicy": "FAIL_FAST",
       "httpRequestTemplate": {
        "template": "not a request",
        "templateType": "VELOCITY"
       }
      }
     ]
    },
    {
     "httpRequest": {
      "path": "/before-best"
     },
     "httpResponse": {
      "body": "served anyway"
     },
     "beforeActions": [
      {
       "httpRequestTemplate": {
        "template": "{{#broken}}",
        "templateType": "MUSTACHE"
       }
      }
     ]
    },
    {
     "httpRequest": {
      "path": "/before-javascript"
     },
     "httpResponse": {
      "body": "never"
     },
     "beforeActions": [
      {
       "failurePolicy": "FAIL_FAST",
       "httpRequestTemplate": {
        "template": "return { 'method': 'POST', 'path': '/hook/javascript/' + request.headers['orderid'][0], 'headers': [ { 'name': 'Host', 'values': [ 'localhost:{{port}}' ] } ] };",
        "templateType": "JAVASCRIPT"
       }
      }
     ]
    },
    {
     "httpRequest": {
      "path": "/before-async"
     },
     "httpResponse": {
      "body": "triggered"
     },
     "beforeActions": [
      {
       "blocking": false,
       "httpRequestTemplate": {
        "template": "{ \"method\": \"POST\", \"path\": \"/hook/before-async/$!request.headers['orderid'][0]\", \"headers\": [ { \"name\": \"Host\", \"values\": [ \"localhost:{{port}}\" ] }, { \"name\": \"X-Order\", \"values\": [ \"$!request.headers['orderid'][0]\" ] } ], \"body\": \"received $!request.method $!request.path with $!request.body\" }",
        "templateType": "VELOCITY"
       }
      }
     ]
    }
   ],
   "mask": [
    "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=ACTIVE_EXPECTATIONS",
   "body": {
    "path": "/velocity"
   },
   "note": "the template echoes like an httpTemplate"
  },
  {
