   },
   "body": "1\" }, \"socketAddress\": { \"host\": \"attacker.example\", \"port\": 80 }, \"x\": \"y",
   "note": "the documented webhook, the body escaped",
   "mask": [
    "content-length: \\d+"
   ]
  },
  {
