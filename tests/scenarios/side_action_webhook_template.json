   "path": "/mockserver/verify",
   "body": {
    "httpRequest": {
     "path": "/hook/orders/A-1/created"
    },
    "times": {
     "atLeast": 1
    }
   },
   "pollUntil": "^$",
   "note": "the webhook has arrived"
  },
  {
   "wsOpen": "ui",
   "path": "/_mockserver_ui_websocket",
   "note": "the dashboard socket: its pushes show the fire-and-forget webhooks' failures without logging anything (a LOGS poll logs a RETRIEVED entry its own filter and the next read's match)"
  },
  {
   "wsDrain": "ui",
   "note": "the first frame, which the oracle sends late or not at all"
  },
  {
   "method": "POST",
   "path": "/javascript",
   "headers": {
    "orderid": "A-1"
   },
   "body": "order body",
   "note": "JavaScript after-action: no GraalJS",
   "mask": [
    "content-length: \\d+"
   ]
  },
  {
   "wsDrain": "ui",
   "until": "JAVASCRIPT webhook template failed",
   "waitMillis": 30000,
   "note": "waits for the push of /javascript's fire-and-forget webhook failure WARN"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES",
   "body": {
    "path": "/javascript"
   },
   "note": "log of /javascript, once the fire-and-forget webhook has failed (read here, so the next request's entries come after)",
   "mask": [
    "(?s)\"stackTrace\" : \\[.*?\\]",
    "\"epochTime\" : \\d+",
    "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)",
    "content-length: \\d+"
   ]
  },
