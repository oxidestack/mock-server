{
 "source": "upstream #119 (20da80972) at 9.2.0. The Kafka JAAS configuration comes only from the startup property asyncKafkaSaslJaasConfig, a SASL_* request may only use the startup asyncKafkaBootstrapServers (omitted, or the same set of host:port values), and PUT /mockserver/configuration ignores both with an init-only WARN. GET /mockserver/config shows the JAAS configuration redacted.",
 "properties": {
  "asyncKafkaBootstrapServers": "{{deadhost}}",
  "asyncKafkaSaslJaasConfig": "shaded_package.org.apache.kafka.common.security.plain.PlainLoginModule required username=\"startup-user\" password=\"startup-secret\";"
 },
 "isolated": true,
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/reset"
  },
  {
   "method": "PUT",
   "path": "/mockserver/asyncapi",
   "body": {
    "spec": {
     "asyncapi": "2.6.0",
     "info": {
      "title": "Startup JAAS"
     },
     "channels": {
      "orders": {
       "publish": {
        "message": {
         "payload": {
          "type": "object"
         }
        }
       }
      }
     }
    },
    "brokerConfig": {
     "publishOnLoad": false,
     "kafkaSecurity": {
      "securityProtocol": "SASL_PLAINTEXT",
      "saslMechanism": "PLAIN"
     }
    }
   },
   "note": "SASL with the startup JAAS, the startup brokers by omission: the producer is built"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES",
   "note": "the log: SASL with the startup JAAS",
   "mask": [
    "(?s)\"stackTrace\" : \\[.*?\\]",
    "\"epochTime\" : \\d+",
    "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)",
    "content-length: \\d+",
    {
     "regex": "\"content-length\" : \\[\\s*\"\\d+\"\\s*\\]",
     "reason": "the logged request's length varies with the dead host's port"
    },
    {
     "regex": "\\n\\s*\"port\" : (<port>|\\d+),",
     "replace": ""
    }
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/reset"
  },
  {
   "method": "PUT",
   "path": "/mockserver/asyncapi",
   "body": {
    "spec": {
