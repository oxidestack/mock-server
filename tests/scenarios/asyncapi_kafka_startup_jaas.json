   "note": "PUT /mockserver/configuration supplies both: neither is applied nor shown",
   "mask": [
    {
     "regex": "(?s)^.*?(\"asyncAmqpUri\".*?\"asyncRecordedMessageMaxEntries\" : \\d+,).*$",
     "replace": "$1",
     "reason": "only the asyncapi properties: the rest of the 9.2.0 configuration surface is not compared here"
    }
