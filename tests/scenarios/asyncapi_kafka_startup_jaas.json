        "message": {
         "payload": {
          "type": "object"
         }
        }
       }
      }
     }
    },
    "brokerConfig": {
     "kafkaBootstrapServers": " {{deadhost}} ,",
     "publishOnLoad": false,
     "kafkaSecurity": {
      "securityProtocol": "sasl_plaintext",
      "saslMechanism": "PLAIN"
     }
    }
   },
   "note": "the startup brokers repeated (blank entries, spaces) and a lower-case protocol: the producer is built"
  },
