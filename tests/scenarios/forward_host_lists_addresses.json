{
 "properties": {
  "forwardProxyAllowedHosts": "localhost, 127.0.0.0/8 ,8.8.8.8",
  "forwardProxyDeniedHosts": "127.0.0.2,192.0.2.0/24",
  "socketConnectionTimeoutInMillis": "500"
 },
 "steps": [
  {
   "note": "allow and deny lists with address entries: every target is resolved and checked",
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": [
    {
     "httpRequest": {
      "path": "/f/loopback"
     },
     "httpForward": {
      "host": "127.0.0.1",
      "port": "{{deadport}}"
     }
    },
    {
     "httpRequest": {
      "path": "/f/localhost"
     },
     "httpForward": {
      "host": "localhost",
      "port": "{{deadport}}"
     }
    },
    {
     "httpRequest": {
      "path": "/f/denied"
     },
     "httpForward": {
      "host": "127.0.0.2",
      "port": "{{deadport}}"
     }
    },
    {
     "httpRequest": {
      "path": "/f/unlisted"
     },
     "httpForward": {
      "host": "10.0.0.1",
      "port": 9
     }
    },
    {
     "httpRequest": {
      "path": "/f/mapped"
     },
     "httpForward": {
      "host": "::ffff:192.0.2.7",
      "port": 80
     }
    },
    {
     "httpRequest": {
      "path": "/f/wildcard"
     },
     "httpForward": {
      "host": "0.0.0.0",
      "port": "{{deadport}}"
     }
    },
    {
     "httpRequest": {
      "path": "/f/unresolvable"
     },
     "httpForward": {
      "host": "no-such-host-0851.invalid",
      "port": 80
     }
    },
    {
     "httpRequest": {
      "path": "/hook/0"
     },
     "httpResponse": {
      "statusCode": 200,
      "body": "hooked"
     },
     "afterActions": [
      {
       "httpRequest": {
        "path": "/hooked",
        "headers": {
         "Host": [
          "10.0.0.1:9"
         ]
        }
       }
      }
     ]
    },
    {
     "httpRequest": {
      "path": "/hook/1"
     },
     "httpResponse": {
      "statusCode": 200,
      "body": "hooked"
     },
     "afterActions": [
      {
       "httpRequest": {
        "path": "/hooked",
        "headers": {
         "Host": [
          "127.0.0.2:80"
         ]
        }
       }
      }
     ]
    }
   ],
   "mask": [
    "\"id\" : \"[0-9a-f-]+\""
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/clear?type=LOG"
  },
  {
   "note": "httpForward to 127.0.0.1: allowed by its CIDR block, refused by the dead port",
   "method": "GET",
   "path": "/f/loopback"
  },
  {
   "note": "httpForward to localhost: allowed by name",
   "method": "GET",
   "path": "/f/localhost"
  },
  {
   "note": "httpForward to 127.0.0.2: denied, deny wins over the allowed block",
   "method": "GET",
   "path": "/f/denied"
  },
  {
   "note": "httpForward to 10.0.0.1: not in the allow list",
   "method": "GET",
   "path": "/f/unlisted"
  },
  {
   "note": "httpForward to ::ffff:192.0.2.7: an IPv4-mapped address matched as IPv4, named with its address",
   "method": "GET",
   "path": "/f/mapped"
  },
  {
   "note": "httpForward to 0.0.0.0: not listed",
   "method": "GET",
   "path": "/f/wildcard"
  },
  {
   "note": "httpForward to no-such-host-0851.invalid: a name looked up for the address entries",
   "method": "GET",
   "path": "/f/unresolvable"
  },
  {
   "note": "the forward refusals",
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS",
   "body": {
    "path": "/f/.*"
   },
   "mask": [
    "^content-length: \\d+$"
   ],
   "compare": "unordered"
  },
  {
   "method": "PUT",
   "path": "/mockserver/clear?type=LOG"
  },
  {
   "note": "an upgrade relayed to 127.0.0.1: allowed by its CIDR block, refused by the dead port",
   "method": "GET",
   "path": "/f/loopback",
   "headers": {
    "Upgrade": "websocket",
    "Connection": "Upgrade",
    "Sec-WebSocket-Key": "dGhlIHNhbXBsZSBub25jZQ==",
    "Sec-WebSocket-Version": "13"
   },
   "mask": [
    {
     "regex": "(unable to connect to upstream WebSocket server [^ ]+) - .*",
     "replace": "$1 - <connect failure>",
     "reason": "the OS connect error text differs between the oracle's JVM and ours"
    }
   ]
  },
  {
   "note": "an upgrade relayed to localhost: allowed by name",
   "method": "GET",
   "path": "/f/localhost",
   "headers": {
    "Upgrade": "websocket",
    "Connection": "Upgrade",
    "Sec-WebSocket-Key": "dGhlIHNhbXBsZSBub25jZQ==",
    "Sec-WebSocket-Version": "13"
   },
   "mask": [
    {
     "regex": "(unable to connect to upstream WebSocket server [^ ]+) - .*",
     "replace": "$1 - <connect failure>",
     "reason": "the OS connect error text differs between the oracle's JVM and ours"
    }
   ]
  },
  {
   "note": "an upgrade relayed to 127.0.0.2: denied, deny wins over the allowed block",
   "method": "GET",
   "path": "/f/denied",
   "headers": {
    "Upgrade": "websocket",
    "Connection": "Upgrade",
    "Sec-WebSocket-Key": "dGhlIHNhbXBsZSBub25jZQ==",
    "Sec-WebSocket-Version": "13"
   },
   "mask": [
    {
     "regex": "(unable to connect to upstream WebSocket server [^ ]+) - .*",
     "replace": "$1 - <connect failure>",
     "reason": "the OS connect error text differs between the oracle's JVM and ours"
    }
   ]
  },
  {
   "note": "an upgrade relayed to 10.0.0.1: not in the allow list",
   "method": "GET",
   "path": "/f/unlisted",
   "headers": {
    "Upgrade": "websocket",
    "Connection": "Upgrade",
    "Sec-WebSocket-Key": "dGhlIHNhbXBsZSBub25jZQ==",
    "Sec-WebSocket-Version": "13"
   },
   "mask": [
    {
     "regex": "(unable to connect to upstream WebSocket server [^ ]+) - .*",
     "replace": "$1 - <connect failure>",
     "reason": "the OS connect error text differs between the oracle's JVM and ours"
    }
   ]
  },
  {
   "note": "an upgrade relayed to ::ffff:192.0.2.7: an IPv4-mapped address matched as IPv4, named with its address",
   "method": "GET",
   "path": "/f/mapped",
   "headers": {
    "Upgrade": "websocket",
    "Connection": "Upgrade",
    "Sec-WebSocket-Key": "dGhlIHNhbXBsZSBub25jZQ==",
    "Sec-WebSocket-Version": "13"
   },
   "mask": [
    {
     "regex": "(unable to connect to upstream WebSocket server [^ ]+) - .*",
     "replace": "$1 - <connect failure>",
     "reason": "the OS connect error text differs between the oracle's JVM and ours"
    }
   ]
  },
  {
   "note": "an upgrade relayed to 0.0.0.0: not listed",
   "method": "GET",
   "path": "/f/wildcard",
   "headers": {
    "Upgrade": "websocket",
    "Connection": "Upgrade",
    "Sec-WebSocket-Key": "dGhlIHNhbXBsZSBub25jZQ==",
    "Sec-WebSocket-Version": "13"
   },
   "mask": [
    {
     "regex": "(unable to connect to upstream WebSocket server [^ ]+) - .*",
     "replace": "$1 - <connect failure>",
     "reason": "the OS connect error text differs between the oracle's JVM and ours"
    }
   ]
  },
  {
   "note": "an upgrade relayed to no-such-host-0851.invalid: a name looked up for the address entries",
   "method": "GET",
   "path": "/f/unresolvable",
   "headers": {
    "Upgrade": "websocket",
    "Connection": "Upgrade",
    "Sec-WebSocket-Key": "dGhlIHNhbXBsZSBub25jZQ==",
    "Sec-WebSocket-Version": "13"
   },
   "mask": [
    {
     "regex": "(unable to connect to upstream WebSocket server [^ ]+) - .*",
     "replace": "$1 - <connect failure>",
     "reason": "the OS connect error text differs between the oracle's JVM and ours"
    }
   ]
  },
  {
   "note": "unmatched, proxied to Host {{deadhost}}",
   "method": "GET",
   "path": "/proxied",
   "headers": {
    "Host": "{{deadhost}}"
   }
  },
  {
   "note": "unmatched, proxied to Host 10.0.0.1:9",
   "method": "GET",
   "path": "/proxied",
   "headers": {
    "Host": "10.0.0.1:9"
   }
  },
  {
   "note": "unmatched, proxied to Host 127.0.0.2:80",
   "method": "GET",
   "path": "/proxied",
   "headers": {
    "Host": "127.0.0.2:80"
   }
  },
  {
   "note": "replay to Host {{deadhost}}",
   "method": "PUT",
   "path": "/mockserver/replay",
   "body": {
    "path": "/replayed",
    "headers": {
     "Host": [
      "{{deadhost}}"
     ]
    }
   }
  },
  {
   "note": "replay to Host 10.0.0.1:9",
   "method": "PUT",
   "path": "/mockserver/replay",
   "body": {
    "path": "/replayed",
    "headers": {
     "Host": [
      "10.0.0.1:9"
     ]
    }
   }
  },
  {
   "note": "replay to Host 127.0.0.2",
   "method": "PUT",
   "path": "/mockserver/replay",
   "body": {
    "path": "/replayed",
    "headers": {
     "Host": [
      "127.0.0.2"
     ]
    }
   }
  },
  {
   "note": "an after-action webhook to Host 10.0.0.1:9",
   "method": "GET",
   "path": "/hook/0"
  },
  {
   "note": "an after-action webhook to Host 127.0.0.2:80",
   "method": "GET",
   "path": "/hook/1"
  },
  {
   "note": "the webhooks are sent after the response",
   "sleepMillis": 1500
  },
  {
   "note": "the relay, proxy, replay and webhook refusals",
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS&format=JSON",
   "mask": [
    "^content-length: \\d+$"
   ],
   "compare": "unordered"
  }
 ]
}
