{"steps": [
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"id": "ip-any-v4", "httpRequest": {"path": "/ip/any", "clientIp": "0.0.0.0/0"}, "httpResponse": {"body": "any ipv4"}}, "note": "IPv4 CIDR matching every IPv4 peer"},
  {"method": "GET", "path": "/ip/any", "note": "the peer is in 0.0.0.0/0"},
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"id": "ip-not-v4", "httpRequest": {"path": "/ip/not", "clientIp": "!0.0.0.0/0"}, "httpResponse": {"body": "never"}}, "note": "negated with !"},
  {"method": "GET", "path": "/ip/not", "note": "a negated range containing the peer does not match"},
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"id": "ip-v6-all", "httpRequest": {"path": "/ip/v6", "clientIp": "::/0"}, "httpResponse": {"body": "ipv6 range"}}, "note": "IPv6 range"},
  {"method": "GET", "path": "/ip/v6", "note": "an IPv4 peer meets an IPv6 range as ::ffff:a.b.c.d"},
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"id": "ip-v6-doc", "httpRequest": {"path": "/ip/doc", "clientIp": "[2001:db8::]/32"}, "httpResponse": {"body": "never"}}, "note": "bracketed IPv6 range"},
  {"method": "GET", "path": "/ip/doc", "note": "an IPv4 peer is outside 2001:db8::/32"},
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"id": "ip-mapped-not", "httpRequest": {"path": "/ip/mapped", "clientIp": {"not": true, "value": "::ffff:0.0.0.0/96"}}, "httpResponse": {"body": "never"}}, "note": "object form, IPv4-mapped range"},
  {"method": "GET", "path": "/ip/mapped", "note": "the mapped range covers every IPv4 peer, negated it matches none"},
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"id": "ip-not-false", "httpRequest": {"path": "/ip/plain", "clientIp": {"not": false, "value": " 0.0.0.0/0 "}}, "httpResponse": {"body": "plain"}}, "note": "object form, not false, padded value"},
  {"method": "GET", "path": "/ip/plain"},
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"httpRequest": {"path": "/ip/bad", "clientIp": "10.0.0.0/33"}, "httpResponse": {"statusCode": 200}}, "note": "prefix too long"},
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"httpRequest": {"path": "/ip/bad", "clientIp": "::/129"}, "httpResponse": {"statusCode": 200}}, "note": "IPv6 prefix too long"},
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"httpRequest": {"path": "/ip/bad", "clientIp": "10.0.0.0/x"}, "httpResponse": {"statusCode": 200}}, "note": "prefix not a number"},
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"httpRequest": {"path": "/ip/bad", "clientIp": "localhost"}, "httpResponse": {"statusCode": 200}}, "note": "host name"},
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"httpRequest": {"path": "/ip/bad", "clientIp": ""}, "httpResponse": {"statusCode": 200}}, "note": "empty"},
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"httpRequest": {"path": "/ip/bad", "clientIp": "?10.0.0.1"}, "httpResponse": {"statusCode": 200}}, "note": "optional marker"},
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"httpRequest": {"path": "/ip/bad", "clientIp": "300.1.1.1"}, "httpResponse": {"statusCode": 200}}, "note": "IPv4 word out of range"},
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"httpRequest": {"path": "/ip/bad", "clientIp": {"value": "10.0.0.0/8", "optional": true}}, "httpResponse": {"statusCode": 200}}, "note": "schema refuses other object keys"},
  {"method": "PUT", "path": "/mockserver/expectation", "body": [{"httpRequest": {"path": "/ip/batch", "clientIp": "010.0.0.1"}, "httpResponse": {"statusCode": 200}}, {"httpRequest": {"path": "/ip/batch", "clientIp": "1.2.3"}, "httpResponse": {"statusCode": 200}}], "note": "an array: leading zeros are fine, a three-word address is not"},
  {"method": "PUT", "path": "/mockserver/retrieve?type=ACTIVE_EXPECTATIONS", "note": "echo forms"},
  {"method": "PUT", "path": "/mockserver/retrieve?type=ACTIVE_EXPECTATIONS&format=java", "note": "Java code"},
  {"method": "PUT", "path": "/mockserver/debugMismatch", "body": {"path": "/ip/not"}, "note": "a definition has no peer address", "compare": "json", "mask": ["\\d{4}-\\d{2}-\\d{2}T[0-9:.]+Z"]},
  {"method": "PUT", "path": "/mockserver/retrieve?type=REQUESTS", "body": {"path": "/ip/any", "clientIp": "0.0.0.0/0"}, "note": "filter on recorded requests"},
  {"method": "PUT", "path": "/mockserver/retrieve?type=REQUESTS", "body": {"path": "/ip/any", "clientIp": "!0.0.0.0/0"}, "note": "negated filter"},
  {"method": "PUT", "path": "/mockserver/verify", "body": {"httpRequest": {"path": "/ip/v6", "clientIp": "::/0"}, "times": {"atLeast": 1, "atMost": 1}}, "note": "verify by client ip"},
  {"method": "PUT", "path": "/mockserver/verify", "body": {"httpRequest": {"path": "/ip/v6", "clientIp": "bad"}, "times": {"atLeast": 1}}, "note": "verify with an invalid client ip"},
  {"method": "PUT", "path": "/mockserver/retrieve?type=REQUESTS", "body": {"clientIp": "10.0.0.0/33"}, "note": "retrieve with an invalid client ip"},
  {"method": "PUT", "path": "/mockserver/clear", "body": {"clientIp": "10.0.0.0/33"}, "note": "clear with an invalid client ip"},
  {"method": "PUT", "path": "/mockserver/lint", "body": [{"httpRequest": {"path": "/ip/lint"}, "httpResponse": {"body": "a"}}, {"httpRequest": {"path": "/ip/lint", "clientIp": "10.0.0.0/8"}, "httpResponse": {"body": "b"}}, {"httpRequest": {"path": "/ip/lint2", "clientIp": "10.0.0.0/8"}, "httpResponse": {"body": "c"}}, {"httpRequest": {"path": "/ip/lint2", "clientIp": "10.0.0.0/16"}, "httpResponse": {"body": "d"}}], "note": "shadowing considers clientIp"}
]}
