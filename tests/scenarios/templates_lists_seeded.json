{
 "source": "lists.pickRandom seeded by templateFakerSeed, per engine",
 "properties": {
  "templateFakerSeed": "4242"
 },
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/reset"
  },
  {
