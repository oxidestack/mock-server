    "httpResponseTemplate": {
     "templateType": "VELOCITY",
     "template": "{\n    'statusCode': 200,\n    'body': \"v=$lists.pickRandom('a','b','c','d','e','f','g','h') $lists.pickRandom('a','b','c','d','e','f','g','h') $lists.pickRandom(['a','b','c','d','e','f','g','h']) $lists.pickRandom($lists.range(1, 1000))\"\n}"
    }
   }
  },
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "path": "/t3"
    },
    "httpResponseTemplate": {
     "templateType": "MUSTACHE",
     "template": "{\n    \"statusCode\": 200,\n    \"body\": \"m={{#lists.pickRandom}}a|b|c|d|e|f|g|h{{/lists.pickRandom}} {{#lists.pickRandom}}a|b|c|d|e|f|g|h{{/lists.pickRandom}}\"\n}"
    }
   }
  },
  {
   "method": "GET",
   "path": "/t0",
