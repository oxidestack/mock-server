{
 "properties": {
  "logLevel": "INFO"
 },
 "steps": [
  {
   "note": "defaults of a fresh server",
   "method": "GET",
   "path": "/mockserver/configuration"
  },
  {
   "note": "flip every safe boolean",
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "assumeAllRequestsAreHttp": true,
    "attachMismatchDiagnosticToResponse": true,
    "attemptToProxyIfNoMatchingExpectation": false,
    "chaosAutoHaltEnabled": true,
    "closestMatchHintEnabled": false,
    "clusterSharedTimesEnabled": false,
    "clusterVerifyFanIn": true,
    "compactLogFormat": true,
    "connectionLifecycleAutoHaltCountsRst": false,
    "connectionLifecycleChaosEnabled": false,
    "controlPlaneAuditEnabled": true,
    "controlPlaneAuditReads": true,
    "dashboardAnalyticsEnabled": false,
    "deduplicateRecordedExpectations": true,
    "detailedMatchFailures": false,
    "detailedVerificationFailures": false,
    "driftAlertWebhookEnabled": true,
    "driftDetectionEnabled": false,
    "driftSemanticAnalysisEnabled": true,
    "enforceResponseValidationForMocks": true,
    "failOnInitializationError": true,
    "failVerificationOnEvictedLog": false,
    "forwardAdjustHostHeader": false,
    "forwardBinaryRequestsWithoutWaitingForResponse": true,
    "forwardConnectionPoolEnabled": false,
    "forwardConnectionPoolKeepAlive": true,
    "forwardProxyCircuitBreakerEnabled": true,
    "forwardProxyHttp2Enabled": true,
    "forwardProxyHttp2Upgrade": true,
    "forwardProxyTLSHostnameVerificationEnabled": false,
    "forwardSocketKeepAlive": false,
    "generateRealisticExampleValues": true,
    "grpcBidiStreamingEnabled": true,
    "http3AdvertiseAltSvc": false,
    "llmInferUsageEnabled": true,
    "llmSemanticMatchingEnabled": true,
    "llmVcrStrict": true,
    "loadGenerationSuppressEventLog": false,
    "matchExactCase": true,
    "matchersFailFast": false,
    "metricsRequestDurationRouteLabels": true,
    "openAPIResponseValidation": true,
    "otelGenerateTraceId": true,
    "otelPropagateTraceContext": true,
    "perExpectationMetricsEnabled": true,
    "redactSecretsInLog": true,
    "redactSecretsInRecordedExpectations": true,
    "streamingResponsesEnabled": false,
    "templatizeRecordedValues": true,
    "useSemicolonAsQueryParameterSeparator": false,
    "validateProxyEnforce": true,
    "validateRequestsAgainstOpenApiSpec": true,
    "velocityDisallowClassLoading": false
   }
  },
  {
   "note": "flip them back as upper-case text (Jackson accepts true/True/TRUE)",
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "assumeAllRequestsAreHttp": "FALSE",
    "attachMismatchDiagnosticToResponse": "FALSE",
    "attemptToProxyIfNoMatchingExpectation": "TRUE",
    "chaosAutoHaltEnabled": "FALSE",
    "closestMatchHintEnabled": "TRUE",
    "clusterSharedTimesEnabled": "TRUE",
    "clusterVerifyFanIn": "FALSE",
    "compactLogFormat": "FALSE",
    "connectionLifecycleAutoHaltCountsRst": "TRUE",
    "connectionLifecycleChaosEnabled": "TRUE",
    "controlPlaneAuditEnabled": "FALSE",
    "controlPlaneAuditReads": "FALSE",
    "dashboardAnalyticsEnabled": "TRUE",
    "deduplicateRecordedExpectations": "FALSE",
    "detailedMatchFailures": "TRUE",
    "detailedVerificationFailures": "TRUE",
    "driftAlertWebhookEnabled": "FALSE",
    "driftDetectionEnabled": "TRUE",
    "driftSemanticAnalysisEnabled": "FALSE",
    "enforceResponseValidationForMocks": "FALSE",
    "failOnInitializationError": "FALSE",
    "failVerificationOnEvictedLog": "TRUE",
    "forwardAdjustHostHeader": "TRUE",
    "forwardBinaryRequestsWithoutWaitingForResponse": "FALSE",
    "forwardConnectionPoolEnabled": "TRUE",
    "forwardConnectionPoolKeepAlive": "FALSE",
    "forwardProxyCircuitBreakerEnabled": "FALSE",
    "forwardProxyHttp2Enabled": "FALSE",
    "forwardProxyHttp2Upgrade": "FALSE",
    "forwardProxyTLSHostnameVerificationEnabled": "TRUE",
    "forwardSocketKeepAlive": "TRUE",
    "generateRealisticExampleValues": "FALSE",
    "grpcBidiStreamingEnabled": "FALSE",
    "http3AdvertiseAltSvc": "TRUE",
    "llmInferUsageEnabled": "FALSE",
    "llmSemanticMatchingEnabled": "FALSE",
    "llmVcrStrict": "FALSE",
    "loadGenerationSuppressEventLog": "TRUE",
    "matchExactCase": "FALSE",
    "matchersFailFast": "TRUE",
    "metricsRequestDurationRouteLabels": "FALSE",
    "openAPIResponseValidation": "FALSE",
    "otelGenerateTraceId": "FALSE",
    "otelPropagateTraceContext": "FALSE",
    "perExpectationMetricsEnabled": "FALSE",
    "redactSecretsInLog": "FALSE",
    "redactSecretsInRecordedExpectations": "FALSE",
    "streamingResponsesEnabled": "TRUE",
    "templatizeRecordedValues": "FALSE",
    "useSemicolonAsQueryParameterSeparator": "TRUE",
    "validateProxyEnforce": "FALSE",
    "validateRequestsAgainstOpenApiSpec": "FALSE",
    "velocityDisallowClassLoading": "TRUE"
   }
  },
  {
   "note": "a whole number is a boolean: nonzero is true, zero false",
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "detailedMatchFailures": 1,
    "compactLogFormat": 0,
    "matchExactCase": 2,
    "closestMatchHintEnabled": -1,
    "failOnInitializationError": 0
   }
  },
  {
   "note": "text boolean, lower case",
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "templatizeRecordedValues": "true",
    "deduplicateRecordedExpectations": "false"
   }
  },
  {
   "note": "null and blank leave the property alone",
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "detailedMatchFailures": null,
    "compactLogFormat": "",
    "matchExactCase": " ",
    "closestMatchHintEnabled": null
   }
  },
  {
   "note": "boolean refused: \"yes\"",
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "detailedMatchFailures": "yes"
   }
  },
  {
   "note": "boolean refused: \"t\"",
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "detailedMatchFailures": "t"
   }
  },
  {
   "note": "boolean refused: \"1\"",
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "detailedMatchFailures": "1"
   }
  },
  {
   "note": "boolean refused: \"0\"",
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "detailedMatchFailures": "0"
   }
  },
  {
   "note": "boolean refused: 1.0",
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "detailedMatchFailures": 1.0
   }
  },
  {
   "note": "boolean refused: 0.5",
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "detailedMatchFailures": 0.5
   }
  },
  {
   "note": "boolean refused: [true]",
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "detailedMatchFailures": [
     true
    ]
   }
  },
  {
   "note": "boolean refused: {\"a\": 1}",
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "detailedMatchFailures": {
     "a": 1
    }
   }
  },
  {
   "note": "boolean refused: \"tRuE\"",
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "detailedMatchFailures": "tRuE"
   }
  },
  {
   "note": "dashboard analytics round trip (ConfigurationDTOTest)",
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "dashboardAnalyticsEnabled": false,
    "dashboardAnalyticsEndpoint": "https://analytics.example.com",
    "dashboardAnalyticsKey": "phc_test_key",
    "dashboardAnalyticsDistribution": "docker"
   }
  },
  {
   "note": "every boolean as left",
   "method": "GET",
   "path": "/mockserver/configuration"
  }
 ]
}
