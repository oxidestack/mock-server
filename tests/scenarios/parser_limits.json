{
 "properties": {
  "maxHeaderSize": "1024",
  "maxInitialLineLength": "250"
 },
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "path": "/limits",
     "headers": {
      "X-Marker": [
       "present"
      ]
     }
    },
    "httpResponse": {
     "body": "marker-seen"
    }
   }
  },
  {
   "method": "GET",
   "path": "/limits",
   "headers": {
    "X-Marker": "present"
   },
   "note": "under the limits"
  },
  {
   "method": "GET",
   "path": "/limits",
   "headers": {
    "X-Filler": "",
    "X-Marker": "present"
   },
   "note": "headers beyond maxHeaderSize"
  },
  {
   "method": "GET",
   "path": "/limits?",
   "headers": {
    "X-Marker": "present"
   },
   "note": "request line beyond maxInitialLineLength"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=REQUESTS",
   "note": "what was recorded"
  }
 ]
}
