    {
      "method": "PUT",
      "path": "/mockserver/reset"
    },
    {
      "note": "an EC JWK whose d is not the private key of x/y is accepted; the JWKS publishes the JWK's own x/y",
      "method": "PUT",
      "path": "/mockserver/oidc",
