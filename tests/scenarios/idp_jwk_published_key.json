        "jwkJson": "{\"kty\": \"EC\", \"crv\": \"P-256\", \"kid\": \"ec-mismatch\", \"x\": \"X2erNvG54_uMGQcL_VJsJ7XWRBcpcvpvqYwE8Tl0P1Q\", \"y\": \"9t6-IH2qWTU_HHahkb8umi_q27HdgwK9WLDUB-8DBrI\", \"d\": \"6hcZLqQh8DUZXEHEtCi0mVvyQi6jtRuUtJ79ZmbVJUk\"}",
