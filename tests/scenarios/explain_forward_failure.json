{
 "steps": [
  {"note": "a forward to a port nothing listens on", "method": "PUT", "path": "/mockserver/expectation", "body": {"id": "ff-forward", "httpRequest": {"path": "/ff"}, "httpForward": {"host": "localhost", "port": "{{deadport}}"}}, "mask": ["content-length: \\d+"]},
  {"note": "its forward fails: 502", "method": "GET", "path": "/ff"},
  {"note": "a genuine miss", "method": "GET", "path": "/ff-miss"},
  {"note": "a request for a foreign host is proxied without an expectation, and fails", "method": "GET", "path": "/ff-proxy", "headers": {"Host": "{{deadhost}}"}},
  {"note": "failed forwards are kept out: only the genuine miss", "method": "PUT", "path": "/mockserver/explainUnmatched", "compare": "json", "mask": ["\\d{4}-\\d\\d-\\d\\dT[0-9:.]+Z", "\\d{4}-\\d\\d-\\d\\d \\d\\d:\\d\\d:\\d\\d\\.\\d{3}", "content-length: \\d+"]},
  {"method": "PUT", "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES", "body": {"path": "/ff"}, "capture": {"bodyRegex": "\"RECEIVED_REQUEST\",\\s*\"correlationId\" : \"([^\"]+)\"", "as": "cf"}, "mask": [{"regex": "^[\\s\\S]*$", "replace": "<log entries>"}, "content-length: \\d+"]},
  {"note": "MATCHED by the forward expectation, with its forward failure", "method": "PUT", "path": "/mockserver/explain?correlationId={{capture:cf}}", "compare": "json", "mask": ["\\d{4}-\\d\\d-\\d\\dT[0-9:.]+Z", "\\d{4}-\\d\\d-\\d\\d \\d\\d:\\d\\d:\\d\\d\\.\\d{3}", "content-length: \\d+"]},
  {"method": "PUT", "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES", "body": {"path": "/ff-miss"}, "capture": {"bodyRegex": "\"RECEIVED_REQUEST\",\\s*\"correlationId\" : \"([^\"]+)\"", "as": "cm"}, "mask": [{"regex": "^[\\s\\S]*$", "replace": "<log entries>"}, "content-length: \\d+"]},
  {"note": "NO_MATCH, no forward failure", "method": "PUT", "path": "/mockserver/explain?correlationId={{capture:cm}}", "compare": "json", "mask": ["\\d{4}-\\d\\d-\\d\\dT[0-9:.]+Z", "\\d{4}-\\d\\d-\\d\\d \\d\\d:\\d\\d:\\d\\d\\.\\d{3}", "content-length: \\d+"]},
  {"method": "PUT", "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES", "body": {"path": "/ff-proxy"}, "capture": {"bodyRegex": "\"RECEIVED_REQUEST\",\\s*\"correlationId\" : \"([^\"]+)\"", "as": "cp"}, "mask": [{"regex": "^[\\s\\S]*$", "replace": "<log entries>"}, "content-length: \\d+"]},
  {"note": "FORWARDED_WITHOUT_EXPECTATION, with its forward failure", "method": "PUT", "path": "/mockserver/explain?correlationId={{capture:cp}}", "compare": "json", "mask": ["\\d{4}-\\d\\d-\\d\\dT[0-9:.]+Z", "\\d{4}-\\d\\d-\\d\\d \\d\\d:\\d\\d:\\d\\d\\.\\d{3}", "content-length: \\d+"]},
  {"method": "POST", "path": "/mockserver/mcp", "body": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-06-18"}}, "capture": {"header": "Mcp-Session-Id", "as": "s"}, "mask": [{"regex": "^[\\s\\S]*$", "replace": "<initialize>"}, "content-length: \\d+"]},
  {"method": "POST", "path": "/mockserver/mcp", "headers": {"Mcp-Session-Id": ["{{capture:s}}"]}, "body": {"jsonrpc": "2.0", "method": "notifications/initialized"}},
  {"note": "MCP explain_request: the failed forward, MATCHED with its forward failure", "method": "POST", "path": "/mockserver/mcp", "headers": {"Mcp-Session-Id": ["{{capture:s}}"]}, "body": {"jsonrpc": "2.0", "id": 2, "method": "tools/call", "params": {"name": "explain_request", "arguments": {"correlationId": "{{capture:cf}}"}}}, "mask": ["[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", "\\d{4}-\\d\\d-\\d\\dT[0-9:.]+Z", "\\d{4}-\\d\\d-\\d\\d \\d\\d:\\d\\d:\\d\\d\\.\\d{3}", "content-length: \\d+"]},
  {"note": "MCP explain_request: the proxied failure", "method": "POST", "path": "/mockserver/mcp", "headers": {"Mcp-Session-Id": ["{{capture:s}}"]}, "body": {"jsonrpc": "2.0", "id": 3, "method": "tools/call", "params": {"name": "explain_request", "arguments": {"correlationId": "{{capture:cp}}"}}}, "mask": ["[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", "\\d{4}-\\d\\d-\\d\\dT[0-9:.]+Z", "\\d{4}-\\d\\d-\\d\\d \\d\\d:\\d\\d:\\d\\d\\.\\d{3}", "content-length: \\d+"]},
  {"note": "MCP explain_request without a correlationId", "method": "POST", "path": "/mockserver/mcp", "headers": {"Mcp-Session-Id": ["{{capture:s}}"]}, "body": {"jsonrpc": "2.0", "id": 4, "method": "tools/call", "params": {"name": "explain_request", "arguments": {}}}, "mask": ["[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", "\\d{4}-\\d\\d-\\d\\dT[0-9:.]+Z", "\\d{4}-\\d\\d-\\d\\d \\d\\d:\\d\\d:\\d\\d\\.\\d{3}", "content-length: \\d+"]},
  {"note": "MCP explain_request with a blank correlationId", "method": "POST", "path": "/mockserver/mcp", "headers": {"Mcp-Session-Id": ["{{capture:s}}"]}, "body": {"jsonrpc": "2.0", "id": 5, "method": "tools/call", "params": {"name": "explain_request", "arguments": {"correlationId": "  "}}}, "mask": ["[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", "\\d{4}-\\d\\d-\\d\\dT[0-9:.]+Z", "\\d{4}-\\d\\d-\\d\\d \\d\\d:\\d\\d:\\d\\d\\.\\d{3}", "content-length: \\d+"]},
  {"note": "MCP explain_request for a correlation id never seen", "method": "POST", "path": "/mockserver/mcp", "headers": {"Mcp-Session-Id": ["{{capture:s}}"]}, "body": {"jsonrpc": "2.0", "id": 6, "method": "tools/call", "params": {"name": "explain_request", "arguments": {"correlationId": "no-such-correlation-id"}}}, "mask": ["[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", "\\d{4}-\\d\\d-\\d\\dT[0-9:.]+Z", "\\d{4}-\\d\\d-\\d\\d \\d\\d:\\d\\d:\\d\\d\\.\\d{3}", "content-length: \\d+"]}
 ]
}
