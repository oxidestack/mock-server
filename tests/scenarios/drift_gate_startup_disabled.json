{
 "source": "driftDetectionEnabled=false at startup (HttpActionHandlerDriftDetectionTest.recordsNoDriftWhenDriftDetectionDisabled), then enabled at runtime",
 "properties": {
  "driftDetectionEnabled": "false"
 },
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/reset"
  },
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": [
    {
     "id": "upstream",
     "priority": 1000,
     "httpRequest": {
      "headers": {
       "Host": [
        "localhost:[0-9]+"
       ]
      }
     },
     "httpResponse": {
      "statusCode": 500,
      "body": "upstream body"
     }
    },
    {
     "id": "stub",
     "httpRequest": {
      "path": "/some_path"
     },
     "httpResponse": {
      "statusCode": 200,
      "body": "stub body"
     }
    }
   ],
   "note": "the upstream answer (the forward targets this server) and a response stub for the same path, which drifts from it"
  },
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": "{\"id\": \"forward\", \"priority\": 10, \"httpRequest\": {\"path\": \"/some_path\"}, \"httpForward\": {\"host\": \"localhost\", \"port\": {{port}}}}"
  },
  {
   "method": "GET",
   "path": "/some_path",
   "headers": {
    "Host": "harvest.client"
   },
   "note": "forwarded to the server itself and answered by the upstream stub"
  },
  {
   "sleepMillis": 500
  },
  {
   "method": "GET",
   "path": "/mockserver/drift",
   "note": "no drift recorded",
   "mask": [
    {
     "regex": "\"epochTimeMs\" : \\d+",
     "replace": "\"epochTimeMs\" : <millis>"
    }
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/drift/clear"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "driftDetectionEnabled": true
   },
   "note": "enabled at runtime"
  },
  {
   "method": "GET",
   "path": "/some_path",
   "headers": {
    "Host": "harvest.client"
   },
   "note": "forwarded to the server itself and answered by the upstream stub"
  },
  {
   "sleepMillis": 500
  },
  {
   "method": "GET",
   "path": "/mockserver/drift",
   "note": "the stub drifts again",
   "mask": [
    {
     "regex": "\"epochTimeMs\" : \\d+",
     "replace": "\"epochTimeMs\" : <millis>"
    }
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/drift/clear"
  },
  {
   "method": "PUT",
   "path": "/mockserver/reset"
  }
 ]
}
