  {"method": "GET", "path": "/matrix/path/;variableOne=variableOneValaa;variableOne=variableOneValbb;variableOne=variableOneValcc/;variableTwo=variableTwoValue,variableTwoValue", "note": "matrix-exploded and matrix values"},
