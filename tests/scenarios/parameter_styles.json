{"steps": [
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"httpRequest": {"path": "/some/path", "queryStringParameters": {"keyMatchStyle": "MATCHING_KEY", "variableO[a-z]{2}": {"parameterStyle": "PIPE_DELIMITED", "values": [{"schema": {"type": "string", "pattern": "variableOneV[a-z]{4}$"}}]}, "?variableTwo": {"parameterStyle": "PIPE_DELIMITED", "values": [{"schema": {"type": "string", "pattern": "variableTwoV[a-z]{4}$"}}]}}}, "httpResponse": {"statusCode": 200}}},
