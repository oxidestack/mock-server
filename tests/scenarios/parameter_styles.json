  {"method": "POST", "path": "/form_schema", "headers": {"content-type": "application/x-www-form-urlencoded"}, "body": "id=1&name=A+green+door&price=12.5&tags=home+green", "note": "form body as JSON, space-delimited tags split"},
  {"method": "POST", "path": "/form_schema", "headers": {"content-type": "application/x-www-form-urlencoded"}, "body": "id=1&name=A+green+door&price=12.5&tags=home+green+door+book+expensive", "note": "too many tags"},
  {"method": "POST", "path": "/form_schema", "headers": {"content-type": "application/x-www-form-urlencoded"}, "body": "id=1&name=A+green+door&price=12.5&tags=home", "note": "one tag stays a string, not an array"},
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"httpRequest": {"path": "/form_json", "body": {"type": "JSON", "json": {"id": 1, "name": "door", "ok": true}}}, "httpResponse": {"statusCode": 200, "body": "json"}}},
  {"method": "POST", "path": "/form_json", "headers": {"content-type": "application/x-www-form-urlencoded"}, "body": "id=1&name=door&ok=TRUE", "note": "form body typed for a JSON matcher"},
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"httpRequest": {"path": "/deep", "queryStringParameters": {"filter": {"parameterStyle": "DEEP_OBJECT", "values": [{"schema": {"type": "object", "properties": {"color": {"type": "string", "enum": ["red"]}}, "required": ["color"]}}]}}}, "httpResponse": {"statusCode": 200, "body": "deep"}}},
  {"method": "GET", "path": "/deep?filter%5Bcolor%5D=red", "note": "deepObject parts folded into one object"},
