  {
   "method": "PUT",
   "path": "/mockserver/loadScenario",
   "note": "a full definition",
   "body": {
    "name": "full",
    "steps": [
     {
      "name": "login",
      "request": {
       "method": "POST",
       "path": "/login",
       "headers": {
        "X-Vu": [
         "$iteration.vuId"
        ]
       },
       "body": {
        "type": "JSON",
        "json": {
         "user": "u"
        }
       }
      },
      "thinkTime": {
       "timeUnit": "MILLISECONDS",
       "value": 10
      },
      "labels": {
       "tier": "auth"
      },
      "captures": [
       {
        "name": "token",
        "source": "BODY_JSONPATH",
        "expression": "$.token",
        "defaultValue": "none"
       }
      ],
      "checks": [
       {
        "source": "STATUS",
        "comparator": "EQUALS",
        "value": "200"
       },
       {
        "source": "HEADER",
        "headerName": "x-a",
        "comparator": "CONTAINS",
        "value": "b"
       }
      ],
      "weight": 2
     },
     {
      "request": {
       "path": "/item/{{iteration.index}}",
       "queryStringParameters": {
        "q": [
         "1"
        ]
       }
      },
      "weight": 1.5
     }
    ],
    "profile": {
     "stages": [
      {
       "type": "VU",
       "vus": 2,
       "durationMillis": 1000
      },
      {
       "startVus": 1,
       "endVus": 3,
       "durationMillis": 1000,
       "curve": "QUADRATIC"
      },
      {
       "type": "RATE",
       "rate": 5.5,
       "maxVus": 4,
       "durationMillis": 1000
      },
      {
       "type": "RATE",
       "startRate": 1,
       "endRate": 2,
       "durationMillis": 1000,
       "curve": "EXPONENTIAL"
      },
      {
       "type": "PAUSE",
       "durationMillis": 500
      }
     ]
    },
    "templateType": "MUSTACHE",
    "maxRequests": 100,
    "startDelayMillis": 250,
    "labels": {
     "team": "qa"
    },
    "thresholds": [
     {
      "metric": "LATENCY_P95",
      "comparator": "LESS_THAN",
      "threshold": 500
     },
     {
      "metric": "ERROR_RATE",
      "comparator": "LESS_THAN_OR_EQUAL",
      "threshold": 0.1
     }
    ],
    "abortOnFail": true,
    "abortGraceMillis": 100,
    "pacing": {
     "mode": "CONSTANT_PACING",
     "value": 200
    },
    "feeder": {
     "rows": [
      {
       "a": "1"
      },
      {
       "a": "2"
      }
     ],
     "strategy": "RANDOM"
    },
    "stepSelection": "WEIGHTED"
   }
