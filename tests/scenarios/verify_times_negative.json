{
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/reset",
   "note": "VerificationTimes.between refuses a bound below -1 (VerificationTimesTest.shouldRejectNegativeBetween*)"
  },
  {
   "method": "PUT",
   "path": "/mockserver/verify",
   "body": "{\"httpRequest\":{\"path\":\"/negative\"},\"times\":{\"atLeast\":-2,\"atMost\":2}}",
   "note": "atLeast -2"
  },
  {
   "method": "PUT",
   "path": "/mockserver/verify",
   "body": "{\"httpRequest\":{\"path\":\"/negative\"},\"times\":{\"atMost\":-3}}",
   "note": "atMost -3"
  },
  {
   "method": "PUT",
   "path": "/mockserver/verify",
   "body": "{\"httpRequest\":{\"path\":\"/negative\"},\"times\":{\"atLeast\":-5,\"atMost\":-7}}",
   "note": "both: atLeast is checked first"
  },
  {
   "method": "PUT",
   "path": "/mockserver/verify",
   "body": "{\"httpRequest\":{\"path\":\"/negative\"},\"times\":{\"atLeast\":-1,\"atMost\":-1}}",
   "note": "-1 is the unbounded sentinel"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS",
   "note": "the parse failure and the client error are logged"
  }
 ]
}
