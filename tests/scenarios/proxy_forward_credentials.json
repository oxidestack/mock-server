{"source": "forwardProxyAuthenticationUsername/Password on a forward through forwardHttpProxy and forwardHttpsProxy; the peer node is the proxy and records what it receives",
 "peer": true,
 "properties": {"forwardHttpProxy": "{{peerhost}}:{{peerport}}", "forwardHttpsProxy": "{{peerhost}}:{{peerport}}", "forwardProxyAuthenticationUsername": "userName", "forwardProxyAuthenticationPassword": "password"},
 "steps": [
  {"node": "peer", "method": "PUT", "path": "/mockserver/reset", "note": "the proxy's startup entries are not the point"},
  {"node": "peer", "method": "PUT", "path": "/mockserver/expectation", "body": {"httpRequest": {"path": "/target"}, "httpResponse": {"body": "from proxy"}}, "mask": ["\"id\" : \"[0-9a-f-]+\""]},
  {"method": "PUT", "path": "/mockserver/expectation", "body": [
    {"httpRequest": {"path": "/plain"}, "httpOverrideForwardedRequest": {"requestOverride": {"path": "/target", "headers": {"Host": ["target.example:8080"]}}}},
    {"httpRequest": {"path": "/secure"}, "httpOverrideForwardedRequest": {"requestOverride": {"path": "/target", "secure": true, "headers": {"Host": ["localhost:{{port}}"]}}}},
    {"httpRequest": {"path": "/secure-unresolvable"}, "httpOverrideForwardedRequest": {"requestOverride": {"path": "/target", "secure": true, "headers": {"Host": ["target.example:8443"]}}}}
  ], "mask": ["\"id\" : \"[0-9a-f-]+\""]},
  {"note": "plain forward: sent to the HTTP proxy in absolute form, the target host never resolved", "method": "GET", "path": "/plain"},
  {"note": "what the HTTP proxy received", "node": "peer", "method": "PUT", "path": "/mockserver/retrieve?type=REQUESTS"},
  {"node": "peer", "method": "PUT", "path": "/mockserver/clear?type=LOG"},
  {"note": "https forward: tunnelled through the HTTPS proxy with CONNECT", "method": "GET", "path": "/secure"},
  {"note": "what the HTTPS proxy received", "node": "peer", "method": "PUT", "path": "/mockserver/retrieve?type=REQUESTS"},
  {"node": "peer", "method": "PUT", "path": "/mockserver/clear?type=LOG"},
  {"note": "https forward to a host that does not resolve here: its name is sent to the proxy in the CONNECT request", "method": "GET", "path": "/secure-unresolvable"},
  {"note": "what the HTTPS proxy received", "node": "peer", "method": "PUT", "path": "/mockserver/retrieve?type=REQUESTS"}
]}
