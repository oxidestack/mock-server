{
 "properties": {
  "proxySetupLogging": "false",
  "grpcEnabled": "false",
  "grpcDescriptorDirectory": "{{files}}/grpc",
  "grpcProtoDirectory": "{{files}}/grpc/proto"
 },
 "startupLog": true,
 "steps": [
  {
   "note": "grpcEnabled=false: neither directory is read",
   "method": "PUT",
   "path": "/mockserver/grpc/services"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS"
  },
  {
   "note": "descriptors can still be uploaded",
   "method": "PUT",
   "path": "/mockserver/grpc/descriptors",
   "bodyFile": "grpc/greeting.dsc"
  },
  {
   "method": "PUT",
   "path": "/mockserver/grpc/services"
  }
 ]
}
