{
 "quic": true,
 "properties": {
  "http3Port": "19677"
 },
 "steps": [
  {"method": "GET", "path": "/mockserver/http3status", "pollUntil": "\"enabled\" ?: ?true", "note": "wait for the HTTP/3 server"},
  {"h3": true, "method": "GET", "path": "/warm-up", "note": "lets the oracle's startup logging finish"},
  {"method": "PUT", "path": "/mockserver/reset", "note": "the oracle may log its startup entries after the opening reset: reset again"},
  {"method": "PUT", "path": "/mockserver/grpc/descriptors", "bodyFile": "grpc/greeting.dsc", "note": "descriptors"},
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": [
    {
     "httpRequest": {"path": "/com.example.grpc.GreetingService/ListGreetings", "headers": {"x-case": ["unencodable"]}},
     "grpcStreamResponse": {"statusName": "OK", "messages": [{"json": "{\"greeting\": \"one\"}"}, {"json": "not json"}, {"json": "{\"greeting\": \"three\"}"}]}
    },
    {
     "httpRequest": {"path": "/com.example.grpc.GreetingService/ListGreetings", "headers": {"x-case": ["templated"]}},
     "grpcStreamResponse": {"statusName": "OK", "messages": [{"json": "{\"greeting\": \"$!request.path\"}", "templateType": "VELOCITY"}, {"json": "{\"greeting\": \"{{ request.path }}\"}", "templateType": "MUSTACHE"}]}
    }
   ],
   "mask": ["\"id\" : \"[0-9a-f-]+\""]
  },
  {"h3": true, "method": "POST", "path": "/com.example.grpc.GreetingService/ListGreetings", "headers": {"content-type": "application/grpc", "x-case": "unencodable"}, "bodyBase64": "AAAAAAcKBUFsaWNl", "maxMillis": 5000, "binaryBody": true, "note": "a stream over HTTP/3 whose second message does not encode"},
  {"h3": true, "method": "POST", "path": "/com.example.grpc.GreetingService/ListGreetings", "headers": {"content-type": "application/grpc", "x-case": "templated"}, "bodyBase64": "AAAAAAcKBUFsaWNl", "maxMillis": 5000, "binaryBody": true, "note": "a stream over HTTP/3 whose messages carry a templateType"},
  {"method": "PUT", "path": "/mockserver/retrieve?type=LOGS", "note": "the gRPC-over-HTTP/3 stream entries"}
 ]
}
