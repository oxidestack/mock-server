{
 "properties": {
  "binaryMessageFraming": "MYSQL",
  "maxRequestBodySize": "16384"
 },
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "note": "BinaryMessageFramingIntegrationTest's MySQL packets",
   "mask": [
    "\"id\" : \"[0-9a-f-]+\""
   ],
   "body": [
    {
     "httpRequest": {
      "binaryData": ""
     },
     "binaryResponse": {
      "binaryData": "BwAAAQAAAAIAAAA="
     }
    },
    {
     "httpRequest": {
      "binaryData": "KAAAAHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHA="
     },
     "binaryResponse": {
      "binaryData": "AQAAAVA="
     }
    },
    {
     "httpRequest": {
      "binaryData": "FAAAAGVlZWVlZWVlZWVlZWVlZWVlZWVl"
     },
     "binaryResponse": {
      "binaryData": "AQAAAUU="
     }
    }
   ]
  },
  {
   "tcp": [
    "",
    ""
   ],
   "note": "a packet written in two parts with a pause is one message"
  },
  {
   "tcp": [
    "KAAAAHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHAUAAAAZWVlZWVlZWVlZWVlZWVlZWVlZWU="
   ],
   "note": "packets written together are matched one by one"
  },
  {
   "tcp": [
    "IE4AAA=="
   ],
   "note": "a declared length over maxRequestBodySize closes the connection, with nothing written"
  },
  {
   "tcp": [
    "AgAAAGFhIE4AAA=="
   ],
   "note": "a message taken in the same read as a refusal is handled, but nothing is written"
  },
  {
   "sleepMillis": 300
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS",
   "note": "the refusal's WARN",
   "mask": [
    "content-length: \\d+",
    "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)"
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/reset"
  }
 ]
}
