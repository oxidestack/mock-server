{
 "properties": {
  "deduplicateRecordedExpectations": "true"
 },
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/import?format=recording&redactSensitiveData=false",
   "bodyFile": "import/recording_dedup.ndjson",
   "note": "recording archive"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS",
   "note": "deduplicated"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&format=JAVA",
   "note": "deduplicated java"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&format=HAR",
   "note": "deduplicated har"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&format=OPENAPI",
   "note": "deduplicated openapi"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&format=LOG_ENTRIES",
   "note": "log entries unaffected",
   "mask": [
    "\"epochTime\" : \\d+"
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=RECORDED_EXPECTATIONS&consolidate=true",
   "note": "consolidate overrides the property"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS",
   "note": "log messages"
  }
 ]
}
