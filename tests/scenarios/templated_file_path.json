{
  "steps": [
    {
      "note": "create the expectations",
      "method": "PUT",
      "path": "/mockserver/expectation",
      "body": [
        {
          "httpRequest": {
            "path": "/files/{name}",
            "pathParameters": {
              "name": [
                ".*"
              ]
            }
          },
          "httpResponse": {
            "body": {
              "type": "FILE",
              "filePath": "{{files}}/templated_file_path/mocks/{{ request.pathParameters.name.0 }}.json",
              "contentType": "application/json",
              "templateType": "MUSTACHE",
              "templatedFilePath": true
            }
          }
        },
        {
          "httpRequest": {
            "path": "/q"
          },
          "httpResponse": {
            "body": {
              "type": "FILE",
              "filePath": "{{files}}/templated_file_path/mocks/{{ request.queryStringParameters.name.0 }}.json",
              "contentType": "application/json",
              "templateType": "MUSTACHE",
              "templatedFilePath": true
            }
          }
        },
        {
          "httpRequest": {
            "path": "/raw"
          },
          "httpResponse": {
            "body": {
              "type": "FILE",
              "filePath": "{{files}}/templated_file_path/mocks/{{ request.queryStringParameters.name.0 }}",
              "contentType": "application/json",
              "templateType": "MUSTACHE",
              "templatedFilePath": true
            }
          }
        },
        {
          "httpRequest": {
            "path": "/v"
          },
          "httpResponse": {
            "body": {
              "type": "FILE",
              "filePath": "{{files}}/templated_file_path/mocks/${request.queryStringParameters.name[0]}.json",
              "contentType": "application/json",
              "templateType": "VELOCITY",
              "templatedFilePath": true
            }
          }
        },
        {
          "httpRequest": {
            "path": "/v2"
          },
          "httpResponse": {
            "body": {
              "type": "FILE",
              "filePath": "{{files}}/templated_file_path/mocks/#if(true)alice#end.json",
              "contentType": "application/json",
              "templateType": "VELOCITY",
              "templatedFilePath": true
            }
          }
        },
        {
          "httpRequest": {
            "path": "/literal"
          },
          "httpResponse": {
            "body": {
              "type": "FILE",
              "filePath": "{{files}}/templated_file_path/mocks/literal.json",
              "contentType": "application/json",
              "templateType": "MUSTACHE",
              "templatedFilePath": true
            }
          }
        },
        {
          "httpRequest": {
            "path": "/literal-missing"
          },
          "httpResponse": {
            "body": {
              "type": "FILE",
              "filePath": "{{files}}/templated_file_path/mocks/missing.json",
              "contentType": "application/json"
            }
          }
        },
        {
          "httpRequest": {
            "path": "/nobase"
          },
          "httpResponse": {
            "body": {
              "type": "FILE",
              "filePath": "/nonexistent-templated-file-path/{{ request.queryStringParameters.name.0 }}.json",
              "contentType": "application/json",
              "templateType": "MUSTACHE",
              "templatedFilePath": true
            }
          }
        },
        {
          "httpRequest": {
            "path": "/empty-base"
          },
          "httpResponse": {
            "body": {
              "type": "FILE",
              "filePath": "{{ request.queryStringParameters.name.0 }}",
              "contentType": "application/json",
              "templateType": "MUSTACHE",
              "templatedFilePath": true
            }
          }
        },
        {
          "httpRequest": {
            "path": "/dot-base"
          },
          "httpResponse": {
            "body": {
              "type": "FILE",
              "filePath": "./{{ request.queryStringParameters.name.0 }}",
              "contentType": "application/json",
              "templateType": "MUSTACHE",
              "templatedFilePath": true
            }
          }
        },
        {
          "httpRequest": {
            "path": "/root-base"
          },
          "httpResponse": {
            "body": {
              "type": "FILE",
              "filePath": "/{{ request.queryStringParameters.name.0 }}",
              "contentType": "application/json",
              "templateType": "MUSTACHE",
              "templatedFilePath": true
            }
          }
        },
        {
          "httpRequest": {
            "path": "/off"
          },
          "httpResponse": {
            "body": {
              "type": "FILE",
              "filePath": "{{files}}/templated_file_path/mocks/{{ request.queryStringParameters.name.0 }}.json",
              "contentType": "application/json",
              "templateType": "MUSTACHE",
              "templatedFilePath": false
            }
          }
        },
        {
          "httpRequest": {
            "path": "/string-flag"
          },
          "httpResponse": {
            "body": {
              "type": "FILE",
              "filePath": "{{files}}/templated_file_path/mocks/{{ request.queryStringParameters.name.0 }}.json",
              "contentType": "application/json",
              "templateType": "MUSTACHE",
              "templatedFilePath": "TRUE"
            }
          }
        },
        {
          "httpRequest": {
            "path": "/yes-flag"
          },
          "httpResponse": {
            "body": {
              "type": "FILE",
              "filePath": "{{files}}/templated_file_path/mocks/{{ request.queryStringParameters.name.0 }}.json",
              "contentType": "application/json",
              "templateType": "MUSTACHE",
              "templatedFilePath": "yes"
            }
          }
        },
        {
          "httpRequest": {
            "path": "/no-engine"
          },
          "httpResponse": {
            "body": {
              "type": "FILE",
              "filePath": "{{files}}/templated_file_path/mocks/{{ request.queryStringParameters.name.0 }}.json",
              "contentType": "application/json",
              "templatedFilePath": true
            }
          }
        },
        {
          "httpRequest": {
            "path": "/javascript"
          },
          "httpResponse": {
            "body": {
              "type": "FILE",
              "filePath": "{{files}}/templated_file_path/mocks/{{ request.queryStringParameters.name.0 }}.json",
              "contentType": "application/json",
              "templateType": "JAVASCRIPT",
              "templatedFilePath": true
            }
          }
        },
        {
          "httpRequest": {
            "path": "/bad-template"
          },
          "httpResponse": {
            "body": {
              "type": "FILE",
              "filePath": "{{files}}/templated_file_path/mocks/{{#x}}.json",
              "contentType": "application/json",
              "templateType": "MUSTACHE",
              "templatedFilePath": true
            }
          }
        },
        {
          "httpRequest": {
            "path": "/log-dotdot"
          },
          "httpResponse": {
            "body": {
              "type": "FILE",
              "filePath": "{{files}}/templated_file_path/mocks/{{ request.queryStringParameters.name.0 }}.json",
              "contentType": "application/json",
              "templateType": "MUSTACHE",
              "templatedFilePath": true
            }
          }
        },
        {
          "httpRequest": {
            "path": "/log-nul"
          },
          "httpResponse": {
            "body": {
              "type": "FILE",
              "filePath": "{{files}}/templated_file_path/mocks/{{ request.queryStringParameters.name.0 }}.json",
              "contentType": "application/json",
              "templateType": "MUSTACHE",
              "templatedFilePath": true
            }
          }
        },
        {
          "httpRequest": {
            "path": "/log-link"
          },
          "httpResponse": {
            "body": {
              "type": "FILE",
              "filePath": "{{files}}/templated_file_path/mocks/{{ request.queryStringParameters.name.0 }}.json",
              "contentType": "application/json",
              "templateType": "MUSTACHE",
              "templatedFilePath": true
            }
          }
        }
      ]
    },
    {
      "note": "the echo keeps templatedFilePath (FileBodyDTO, a Boolean: \"TRUE\" true, \"yes\" false)",
      "method": "PUT",
      "path": "/mockserver/retrieve?type=ACTIVE_EXPECTATIONS"
    },
    {
      "method": "GET",
      "path": "/files/alice",
      "note": "rendered from a path parameter"
    },
    {
      "method": "GET",
      "path": "/q?name=alice",
      "note": "rendered from a query parameter"
    },
    {
      "method": "GET",
      "path": "/q?name=sub/bob",
      "note": "two request segments"
    },
    {
      "method": "GET",
      "path": "/q?name=greet",
      "note": "the chosen file is itself rendered"
    },
    {
      "method": "GET",
      "path": "/v?name=alice",
      "note": "a Velocity path"
    },
    {
      "method": "GET",
      "path": "/v2",
      "note": "a Velocity directive marks the base"
    },
    {
      "method": "GET",
      "path": "/literal",
      "note": "no template syntax: the literal path"
    },
    {
      "method": "GET",
      "path": "/literal-missing",
      "note": "a missing literal file"
    },
    {
      "method": "GET",
      "path": "/files/carol",
      "note": "a missing rendered file: NoSuchFileException"
    },
    {
      "method": "GET",
      "path": "/q?name=link",
      "note": "a symbolic link out of the base"
    },
    {
      "method": "GET",
      "path": "/raw?name=sub",
      "note": "a directory: IOException"
    },
    {
      "method": "GET",
      "path": "/q?name=..%2Fsecret",
      "note": "a .. segment"
    },
    {
      "method": "GET",
      "path": "/q?name=.%2Falice",
      "note": "a . segment"
    },
    {
      "method": "GET",
      "path": "/q?name=sub%2F%2Fbob",
      "note": "an empty segment"
    },
    {
      "method": "GET",
      "path": "/q?name=..%5Csecret",
      "note": "a backslash"
    },
    {
      "method": "GET",
      "path": "/q?name=%252e%252e%252fsecret",
      "note": "a percent sign"
    },
    {
      "method": "GET",
      "path": "/q?name=a%3Ab",
      "note": "a colon"
    },
    {
      "method": "GET",
      "path": "/q?name=alice.json%00",
      "note": "a NUL, printed escaped"
    },
    {
      "method": "GET",
      "path": "/q?name=a%E2%80%A8b",
      "note": "a line separator"
    },
    {
      "method": "GET",
      "path": "/q?name=%2Fetc%2Fpasswd",
      "note": "an absolute value"
    },
    {
      "method": "GET",
      "path": "/files/..%2Fsecret",
      "note": "an encoded path segment"
    },
    {
      "method": "GET",
      "path": "/files/%2e%2e%2fsecret",
      "note": "an encoded path segment, lower case"
    },
    {
      "method": "GET",
      "path": "/files/..%5Csecret",
      "note": "an encoded backslash segment"
    },
    {
      "method": "GET",
      "path": "/files/%252e%252e%252fsecret",
      "note": "a double-encoded segment"
    },
    {
      "method": "GET",
      "path": "/nobase?name=alice",
      "note": "a missing base directory"
    },
    {
      "method": "GET",
      "path": "/empty-base?name=alice.json",
      "note": "no base directory"
    },
    {
      "method": "GET",
      "path": "/dot-base?name=alice.json",
      "note": "the working directory as base"
    },
    {
      "method": "GET",
      "path": "/root-base?name=etc",
      "note": "the root as base"
    },
    {
      "method": "GET",
      "path": "/off?name=alice",
      "note": "templatedFilePath false: the literal path"
    },
    {
      "method": "GET",
      "path": "/string-flag?name=alice",
      "note": "templatedFilePath \"TRUE\""
    },
    {
      "method": "GET",
      "path": "/yes-flag?name=alice",
      "note": "templatedFilePath \"yes\""
    },
    {
      "method": "GET",
      "path": "/no-engine?name=alice",
      "note": "no templateType: verbatim"
    },
    {
      "method": "GET",
      "path": "/javascript?name=alice",
      "note": "JAVASCRIPT: verbatim"
    },
    {
      "method": "GET",
      "path": "/bad-template",
      "note": "a path that fails to render"
    },
    {
      "method": "GET",
      "path": "/log-dotdot?name=..%2Fsecret",
      "note": "refused: IllegalArgumentException"
    },
    {
      "method": "GET",
      "path": "/log-nul?name=alice.json%00",
      "note": "refused, the path printed with \\x00"
    },
    {
      "method": "GET",
      "path": "/log-link?name=link",
      "note": "a symbolic link out of the base: refused after resolving"
    },
    {
      "note": "log: NoSuchFileException of the rendered path",
      "method": "PUT",
      "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES",
      "body": {
        "path": "/files/carol"
      },
      "mask": [
        "(?s)\"stackTrace\" : \\[.*?\\]",
        "\"epochTime\" : \\d+",
        "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)",
        "content-length: \\d+"
      ]
    },
    {
      "note": "log: IOException: Is a directory",
      "method": "PUT",
      "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES",
      "body": {
        "path": "/raw"
      },
      "mask": [
        "(?s)\"stackTrace\" : \\[.*?\\]",
        "\"epochTime\" : \\d+",
        "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)",
        "content-length: \\d+"
      ]
    },
    {
      "note": "log: NoSuchFileException of the base",
      "method": "PUT",
      "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES",
      "body": {
        "path": "/nobase"
      },
      "mask": [
        "(?s)\"stackTrace\" : \\[.*?\\]",
        "\"epochTime\" : \\d+",
        "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)",
        "content-length: \\d+"
      ]
    },
    {
      "note": "log: no base directory",
      "method": "PUT",
      "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES",
      "body": {
        "path": "/empty-base"
      },
      "mask": [
        "(?s)\"stackTrace\" : \\[.*?\\]",
        "\"epochTime\" : \\d+",
        "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)",
        "content-length: \\d+"
      ]
    },
    {
      "note": "log: templatedFilePath false: the literal read chain",
      "method": "PUT",
      "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES",
      "body": {
        "path": "/off"
      },
      "mask": [
        "(?s)\"stackTrace\" : \\[.*?\\]",
        "\"epochTime\" : \\d+",
        "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)",
        "content-length: \\d+"
      ]
    },
    {
      "note": "log: a path that fails to render",
      "method": "PUT",
      "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES",
      "body": {
        "path": "/bad-template"
      },
      "mask": [
        "(?s)\"stackTrace\" : \\[.*?\\]",
        "\"epochTime\" : \\d+",
        "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)",
        "content-length: \\d+"
      ]
    },
    {
      "note": "log: /log-dotdot",
      "method": "PUT",
      "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES",
      "body": {
        "path": "/log-dotdot"
      },
      "mask": [
        "(?s)\"stackTrace\" : \\[.*?\\]",
        "\"epochTime\" : \\d+",
        "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)",
        "content-length: \\d+"
      ]
    },
    {
      "note": "log: /log-nul",
      "method": "PUT",
      "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES",
      "body": {
        "path": "/log-nul"
      },
      "mask": [
        "(?s)\"stackTrace\" : \\[.*?\\]",
        "\"epochTime\" : \\d+",
        "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)",
        "content-length: \\d+"
      ]
    },
    {
      "note": "log: /log-link",
      "method": "PUT",
      "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES",
      "body": {
        "path": "/log-link"
      },
      "mask": [
        "(?s)\"stackTrace\" : \\[.*?\\]",
        "\"epochTime\" : \\d+",
        "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)",
        "content-length: \\d+"
      ]
    }
  ]
}
