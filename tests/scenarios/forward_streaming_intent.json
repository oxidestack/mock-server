{
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": [
    {
     "httpRequest": {
      "path": "/up"
     },
     "httpResponse": {
      "statusCode": 200,
      "headers": {
       "Content-Type": [
        "application/json"
       ],
       "X-Up": [
        "1"
       ]
      },
      "body": "{\"upstream\":true}"
     }
    },
    {
     "httpRequest": {
      "path": "/sse-up"
     },
     "httpResponse": {
      "statusCode": 200,
      "headers": {
       "Content-Type": [
        "text/plain"
       ]
      },
      "body": "data: one\n\ndata: two\n\n",
      "connectionOptions": {
       "chunkSize": 6
      }
     }
    },
    {
     "httpRequest": {
      "path": "/fwd/.*"
     },
     "httpOverrideForwardedRequest": {
      "requestOverride": {
       "path": "/up",
       "headers": {
        "Host": [
         "localhost:{{port}}"
        ]
       }
      }
     }
    },
    {
     "httpRequest": {
      "path": "/sfwd/.*"
     },
     "httpOverrideForwardedRequest": {
      "requestOverride": {
       "path": "/sse-up",
       "headers": {
        "Host": [
         "localhost:{{port}}"
        ]
       }
      }
     }
    },
    {
     "httpRequest": {
      "path": "/dead/.*"
     },
     "httpForward": {
      "host": "{{deadhost}}",
      "port": "{{deadport}}"
     }
    }
   ]
  },
  {
   "note": "json upstream: json stream true",
   "method": "POST",
   "path": "/fwd/0",
   "headers": {
    "content-type": "application/json"
   },
   "body": "{\"model\":\"x\",\"stream\":true}"
  },
  {
   "note": "json upstream: json stream true whitespace",
   "method": "POST",
   "path": "/fwd/1",
   "headers": {
    "content-type": "application/json"
   },
   "body": "{\"stream\" : true}"
  },
  {
