{
 "source": "NettyHttpClientUpstreamProxyFailureTest.shouldLogAnUnreachableProxyOnceAsAProxyConfigurationProblem (NettyHttpClient.proxyFailure). forwardSocksProxy refuses (plain and secure forwards: one proxy, one WARN, not again after a reset)",
 "properties": {
  "forwardSocksProxy": "{{deadhost}}"
 },
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": [
    {
     "httpRequest": {
      "path": "/plain"
     },
     "httpOverrideForwardedRequest": {
      "requestOverride": {
       "path": "/target",
       "headers": {
        "Host": [
         "localhost:{{port}}"
        ]
       }
      }
     }
    },
    {
     "httpRequest": {
      "path": "/secure"
     },
     "httpOverrideForwardedRequest": {
      "requestOverride": {
       "path": "/target",
       "secure": true,
       "headers": {
        "Host": [
         "localhost:{{port}}"
        ]
       }
      }
     }
    }
   ]
  },
  {
   "note": "plain forward 1: its proxy cannot be reached",
   "method": "GET",
   "path": "/plain"
  },
  {
   "note": "plain forward 2: its proxy cannot be reached",
   "method": "GET",
   "path": "/plain"
  },
  {
   "note": "plain forward 3: its proxy cannot be reached",
   "method": "GET",
   "path": "/plain"
  },
  {
   "note": "secure forward 1: its proxy cannot be reached",
   "method": "GET",
   "path": "/secure"
  },
  {
   "note": "secure forward 2: its proxy cannot be reached",
   "method": "GET",
   "path": "/secure"
  },
  {
   "note": "secure forward 3: its proxy cannot be reached",
   "method": "GET",
   "path": "/secure"
  },
  {
   "note": "one 'could not be reached' WARN per proxy address, however many forwards failed",
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS"
  },
  {
   "note": "a reset clears the log, not the proxies already reported",
   "method": "PUT",
   "path": "/mockserver/reset"
  },
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "path": "/plain"
    },
    "httpOverrideForwardedRequest": {
     "requestOverride": {
      "path": "/target",
      "headers": {
       "Host": [
        "localhost:{{port}}"
       ]
      }
     }
    }
   }
  },
  {
   "note": "fails as before",
   "method": "GET",
   "path": "/plain"
  },
  {
   "note": "no second WARN for the same proxy",
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS"
  }
 ]
}
