  {"note": "frames: both mode on h2, goaway then 503", "h2raw": {"method": "GET", "path": "/ok"}},
  {"note": "uncordon", "method": "DELETE", "path": "/mockserver/preemption"},
  {"note": "start reject503", "method": "PUT", "path": "/mockserver/preemption", "body": {"mode": "reject503", "drainMillis": 0, "ttlMillis": 60000}},
  {"note": "frames: reject503 on h2, no goaway", "h2raw": {"method": "GET", "path": "/ok"}},
  {"note": "reject503 on h2 through a client", "h2": true, "method": "GET", "path": "/ok"},
  {"note": "uncordon", "method": "DELETE", "path": "/mockserver/preemption"},
  {"note": "tcp chaos goaway with code and last stream", "method": "PUT", "path": "/mockserver/tcpChaos", "body": {"host": "{{host}}", "chaos": {"http2GoAway": true, "http2GoAwayErrorCode": 11, "http2GoAwayLastStreamId": 0}}},
  {"note": "frames: response-path goaway (L3)", "h2raw": {"method": "GET", "path": "/ok"}},
