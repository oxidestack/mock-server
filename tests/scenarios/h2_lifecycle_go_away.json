  {"note": "frames: goaway-only cordon on h2 (Http2GoAwayEmitter, current last stream)", "h2raw": {"method": "GET", "path": "/ok"}},
  {"note": "frames: the control plane is exempt from the cordon on h2", "h2raw": {"method": "GET", "path": "/mockserver/preemption"}},
  {"note": "uncordon", "method": "DELETE", "path": "/mockserver/preemption"},
  {"note": "start goaway with last stream id", "method": "PUT", "path": "/mockserver/preemption", "body": {"mode": "goaway", "drainMillis": 0, "ttlMillis": 60000, "lastStreamId": 0}},
  {"note": "frames: goaway advertising last stream 0", "h2raw": {"method": "GET", "path": "/ok"}},
  {"note": "uncordon", "method": "DELETE", "path": "/mockserver/preemption"},
