  {"note": "frames: response-path goaway with default code and last stream", "h2raw": {"method": "GET", "path": "/ok"}},
  {"note": "frames: control plane on h2 under response-path goaway", "h2raw": {"method": "GET", "path": "/mockserver/preemption"}},
