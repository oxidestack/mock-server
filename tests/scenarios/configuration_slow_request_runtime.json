{
 "properties": {
  "logLevel": "INFO",
  "metricsEnabled": "true"
 },
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": [
    {
     "httpRequest": {
      "path": "/slow-target"
     },
     "httpResponse": {
      "body": "slow",
      "delay": {
       "timeUnit": "MILLISECONDS",
       "value": 300
      }
     }
    },
    {
     "httpRequest": {
      "path": "/via-forward"
     },
     "httpOverrideForwardedRequest": {
      "requestOverride": {
       "path": "/slow-target",
       "headers": {
        "Host": [
         "localhost:{{port}}"
        ]
       }
      }
     }
    },
    {
     "httpRequest": {
      "path": "/fast-target"
     },
     "httpResponse": {
      "body": "fast"
     }
    },
    {
     "httpRequest": {
      "path": "/fast-forward"
     },
     "httpOverrideForwardedRequest": {
      "requestOverride": {
       "path": "/fast-target",
       "headers": {
        "Host": [
         "localhost:{{port}}"
        ]
       }
      }
     }
    }
   ]
  },
  {
   "note": "warm-up forward",
   "method": "GET",
   "path": "/fast-forward"
  },
  {
   "note": "no threshold yet",
   "method": "GET",
   "path": "/via-forward",
   "minMillis": 250
  },
  {
   "note": "the threshold set while the server runs",
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "slowRequestThresholdMillis": 100,
    "metricsRequestDurationRouteLabels": true
   }
  },
  {
   "method": "PUT",
   "path": "/mockserver/clear?type=LOG"
  },
  {
   "method": "GET",
   "path": "/via-forward",
   "minMillis": 250
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS",
   "mask": [
    {
     "regex": "(?s)\\A.*?((?:<timestamp>|\\d{4}-\\d\\d-\\d\\d \\d\\d:\\d\\d:\\d\\d[.,]\\d+) - slow forwarded request \\s+GET /slow-target.*? ms\\)\\n).*\\z",
     "replace": "${1}"
    },
    {
     "regex": "(took \\n\\n  )\\d+",
     "replace": "${1}<n>"
    },
    {
     "regex": "(\"totalTimeInMillis\" : )\\d+",
     "replace": "${1}0"
    }
   ]
  },
  {
   "note": "route labels switched on at runtime do not create the family",
   "method": "GET",
   "path": "/mockserver/metrics",
   "mask": [
    {
     "regex": "(?m)^(# (HELP|TYPE) )?(jvm|process|tokio|http_server|http_client|mock_server_(?:native_build_info|active_connections|connection_duration_seconds|tls_handshake_duration_seconds))[^\\n]*\\n",
     "replace": ""
    },
    "[0-9]+\\.[0-9]+(E-?[0-9]+)?",
    {
     "regex": "(_duration_seconds_bucket\\{[^}]*\\}) \\d+",
     "replace": "${1} <n>"
    },
    {
     "regex": "(mock_server_request_duration_by_method_seconds_bucket\\{[^}]*\\}) \\d+",
     "replace": "${1} <n>"
    }
   , {"regex": "(?m)^(# (HELP|TYPE|UNIT) )?netty_[^\\n]*\\n", "replace": "", "reason": "JvmMetricsCollector's Netty direct-memory gauge, as jvm_*: no counterpart outside the JVM"}, {"regex": "(?m)^(# (HELP|TYPE|UNIT) )?mock_server_accept_queue_backlog_effective[^\\n]*\\n", "replace": "", "reason": "exported only where /proc/sys/net/core/somaxconn is readable (the oracle's Linux container, not a macOS host)"}, {"regex": "(?m)^(mock_server_event_log_retained_bytes|mock_server_expectations_bytes) \\S+", "replace": "${1} <heap-estimate>", "reason": "upstream's JVM heap-size estimates of log entries and expectations"}, {"regex": "(?m)^mock_server_inbound_connections_open \\S+", "replace": "mock_server_inbound_connections_open <connections>", "reason": "the oracle's gauge stays one above its open sockets after its JVM start-up warm-up request (1 with MOCKSERVER_STARTUP_WARMUP=false, no extra socket in its /proc/net/tcp); ours counts open sockets"}]
  }
 ]
}
