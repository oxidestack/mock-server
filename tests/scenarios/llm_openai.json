    "chatcmpl-[0-9a-f]{29}",
    "call_[0-9a-f]{24}",
    "created\\\\?\":\\d+",
    "\"created\" : \\d+"
   ]
  },
  {"note": "the same entries as LOG_ENTRIES (a Java throwable, stack frames and all, is left out: docs/divergences.md)", "method": "PUT", "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES", "mask": [{"regex": "(created\\\\*\":)\\d+", "replace": "${1}0"}, {"regex": ",\\s*\"throwable\" : \\{[\\s\\S]*?\\n    \\}", "replace": ""}, {"regex": "(\"epochTime\" : )\\d+", "replace": "${1}0"}, "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)", {"regex": "(Millis\\\\?\" : )\\d+", "replace": "${1}0"}, {"regex": "(x-mockserver-response-time-ms\\\\?\" : \\[\\s*\\\\?\")\\d+", "replace": "${1}0"}, "chatcmpl-[0-9a-f]{29}", "call_[0-9a-f]{24}", "created\\\\?\":\\d+", "\"created\" : \\d+"], "body": {"path": "/v1/chat/completions"}}
