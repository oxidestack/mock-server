{
 "properties": {
  "proxySetupLogging": "false",
  "dynamicallyCreateCertificateAuthorityCertificate": "true",
  "directoryToSaveDynamicSSLCertificate": "{{scratch}}/tls_dynamic_ca_lazy_proxy_configuration"
 },
 "isolated": true,
 "steps": [
  {
   "note": "after the start the dynamic CA is not on disk yet",
   "readFile": "{{scratch}}/tls_dynamic_ca_lazy_proxy_configuration/CertificateAuthorityCertificate.pem"
  },
  {
   "note": "the proxy configuration endpoint's key-and-certificate factory generates and writes it",
   "method": "GET",
   "path": "/mockserver/proxyConfiguration",
   "headers": {
    "Accept": "text/plain"
   },
   "mask": [
    "/[^\\n]*/tls_dynamic_ca_lazy_proxy_configuration/mockserver-ca\\.pem"
   ]
  },
  {
   "readFile": "{{scratch}}/tls_dynamic_ca_lazy_proxy_configuration/CertificateAuthorityCertificate.pem",
   "mask": [
    {
     "regex": "(?s)^(-----BEGIN [A-Z ]+-----\\n).*(-----END [A-Z ]+-----)\\n?$",
     "replace": "${1}<random>\n${2}"
    }
   ]
  },
  {
   "note": "what the endpoint logged",
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS",
   "mask": [
    {
     "regex": "(?s)(-----BEGIN CERTIFICATE-----\\n).*?(  -----END CERTIFICATE-----)",
     "replace": "${1}  <random>\n${2}"
    },
    {
     "regex": "/[^\\n]*/tls_dynamic_ca_lazy_proxy_configuration/",
     "replace": "<directory>/"
    }
   ]
  },
  {
   "note": "remove the generated CA for the next run",
   "deleteFile": "{{scratch}}/tls_dynamic_ca_lazy_proxy_configuration/PKCS8CertificateAuthorityPrivateKey.pem"
  },
  {
   "deleteFile": "{{scratch}}/tls_dynamic_ca_lazy_proxy_configuration/CertificateAuthorityCertificate.pem"
  },
  {
   "deleteFile": "{{scratch}}/tls_dynamic_ca_lazy_proxy_configuration/mockserver-ca.pem"
  }
 ]
}
