{
 "properties": {
  "dataPlaneAuthenticationRequired": "true",
  "dataPlaneBasicAuthenticationUsername": "user",
  "dataPlaneBasicAuthenticationPassword": "secret",
  "dataPlaneBasicAuthenticationRealm": "data-plane-realm",
  "dataPlaneBearerAuthenticationToken": "tok-1",
  "dataPlaneApiKeyAuthenticationHeader": "x-api-key",
  "dataPlaneApiKeyAuthenticationValue": "key-abc"
 },
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "path": "/secured"
    },
    "httpResponse": {
     "body": "ok"
    }
   }
  },
  {
   "method": "GET",
   "path": "/secured",
   "note": "no credentials"
  },
  {
   "method": "GET",
   "path": "/secured",
   "headers": {
    "Authorization": "Basic dXNlcjpzZWNyZXQ="
   },
   "note": "basic"
  },
  {
   "method": "GET",
   "path": "/secured",
   "headers": {
    "Authorization": "basic dXNlcjp3cm9uZw=="
   },
   "note": "wrong basic"
  },
  {
   "method": "GET",
   "path": "/secured",
   "headers": {
    "Authorization": "bearer tok-1"
   },
   "note": "bearer, lower-case scheme"
  },
  {
   "method": "GET",
   "path": "/secured",
   "headers": {
    "x-api-key": "key-abc"
   },
   "note": "api key"
  },
  {
   "method": "GET",
   "path": "/nothing",
   "note": "unmatched and unauthenticated"
  },
  {
   "method": "PUT",
   "path": "/mockserver/status",
   "note": "control plane is not gated"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=REQUESTS",
   "note": "rejected requests are not recorded"
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS",
   "note": "authentication failures are logged",
   "mask": [
    "\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d{3}"
   ]
  },
  {"note": "the same entries as LOG_ENTRIES (a Java throwable, stack frames and all, is left out: docs/divergences.md)", "method": "PUT", "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES", "mask": [{"regex": ",\\s*\"throwable\" : \\{[\\s\\S]*?\\n    \\}", "replace": ""}, {"regex": "(\"epochTime\" : )\\d+", "replace": "${1}0"}, "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)", {"regex": "(Millis\\\\?\" : )\\d+", "replace": "${1}0"}, {"regex": "(x-mockserver-response-time-ms\\\\?\" : \\[\\s*\\\\?\")\\d+", "replace": "${1}0"}, "\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d{3}"]}
]
}
