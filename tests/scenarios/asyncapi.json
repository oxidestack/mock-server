           "type": "object",
           "properties": {
            "a": {
             "type": "boolean"
            }
           }
          }
         },
         {
          "name": "B",
          "payload": {
           "enum": [
            "x",
            "y"
           ]
          }
         }
        ]
       }
      }
     },
     "empty": {}
    }
