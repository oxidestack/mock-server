    "asyncapi": "2.6.0",
    "info": {
     "title": "Orders API",
     "version": "1.0.0"
    },
    "channels": {
     "orders/created": {
      "publish": {
       "message": {
        "payload": {
         "type": "object",
         "properties": {
          "orderId": {
           "type": "integer",
           "minimum": 5
          },
          "status": {
           "type": "string",
           "format": "uuid"
          },
          "tags": {
           "type": "array",
           "items": {
            "type": "string"
           },
           "minItems": 2
          }
         },
         "required": [
          "orderId"
         ]
        }
       }
      }
     },
     "orders/shipped": {
      "subscribe": {
       "message": {
        "payload": {
         "type": "string"
        },
        "examples": [
         {
          "payload": "shipped!"
         }
        ]
       }
      }
     },
     "orders.bad": {
      "publish": {
       "message": {
        "payload": {
         "type": "integer",
         "example": "not a number"
        }
       }
      }
     },
