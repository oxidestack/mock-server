  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES",
   "note": "the log after the failing loads: each load's logged exception and its cause chain",
   "mask": [
    "(?s)\"stackTrace\" : \\[.*?\\]",
    "\"epochTime\" : \\d+",
    "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)",
    "content-length: \\d+",
    {
     "regex": "\"content-length\" : \\[\\s*\"\\d+\"\\s*\\]",
     "reason": "the logged request's length varies with the dead host's port"
    },
    {
     "regex": "\\n\\s*\"port\" : (<port>|\\d+),",
     "replace": ""
    },
    "\\[[0-9:]+\\]:[0-9]+"
   ]
  }
 ],
 "properties": {
  "tlsMutualAuthenticationRequired": "true",
  "tlsMutualAuthenticationCertificateChain": "{{files}}/tls/private-ca/ca-cert.pem"
 }
