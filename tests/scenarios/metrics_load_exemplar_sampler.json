{
 "source": "ExemplarSampler (prometheus-metrics-core 1.9.0) on the load duration histogram",
 "properties": {
  "metricsEnabled": "true",
  "loadGenerationEnabled": "true"
 },
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": {
    "httpRequest": {
     "path": "/fast/.*"
    },
    "httpResponse": {
     "body": "ok"
    }
   }
  },
  {
   "method": "PUT",
   "path": "/mockserver/loadScenario",
   "note": "three traced requests, one bucket; a SEQUENTIAL feeder ends the run only after its third response, where maxRequests 3 ended it with that request in flight and a control tick before its answer dropped it from the load series, as upstream's recordResult does (isCurrent)",
   "body": {
    "name": "sampler",
    "steps": [
     {
      "name": "fast",
      "request": {
       "method": "GET",
       "path": "/fast/$iteration.index",
       "socketAddress": {
        "host": "localhost",
        "port": "{{port}}",
        "scheme": "HTTP"
       },
       "headers": {
        "Host": [
         "localhost:{{port}}"
        ],
        "traceparent": [
         "00-0af7651916cd43dd8448eb211c80319${iteration.index}-b7ad6b7169203331-01"
        ]
       }
      }
     }
    ],
    "profile": {
     "stages": [
      {
       "vus": 1,
       "durationMillis": 30000
      }
     ]
    },
    "feeder": {
     "data": "row\n1\n2\n3",
     "format": "CSV",
     "strategy": "SEQUENTIAL"
    }
   }
  },
  {
   "method": "PUT",
   "path": "/mockserver/loadScenario/start",
   "body": {
    "names": [
     "sampler"
    ]
   }
  },
  {
   "sleepMillis": 1500
  },
  {
   "note": "openmetrics: the bucket keeps the first exemplar (ExemplarSampler's 7 s minimum retention)",
   "method": "GET",
   "path": "/mockserver/metrics",
   "headers": {
    "Accept": [
     "application/openmetrics-text; version=1.0.0; charset=utf-8"
    ]
   },
   "pollUntil": "mock_server_load_requests_total\\{[^}]*\\} 3\\.0",
   "mask": [
    "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}",
    {
     "regex": "(?m)^(# (HELP|TYPE|UNIT) )?(jvm|process|tokio|http_server|http_client|mock_server_(?:native_build_info|active_connections|connection_duration_seconds|tls_handshake_duration_seconds))[^\\n]*\\n",
     "replace": ""
    },
    {
     "regex": "(_seconds_(bucket|count|sum)(\\{(?:[^}\"]|\"[^\"]*\")*\\})?) [0-9.E-]+",
     "replace": "${1} <varies>"
    },
    {
     "regex": " # \\{trace_id=\"([0-9a-f]+)\"\\} [0-9.E-]+ [0-9.E]+",
     "replace": " # {trace_id=\"${1}\"} <value> <timestamp>"
    },
    {
     "regex": "(?m)^mock_server_load_request_duration_seconds_bucket[^\\n]*\\} <varies>\\n",
     "replace": ""
    },
    {
     "regex": "le=\"[^\"]*\"\\} <varies> # ",
     "replace": "le=\"<varies>\"} <varies> # "
    },
    "mock_server_requests_received_total [0-9.E]+",
    "(?m)^requests_received_count [0-9.E]+",
    "content-length: \\d+",
    {
     "regex": "(?m)^(# (HELP|TYPE|UNIT) )?netty_[^\\n]*\\n",
     "replace": "",
     "reason": "JvmMetricsCollector's Netty direct-memory gauge, as jvm_*: no counterpart outside the JVM"
    },
    {
     "regex": "(?m)^(# (HELP|TYPE|UNIT) )?mock_server_accept_queue_backlog_effective[^\\n]*\\n",
     "replace": "",
     "reason": "exported only where /proc/sys/net/core/somaxconn is readable (the oracle's Linux container, not a macOS host)"
    },
    {
     "regex": "(?m)^(mock_server_event_log_retained_bytes|mock_server_expectations_bytes) \\S+",
     "replace": "${1} <heap-estimate>",
     "reason": "upstream's JVM heap-size estimates of log entries and expectations"
    },
    {
     "regex": "(?m)^mock_server_inbound_connections_open \\S+",
     "replace": "mock_server_inbound_connections_open <connections>",
     "reason": "the oracle's gauge stays one above its open sockets after its JVM start-up warm-up request (1 with MOCKSERVER_STARTUP_WARMUP=false, no extra socket in its /proc/net/tcp); ours counts open sockets"
    },
    {
     "regex": "(?m)^(mock_server_event_log_max_(in_flight|retained)_bytes) \\S+",
     "replace": "${1} <heap-derived>",
     "reason": "the default byte budgets derive from the JVM's heap"
    }
   ]
  }
 ]
}