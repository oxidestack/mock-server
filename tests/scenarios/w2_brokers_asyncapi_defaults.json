{
 "properties": {
  "asyncMqttBrokerUrl": "tcp://{{deadhost}}"
 },
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/asyncapi",
   "body": {
    "asyncapi": "2.6.0",
    "info": {
     "title": "Errors"
    },
    "channels": {
     "orders": {
      "publish": {
       "message": {
        "payload": {
         "type": "object"
        },
        "examples": [
         {
          "payload": {
           "id": 1
          }
         }
        ]
       }
      }
     }
    }
   },
   "note": "a bare spec does not use the configured default broker"
  },
  {
   "method": "PUT",
   "path": "/mockserver/asyncapi",
   "body": {
    "spec": {
     "asyncapi": "2.6.0",
     "info": {
      "title": "Errors"
     },
     "channels": {
      "orders": {
       "publish": {
        "message": {
         "payload": {
          "type": "object"
         },
         "examples": [
          {
           "payload": {
            "id": 1
           }
          }
         ]
        }
       }
      }
     }
    }
   },
   "note": "a wrapped spec does"
  },
  {
   "method": "PUT",
   "path": "/mockserver/asyncapi",
   "body": {
    "spec": {
     "asyncapi": "2.6.0",
     "info": {
      "title": "Errors"
     },
     "channels": {
      "orders": {
       "publish": {
        "message": {
         "payload": {
          "type": "object"
         },
         "examples": [
          {
           "payload": {
            "id": 1
           }
          }
         ]
        }
       }
      }
     }
    },
    "brokerConfig": {
     "mqttBrokerUrl": "tcp://{{deadhost}}"
    }
   },
   "note": "the request's broker wins"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "asyncMqttBrokerUrl": ""
   },
   "note": "an empty default is no broker"
  },
  {
   "method": "PUT",
   "path": "/mockserver/asyncapi",
   "body": {
    "spec": {
     "asyncapi": "2.6.0",
     "info": {
      "title": "Errors"
     },
     "channels": {
      "orders": {
       "publish": {
        "message": {
         "payload": {
          "type": "object"
         },
         "examples": [
          {
           "payload": {
            "id": 1
           }
          }
         ]
        }
       }
      }
     }
    }
   },
   "note": "loads without a broker"
  }
 ]
}
