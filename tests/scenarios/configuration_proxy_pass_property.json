{
 "properties": {
  "proxyPass": "[{\"pathPrefix\":\"/api/\",\"targetUri\":\"https://backend:8443/services/\",\"preserveHost\":true},{\"pathPrefix\":\"/b\",\"targetUri\":\"http://h\"}]"
 },
 "steps": [
  {
   "method": "GET",
   "path": "/mockserver/configuration",
   "note": "the property supplies the mappings until an instance list is set"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "proxyPassMappings": [
     {
      "pathPrefix": "/c",
      "targetUri": "http://c"
     }
    ]
   },
   "note": "a list of the instance wins"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "proxyPassMappings": []
   },
   "note": "an empty list of the instance switches the property off"
  },
  {
   "method": "GET",
   "path": "/mockserver/configuration"
  }
 ]
}
