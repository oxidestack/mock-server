{"steps": [
  {"method": "PUT", "path": "/mockserver/expectation", "body": [
    {"httpRequest": {"method": "POST", "path": "/m"}, "httpResponse": {"body": "post"}},
    {"httpRequest": {"method": "GET", "path": "/m"}, "httpResponse": {"body": "get"}},
    {"httpRequest": {"path": "/case/Path"}, "httpResponse": {"body": "case"}},
    {"httpRequest": {"path": "/re/[0-9]+"}, "httpResponse": {"body": "regex"}},
    {"httpRequest": {"path": "/users/{id}", "pathParameters": {"id": ["[0-9]+"]}}, "httpResponse": {"body": "user"}},
    {"httpRequest": {"path": "/q", "queryStringParameters": {"a": ["1"], "b": ["x.*"]}}, "httpResponse": {"body": "query"}},
    {"httpRequest": {"path": "/qk", "queryStringParameters": {"keyMatchStyle": "MATCHING_KEY", "a": ["1"]}}, "httpResponse": {"body": "matching-key"}},
    {"httpRequest": {"path": "/h", "headers": {"X-Api-Key": ["secret"]}}, "httpResponse": {"body": "header"}},
    {"httpRequest": {"path": "/hn", "headers": {"!X-Forbidden": [".*"]}}, "httpResponse": {"body": "no-forbidden"}},
    {"httpRequest": {"path": "/ho", "headers": {"?X-Opt": ["yes"]}}, "httpResponse": {"body": "optional"}},
    {"httpRequest": {"path": "/hv", "headers": {"X-V": ["!bad"]}}, "httpResponse": {"body": "not-value"}},
    {"httpRequest": {"path": "/num", "headers": {"X-Count": [">=10"]}}, "httpResponse": {"body": "numeric"}},
    {"httpRequest": {"path": "/c", "cookies": {"sid": "abc"}}, "httpResponse": {"body": "cookie"}},
    {"httpRequest": {"not": true, "path": "/negated"}, "httpResponse": {"body": "negated-catch"}, "priority": -100},
    {"httpRequest": {"method": "!GET", "path": "/notget"}, "httpResponse": {"body": "not-get"}},
    {"httpRequest": {"path": "/schema", "headers": {"X-N": [{"schema": {"type": "integer", "minimum": 5}}]}}, "httpResponse": {"body": "schema"}},
    {"httpRequest": {"path": "/prio"}, "httpResponse": {"body": "low"}, "priority": 1},
    {"httpRequest": {"path": "/prio"}, "httpResponse": {"body": "high"}, "priority": 10},
    {"httpRequest": {"path": "/order"}, "httpResponse": {"body": "first"}, "times": {"remainingTimes": 2}},
    {"httpRequest": {"path": "/order"}, "httpResponse": {"body": "second"}, "times": {"remainingTimes": 1}},
    {"httpRequest": {"path": "/enc path"}, "httpResponse": {"body": "decoded"}},
    {"httpRequest": {"path": "/multi", "headers": {"X-M": ["a", "b"]}}, "httpResponse": {"body": "multi"}},
    {"httpRequest": {"path": "/ka", "keepAlive": true}, "httpResponse": {"body": "keepalive"}},
    {"httpRequest": {"path": "/sec", "secure": false}, "httpResponse": {"body": "insecure"}}
  ]},
  {"note": "method POST", "method": "POST", "path": "/m"},
  {"note": "method GET", "method": "GET", "path": "/m"},
  {"note": "path case-insensitive", "method": "GET", "path": "/CASE/path"},
  {"note": "path regex", "method": "GET", "path": "/re/123"},
  {"note": "path regex no match", "method": "GET", "path": "/re/abc"},
  {"note": "path template", "method": "GET", "path": "/users/42"},
  {"note": "path template bad param", "method": "GET", "path": "/users/abc"},
  {"note": "query subset", "method": "GET", "path": "/q?b=xyz&a=1&extra=2"},
  {"note": "query missing", "method": "GET", "path": "/q?a=1"},
  {"note": "query extra value SUB_SET", "method": "GET", "path": "/q?a=1&a=2&b=x"},
  {"note": "MATCHING_KEY all values", "method": "GET", "path": "/qk?a=1&a=2"},
  {"note": "MATCHING_KEY ok", "method": "GET", "path": "/qk?a=1"},
  {"note": "header case-insensitive name", "method": "GET", "path": "/h", "headers": {"x-api-key": "secret"}},
  {"note": "header wrong value", "method": "GET", "path": "/h", "headers": {"X-Api-Key": "nope"}},
  {"note": "forbidden absent", "method": "GET", "path": "/hn"},
  {"note": "forbidden present", "method": "GET", "path": "/hn", "headers": {"X-Forbidden": "1"}},
  {"note": "optional absent", "method": "GET", "path": "/ho"},
  {"note": "optional present right", "method": "GET", "path": "/ho", "headers": {"X-Opt": "yes"}},
  {"note": "optional present wrong", "method": "GET", "path": "/ho", "headers": {"X-Opt": "no"}},
  {"note": "not value ok", "method": "GET", "path": "/hv", "headers": {"X-V": "good"}},
  {"note": "not value bad", "method": "GET", "path": "/hv", "headers": {"X-V": "bad"}},
  {"note": "numeric ok", "method": "GET", "path": "/num", "headers": {"X-Count": "12"}},
  {"note": "numeric low", "method": "GET", "path": "/num", "headers": {"X-Count": "3"}},
  {"note": "cookie", "method": "GET", "path": "/c", "headers": {"Cookie": "a=1; sid=abc"}},
  {"note": "cookie missing", "method": "GET", "path": "/c"},
  {"note": "negated matcher catches other paths", "method": "GET", "path": "/anything"},
  {"note": "negated matcher not its own path", "method": "GET", "path": "/negated"},
  {"note": "not GET with DELETE", "method": "DELETE", "path": "/notget"},
  {"note": "not GET with GET", "method": "GET", "path": "/notget"},
  {"note": "schema ok", "method": "GET", "path": "/schema", "headers": {"X-N": "7"}},
  {"note": "schema low", "method": "GET", "path": "/schema", "headers": {"X-N": "2"}},
  {"note": "schema non-number", "method": "GET", "path": "/schema", "headers": {"X-N": "x"}},
  {"note": "priority wins", "method": "GET", "path": "/prio"},
  {"note": "order 1", "method": "GET", "path": "/order"},
  {"note": "order 2", "method": "GET", "path": "/order"},
  {"note": "order 3", "method": "GET", "path": "/order"},
  {"note": "order 4 exhausted", "method": "GET", "path": "/order"},
  {"note": "encoded path", "method": "GET", "path": "/enc%20path"},
  {"note": "multi header both", "method": "GET", "path": "/multi", "headers": {"X-M": ["a", "b"]}},
  {"note": "multi header one", "method": "GET", "path": "/multi", "headers": {"X-M": "a"}},
  {"note": "keepAlive", "method": "GET", "path": "/ka"},
  {"note": "secure false", "method": "GET", "path": "/sec"},
  {"note": "remaining expectations", "method": "PUT", "path": "/mockserver/retrieve?type=ACTIVE_EXPECTATIONS", "body": {"path": "/order"}}
]}
