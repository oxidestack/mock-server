{
  "properties": {
    "maxHeaderSize": "32768",
    "logLevel": "WARN"
  },
  "steps": [
    {
      "method": "PUT",
      "path": "/mockserver/expectation",
      "body": [
        {
          "httpRequest": {
            "path": "/limit"
          },
          "httpResponse": {
            "body": "served"
          }
        },
        {
          "httpRequest": {
            "path": "/upload"
          },
          "httpResponse": {
            "body": "served"
          }
        }
      ],
      "mask": [
        "\"id\" : \"[^\"]+\""
      ]
    },
    {
      "note": "in a SOCKS5 tunnel, one byte over is answered 431 and its stream reset; the next stream is served",
      "h2raw": {
        "socks5": "localhost:443",
        "method": "POST",
        "path": "/limit",
        "authority": "localhost:443",
        "decode": true,
        "open": true,
        "headers": [
          [
            "x-filler",
            "{{repeat:32545:a}}"
          ]
        ],
        "streams": [
          {
            "method": "GET",
            "path": "/limit"
          }
        ]
      }
    },
    {
      "note": "in a SOCKS5 tunnel, a header block more than a quarter over closes the tunnel with GOAWAY PROTOCOL_ERROR",
      "h2raw": {
        "socks5": "localhost:443",
        "method": "GET",
        "path": "/limit",
        "authority": "localhost:443",
        "decode": true,
        "headers": [
          [
            "x-filler",
            "{{repeat:98304:a}}"
          ]
        ]
      }
    },
    {
      "note": "in a SOCKS5 tunnel, trailers over the limit before any response are answered 431, then the stream is reset",
      "h2raw": {
        "socks5": "localhost:443",
        "method": "POST",
        "path": "/upload",
        "authority": "localhost:443",
        "decode": true,
        "body": "request body",
        "trailers": [
          [
            "x-trailer",
            "{{repeat:32728:a}}"
          ]
        ],
        "streams": [
          {
            "method": "GET",
            "path": "/upload"
          }
        ]
      }
    },
    {
      "note": "no refused request was dispatched",
      "method": "PUT",
      "path": "/mockserver/retrieve?type=REQUESTS&format=JSON",
      "body": {},
      "mask": [
        {
          "regex": "a{100,}",
          "replace": "a...",
          "reason": "the filler values"
        }
      ]
    },
    {
      "note": "one WARN for each refusal",
      "method": "PUT",
      "path": "/mockserver/retrieve?type=LOGS",
      "mask": [
        {
          "regex": "from:\n\n  /[^\n]+",
          "replace": "from:\n\n  <client>",
          "reason": "the client's address seen from inside the oracle's container"
        },
        {
          "regex": "a{100,}",
          "replace": "a...",
          "reason": "the filler values, thousands of bytes each"
        }
      ]
    }
  ]
}
