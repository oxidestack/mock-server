    },
    {
     "regex": "(\"epochTime\" : )\\d+",
     "replace": "${1}0"
    },
    "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)",
    {
     "regex": "(Millis\\\\?\" : )\\d+",
     "replace": "${1}0"
    },
    {
     "regex": "(x-mockserver-response-time-ms\\\\?\" : \\[\\s*\\\\?\")\\d+",
     "replace": "${1}0"
    }
   ]
  }
 ]
}
