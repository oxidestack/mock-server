{
 "source": "hand-written: NettyHttpClientLlmTransport blocks the Netty worker thread (see llm_worker_stall); the stalled call's request goes out on a pooled channel of that very loop (reused.eventLoop().execute), so the LLM backend receives it only once the stall ends, and the timeout of sendRequest(...).get does not cancel it",
 "peer": true,
 "properties": {
  "llmProvider": "OPENAI",
  "llmBaseUrl": "{{peerurl}}",
  "llmApiKey": "test-key",
  "llmModel": "gpt-test",
  "llmRequestTimeoutMillis": "1500"
 },
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/reset",
   "node": "peer"
  },
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": [
    {
     "id": "any",
     "priority": 0,
     "httpRequest": {
      "method": "POST",
      "path": "/v1/chat/completions"
     },
     "httpResponse": {
      "statusCode": 200,
      "headers": {
       "content-type": [
        "application/json"
       ]
      },
      "body": "{\"id\": \"chatcmpl-1\", \"object\": \"chat.completion\", \"model\": \"gpt-4o-mini\", \"choices\": [{\"index\": 0, \"message\": {\"role\": \"assistant\", \"content\": \"{\\\"httpRequest\\\": {\\\"method\\\": \\\"GET\\\", \\\"path\\\": \\\"/orders/1\\\"}, \\\"httpResponse\\\": {\\\"statusCode\\\": 200, \\\"body\\\": \\\"order\\\"}}\"}, \"finish_reason\": \"stop\"}], \"usage\": {\"prompt_tokens\": 10, \"completion_tokens\": 5, \"total_tokens\": 15}}"
     }
    }
   ],
   "node": "peer"
  },
  {
   "method": "PUT",
   "path": "/mockserver/generateExpectation",
   "body": {
    "request": {
     "path": "/p1"
    }
   },
   "note": "the first call opens the LLM client's connection, the second registration"
  },
  {
   "method": "PUT",
   "path": "/mockserver/generateExpectation",
   "body": {
    "request": {
     "path": "/p2"
    }
   }
  },
  {
   "method": "PUT",
   "path": "/mockserver/generateExpectation",
   "body": {
    "request": {
     "path": "/p3"
    }
   }
  },
  {
   "method": "PUT",
   "path": "/mockserver/generateExpectation",
   "body": {
    "request": {
     "path": "/p4"
    }
   }
  },
  {
   "method": "PUT",
   "path": "/mockserver/generateExpectation",
   "body": {
    "request": {
     "path": "/p5"
    }
   }
  },
  {
   "method": "PUT",
   "path": "/mockserver/generateExpectation",
   "body": {
    "request": {
     "path": "/p6"
    }
   },
   "async": "stalled",
   "note": "on the pooled channel's event loop: the call blocks the loop for llmRequestTimeoutMillis and the template stub answers"
  },
  {
   "sleepMillis": 400,
   "note": "well into the stall"
  },
  {
   "method": "PUT",
   "path": "/mockserver/verify",
   "node": "peer",
   "note": "still during the stall: the backend has the five earlier calls' requests, not the stalled one's",
   "body": {
    "httpRequest": {
     "method": "POST",
     "path": "/v1/chat/completions"
    },
    "times": {
     "atMost": 5
    }
   }
  },
  {
   "await": "stalled"
  },
  {
   "method": "PUT",
   "path": "/mockserver/verify",
   "node": "peer",
   "note": "after the stall: the stalled call's request has gone out",
   "body": {
    "httpRequest": {
     "method": "POST",
     "path": "/v1/chat/completions"
    },
    "times": {
     "atLeast": 6
    }
   },
   "pollUntil": "^$"
  }
 ]
}
