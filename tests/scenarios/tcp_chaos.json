{"steps": [
  {"note": "nothing registered", "method": "GET", "path": "/mockserver/tcpChaos"},
  {"note": "blank body", "method": "PUT", "path": "/mockserver/tcpChaos"},
  {"note": "clear with host", "method": "PUT", "path": "/mockserver/tcpChaos", "body": {"clear": true, "host": "a"}},
  {"note": "no host", "method": "PUT", "path": "/mockserver/tcpChaos", "body": {"chaos": {"latencyMs": 5}}},
  {"note": "bad ttl", "method": "PUT", "path": "/mockserver/tcpChaos", "body": {"host": "a", "chaos": {"latencyMs": 5}, "ttlMillis": 0}},
  {"note": "invalid profile", "method": "PUT", "path": "/mockserver/tcpChaos", "body": {"host": "a", "chaos": {"bandwidthBytesPerSec": 0}}},
  {"note": "invalid slicer", "method": "PUT", "path": "/mockserver/tcpChaos", "body": {"host": "a", "chaos": {"slicerChunkSize": 0}}},
  {"note": "invalid goaway code", "method": "PUT", "path": "/mockserver/tcpChaos", "body": {"host": "a", "chaos": {"http2GoAwayErrorCode": -1}}},
  {"note": "register", "method": "PUT", "path": "/mockserver/tcpChaos", "body": {"host": "Payments.SVC:8443", "chaos": {"resetMidResponse": true, "http2GoAway": true, "http2GoAwayErrorCode": 11, "slowCloseDelay": {"timeUnit": "MILLISECONDS", "value": 50}, "latencyMs": 0}}},
  {"note": "register with ttl", "method": "PUT", "path": "/tcpChaos", "body": {"host": "other.svc", "chaos": {"down": false, "limitDataBytes": 10}, "ttlMillis": 600000}},
  {"note": "list", "method": "GET", "path": "/mockserver/tcpChaos", "mask": ["\"other.svc\" : \\d+"]},
  {"note": "patch blank", "method": "PATCH", "path": "/mockserver/tcpChaos"},
  {"note": "patch no chaos", "method": "PATCH", "path": "/mockserver/tcpChaos", "body": {"host": "payments.svc"}},
  {"note": "patch", "method": "PATCH", "path": "/mockserver/tcpChaos", "body": {"host": "payments.svc", "chaos": {"resetMidResponse": false, "resetAfterResponseChunks": 2}}},
  {"note": "patch unknown host", "method": "PATCH", "path": "/mockserver/tcpChaos", "body": {"host": "new.svc", "chaos": {"timeout": true}}},
  {"note": "remove", "method": "PUT", "path": "/mockserver/tcpChaos", "body": {"host": "new.svc", "remove": true}},
  {"note": "remove by missing chaos", "method": "PUT", "path": "/mockserver/tcpChaos", "body": {"host": "OTHER.svc"}},
  {"note": "list after", "method": "GET", "path": "/mockserver/tcpChaos"},
  {"note": "clear", "method": "PUT", "path": "/mockserver/tcpChaos", "body": {"clear": true}},
  {"note": "list cleared", "method": "GET", "path": "/mockserver/tcpChaos"},
  {"method": "PUT", "path": "/mockserver/tcpChaos", "body": {"host": "survivor", "chaos": {"latencyMs": 1}}},
  {"method": "PUT", "path": "/mockserver/reset"},
  {"note": "reset clears", "method": "GET", "path": "/mockserver/tcpChaos"},
  {"method": "PUT", "path": "/mockserver/retrieve?type=LOGS", "mask": ["\"other.svc\" : \\d+"]},
  {"note": "the same entries as LOG_ENTRIES (a Java throwable, stack frames and all, is left out: docs/divergences.md)", "method": "PUT", "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES", "mask": [{"regex": ",\\s*\"throwable\" : \\{[\\s\\S]*?\\n    \\}", "replace": ""}, {"regex": "(\"epochTime\" : )\\d+", "replace": "${1}0"}, "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)", {"regex": "(Millis\\\\?\" : )\\d+", "replace": "${1}0"}, {"regex": "(x-mockserver-response-time-ms\\\\?\" : \\[\\s*\\\\?\")\\d+", "replace": "${1}0"}, "\"other.svc\" : \\d+"]}
]}
