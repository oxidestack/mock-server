{
 "properties": {
  "proxyAuthenticationUsername": "testuser",
  "proxyAuthenticationPassword": "testpass"
 },
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/reset",
   "note": "Socks5ProxyHandlerTest with credentials configured"
  },
  {
   "tcp": [
    "BAEBu38AAAEA"
   ],
   "note": "warm-up: a SOCKS4 CONNECT naming 127.0.0.1 (see socks_handshakes)"
  },
  {
   "sleepMillis": 5000
  },
  {
   "tcp": [
    "BQEC"
   ],
   "note": "Socks5ProxyHandlerTest.shouldRespondWithPasswordAuthWhenCredentialsConfigured: only PASSWORD offered"
  },
  {
   "tcp": [
    "BQIAAg=="
   ],
   "note": "NO_AUTH and PASSWORD offered with credentials configured: NO_AUTH wins"
  },
  {
   "tcp": [
    "BQEC",
    "AQh0ZXN0dXNlcgh0ZXN0cGFzcw==",
    "BQEAAX8AAAEBuw==",
    "R0VUIC9zb2Nrcy10dW5uZWwgSFRUUC8xLjENCkhvc3Q6IHR1bm5lbGxlZC5leGFtcGxlDQpDb25uZWN0aW9uOiBjbG9zZQ0KDQo="
   ],
   "note": "Socks5ProxyHandlerTest.shouldAuthenticateWithCorrectPassword, then CONNECT and an HTTP request inside the tunnel",
   "chunkMillis": 1000,
   "text": true
  },
  {
   "tcp": [
    "BQEC",
    "AQh0ZXN0dXNlcgl3cm9uZ3Bhc3M="
   ],
   "note": "Socks5ProxyHandlerTest.shouldRejectWrongPasswordAndCloseChannel",
   "chunkMillis": 1000
  },
  {
   "tcp": [
    "BQEC",
    "AQl3cm9uZ3VzZXIIdGVzdHBhc3M="
   ],
   "note": "Socks5ProxyHandlerTest.shouldRejectWrongUsernameAndCloseChannel",
   "chunkMillis": 1000
  },
  {
   "tcp": [
    "BAEBu38AAAF0ZXN0dXNlcgA=",
    "R0VUIC9zb2Nrcy10dW5uZWwgSFRUUC8xLjENCkhvc3Q6IHR1bm5lbGxlZC5leGFtcGxlDQpDb25uZWN0aW9uOiBjbG9zZQ0KDQo="
   ],
   "note": "SOCKS4 CONNECT with credentials configured (SOCKS4 has no password)",
   "chunkMillis": 1000,
   "text": true
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=REQUESTS",
   "note": "the requests that reached MockServer through the tunnels"
  }
 ]
}