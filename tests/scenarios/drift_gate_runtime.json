{
 "source": "the drift gate (DriftDetectionConfigTest, HttpActionHandlerDriftDetectionTest) changed at runtime. Empty properties: its PUT /mockserver/configuration answers are whole configuration dumps, so it runs on a server (and records on an oracle container) no other scenario has configured; reset does not restore configuration.",
 "properties": {},
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/reset"
  },
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": [
    {
     "id": "upstream",
     "priority": 1000,
     "httpRequest": {
      "headers": {
       "Host": [
        "localhost:[0-9]+"
       ]
      }
     },
     "httpResponse": {
      "statusCode": 500,
      "body": "upstream body"
     }
    },
    {
     "id": "stub",
     "httpRequest": {
      "path": "/some_path"
     },
     "httpResponse": {
      "statusCode": 200,
      "body": "stub body"
     }
    }
   ],
   "note": "the upstream answer (the forward targets this server) and a response stub for the same path, which drifts from it"
  },
  {
   "method": "PUT",
   "path": "/mockserver/expectation",
   "body": "{\"id\": \"forward\", \"priority\": 10, \"httpRequest\": {\"path\": \"/some_path\"}, \"httpForward\": {\"host\": \"localhost\", \"port\": {{port}}}}"
  },
  {
   "method": "GET",
   "path": "/some_path",
   "headers": {
    "Host": "harvest.client"
   },
   "note": "forwarded to the server itself and answered by the upstream stub"
  },
  {
   "sleepMillis": 500
  },
  {
   "method": "GET",
   "path": "/mockserver/drift",
   "note": "driftDetectionEnabled defaults to true and driftSampleRate to 1.0: the stub matching the forwarded request drifts from the upstream answer (status 200 vs 500); the upstream stub itself does not",
   "mask": [
    {
     "regex": "\"epochTimeMs\" : \\d+",
     "replace": "\"epochTimeMs\" : <millis>"
    }
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/drift/clear"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "driftDetectionEnabled": false
   },
   "note": "the gate closed while the server runs"
  },
  {
   "method": "GET",
   "path": "/some_path",
   "headers": {
    "Host": "harvest.client"
   },
   "note": "forwarded to the server itself and answered by the upstream stub"
  },
  {
   "sleepMillis": 500
  },
  {
   "method": "GET",
   "path": "/mockserver/drift",
   "note": "no drift recorded",
   "mask": [
    {
     "regex": "\"epochTimeMs\" : \\d+",
     "replace": "\"epochTimeMs\" : <millis>"
    }
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/drift/clear"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "driftDetectionEnabled": true,
    "driftSampleRate": 0.0
   },
   "note": "enabled, but never sampled"
  },
  {
   "method": "GET",
   "path": "/some_path",
   "headers": {
    "Host": "harvest.client"
   },
   "note": "forwarded to the server itself and answered by the upstream stub"
  },
  {
   "sleepMillis": 500
  },
  {
   "method": "GET",
   "path": "/mockserver/drift",
   "note": "no drift recorded",
   "mask": [
    {
     "regex": "\"epochTimeMs\" : \\d+",
     "replace": "\"epochTimeMs\" : <millis>"
    }
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/drift/clear"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "driftSampleRate": -0.5
   },
   "note": "clamped to 0.0"
  },
  {
   "method": "GET",
   "path": "/some_path",
   "headers": {
    "Host": "harvest.client"
   },
   "note": "forwarded to the server itself and answered by the upstream stub"
  },
  {
   "sleepMillis": 500
  },
  {
   "method": "GET",
   "path": "/mockserver/drift",
   "note": "no drift recorded",
   "mask": [
    {
     "regex": "\"epochTimeMs\" : \\d+",
     "replace": "\"epochTimeMs\" : <millis>"
    }
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/drift/clear"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "driftSampleRate": 2.5
   },
   "note": "clamped to 1.0"
  },
  {
   "method": "GET",
   "path": "/some_path",
   "headers": {
    "Host": "harvest.client"
   },
   "note": "forwarded to the server itself and answered by the upstream stub"
  },
  {
   "sleepMillis": 500
  },
  {
   "method": "GET",
   "path": "/mockserver/drift",
   "note": "every forward sampled again",
   "mask": [
    {
     "regex": "\"epochTimeMs\" : \\d+",
     "replace": "\"epochTimeMs\" : <millis>"
    }
   ]
  },
  {
   "method": "PUT",
   "path": "/mockserver/drift/clear"
  },
  {
   "method": "PUT",
   "path": "/mockserver/configuration",
   "body": {
    "driftSampleRate": 1.0,
    "driftDetectionEnabled": true
   },
   "note": "restore the defaults"
  },
  {
   "method": "PUT",
   "path": "/mockserver/reset"
  }
 ]
}
