{"properties": {"wasmEnabled": "true"}, "steps": [
  {"note": "no modules", "method": "GET", "path": "/mockserver/wasm/modules"},
  {"note": "upload body-only module", "method": "PUT", "path": "/mockserver/wasm/modules?name=amount", "bodyFile": "wasm/match.wasm"},
  {"note": "upload request module", "method": "PUT", "path": "/mockserver/wasm/modules?name=orders", "bodyFile": "wasm/match-request.wasm"},
  {"note": "upload v2 module", "method": "PUT", "path": "/mockserver/wasm/modules?name=orders-v2", "bodyFile": "wasm/match-request-v2.wasm"},
  {"note": "upload shaping module", "method": "PUT", "path": "/mockserver/wasm/modules?name=shape", "bodyFile": "wasm/shape-response.wasm"},
  {"note": "upload without a name", "method": "PUT", "path": "/mockserver/wasm/modules", "bodyFile": "wasm/match.wasm"},
  {"note": "upload garbage", "method": "PUT", "path": "/mockserver/wasm/modules?name=garbage", "body": "not wasm"},
  {"note": "list", "method": "GET", "path": "/mockserver/wasm/modules"},
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"httpRequest": {"path": "/amount", "body": {"type": "WASM", "moduleName": "amount"}}, "httpResponse": {"body": "big amount"}}},
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"httpRequest": {"path": "/orders", "body": {"type": "WASM", "moduleName": "orders"}}, "httpResponse": {"body": "acme order"}}},
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"httpRequest": {"body": {"type": "WASM", "moduleName": "orders-v2"}}, "httpResponse": {"body": "v2 order"}}},
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"httpRequest": {"path": "/shape", "body": {"type": "WASM", "moduleName": "shape"}}, "httpResponse": {"statusCode": 201, "headers": {"Content-Type": ["application/json"]}, "body": "{\"name\":\"acme\"}"}}},
  {"method": "PUT", "path": "/mockserver/expectation", "body": {"httpRequest": {"path": "/missing-module", "body": {"type": "WASM", "moduleName": "nope"}}, "httpResponse": {"body": "never"}}},
  {"method": "PUT", "path": "/mockserver/retrieve?type=ACTIVE_EXPECTATIONS"},
  {"note": "body-only: amount over 1000", "method": "POST", "path": "/amount", "body": "{\"amount\": 5000}"},
  {"note": "body-only: amount under 1000", "method": "POST", "path": "/amount", "body": "{\"amount\": 5}"},
  {"note": "request: POST /orders X-Tenant acme", "method": "POST", "path": "/orders", "headers": {"X-Tenant": ["acme"]}, "body": "{}"},
  {"note": "request: wrong tenant", "method": "POST", "path": "/orders", "headers": {"X-Tenant": ["other"]}, "body": "{}"},
  {"note": "v2: query and cookie", "method": "POST", "path": "/orders?tenant=acme", "headers": {"Cookie": ["session=abc123"]}, "body": "{}"},
  {"note": "shape: POST /shape", "method": "POST", "path": "/shape", "body": "{}"},
  {"note": "missing module never matches", "method": "POST", "path": "/missing-module", "body": "x"},
  {"note": "dry run: match", "method": "POST", "path": "/mockserver/wasm/test", "body": {"module": "{{base64:wasm/match-request-v2.wasm}}", "request": {"method": "POST", "path": "/orders", "queryStringParameters": {"tenant": ["acme"]}, "cookies": {"session": "abc123"}, "body": "{}"}}},
  {"note": "dry run: loaded module, no match", "method": "POST", "path": "/mockserver/wasm/test", "body": {"moduleName": "orders", "request": {"method": "GET", "path": "/orders"}}},
  {"note": "dry run: shaping", "method": "POST", "path": "/mockserver/wasm/test", "body": {"moduleName": "shape", "request": {"method": "POST", "path": "/shape"}, "response": {"statusCode": 201, "headers": {"Content-Type": ["application/json"]}, "body": "{\"name\":\"acme\"}"}}},
  {"note": "dry run: no module", "method": "POST", "path": "/mockserver/wasm/test", "body": {"request": {"path": "/x"}}},
  {"note": "dry run: unknown module", "method": "POST", "path": "/mockserver/wasm/test", "body": {"moduleName": "nope"}},
  {"note": "dry run: invalid module", "method": "POST", "path": "/mockserver/wasm/test", "body": {"module": "bm90IHdhc20="}},
  {"note": "delete", "method": "DELETE", "path": "/mockserver/wasm/modules?name=amount"},
  {"note": "delete unknown", "method": "DELETE", "path": "/mockserver/wasm/modules?name=amount"},
  {"note": "deleted module no longer matches", "method": "POST", "path": "/amount", "body": "{\"amount\": 5000}"},
  {"method": "PUT", "path": "/mockserver/reset"},
  {"note": "reset clears modules", "method": "GET", "path": "/mockserver/wasm/modules"}
