{
 "steps": [
  {"method": "PUT", "path": "/mockserver/asyncapi", "body": "{\"asyncapi\": ", "note": "end of input between object entries"},
  {"method": "PUT", "path": "/mockserver/asyncapi", "body": "{\"spec\": \"{\\\"asyncapi\\\": \"}", "note": "the same inside the spec wrapper"},
  {"method": "PUT", "path": "/mockserver/asyncapi", "body": "{asyncapi: 1}", "note": "an unquoted field name (plain ObjectMapper)"},
  {"method": "PUT", "path": "/mockserver/asyncapi", "body": "{'asyncapi':'2.6.0'}", "note": "single quotes"},
  {"method": "PUT", "path": "/mockserver/asyncapi", "body": "{\"asyncapi\":\"2.6.0\",}", "note": "a trailing comma"},
  {"method": "PUT", "path": "/mockserver/asyncapi", "body": "{\"asyncapi\" \"2.6.0\"}", "note": "a missing colon"},
  {"method": "PUT", "path": "/mockserver/asyncapi", "body": "{\"asyncapi\":tru}", "note": "an unrecognized token"},
  {"method": "PUT", "path": "/mockserver/asyncapi", "body": "{\"asyncapi\":}", "note": "a member value missing"},
  {"method": "PUT", "path": "/mockserver/asyncapi", "body": "{\"spec\":\"{\\\"channels\\\":[1,2}\"}", "note": "a mismatched close marker"},
  {"method": "PUT", "path": "/mockserver/asyncapi", "body": "{\"asyncapi\":\"2.6", "note": "an unterminated string"},
  {"method": "PUT", "path": "/mockserver/asyncapi", "body": "{\"asyncapi\":01}", "note": "a leading zero"},
  {"method": "PUT", "path": "/mockserver/asyncapi", "body": "{\n  \"asyncapi\": \"2.6.0\",\n  \"info\": {\"title\": \"T\"\n", "note": "end of input on a later line"},
  {"method": "PUT", "path": "/mockserver/asyncapi", "body": "{\"asyncapi\":\"2.6.0\",\"info\":{\"title\":\"Trailing\"}} trailing", "note": "readTree reads the first value only: trailing content loads"},
  {"method": "PUT", "path": "/mockserver/asyncapi/http", "body": "{\"asyncapi\": ", "note": "the HTTP expectation generator"},
  {"method": "PUT", "path": "/mockserver/asyncapi/http", "body": "{\"spec\":\"{\\\"asyncapi\\\":tru}\"}", "note": "the generator through the wrapper"},
  {"method": "PUT", "path": "/mockserver/reset"}
 ]
}
