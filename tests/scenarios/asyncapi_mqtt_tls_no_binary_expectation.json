{
 "note": "an MQTT client over TLS (trusting MockServer's CA) connects to this server's own port, where no binary expectation matches the CONNECT bytes: the oracle closes the connection (the client reports Connection lost); the log shows the outcome.",
 "steps": [
  {
   "method": "PUT",
   "path": "/mockserver/reset"
  },
  {
   "note": "MQTT 3, no binary expectation",
   "method": "PUT",
   "path": "/mockserver/asyncapi",
   "body": {
    "spec": {
     "asyncapi": "2.6.0",
     "info": {
      "title": "Ssl",
      "version": "1"
     },
     "channels": {
      "orders": {
       "publish": {
        "message": {
         "payload": {
          "type": "object"
         }
        }
       }
      }
     }
    },
    "brokerConfig": {
     "mqttBrokerUrl": "ssl://localhost:{{port}}",
     "publishOnLoad": false,
     "mqttSecurity": {
      "sslProperties": {
       "com.ibm.ssl.trustStore": "{{files}}/asyncapi/mqtt-ssl/trust.jks",
       "com.ibm.ssl.trustStorePassword": "changeit"
      }
     }
    }
   },
   "maxMillis": 60000
  },
  {
   "note": "MQTT 5, no binary expectation",
   "method": "PUT",
   "path": "/mockserver/asyncapi",
   "body": {
    "spec": {
     "asyncapi": "2.6.0",
     "info": {
      "title": "Ssl",
      "version": "1"
     },
     "channels": {
      "orders": {
       "publish": {
        "message": {
         "payload": {
          "type": "object"
         }
        }
       }
      }
     }
    },
    "brokerConfig": {
     "mqttBrokerUrl": "ssl://localhost:{{port}}",
     "publishOnLoad": false,
     "mqttSecurity": {
      "sslProperties": {
       "com.ibm.ssl.trustStore": "{{files}}/asyncapi/mqtt-ssl/trust.jks",
       "com.ibm.ssl.trustStorePassword": "changeit"
      }
     },
     "mqttProtocolVersion": 5
    }
   },
   "maxMillis": 60000
  },
  {
   "method": "PUT",
   "path": "/mockserver/retrieve?type=LOGS&format=LOG_ENTRIES",
   "note": "the log after the failing loads",
   "mask": [
    "(?s)\"stackTrace\" : \\[.*?\\]",
    "\"epochTime\" : \\d+",
    "\\d+\\.\\d+\\.\\d+\\.\\d+:(<port>|\\d+)",
    "content-length: \\d+",
    {
     "regex": "\"content-length\" : \\[\\s*\"\\d+\"\\s*\\]",
     "reason": "length varies with the port"
    },
    {
     "regex": "\\n\\s*\"port\" : (<port>|\\d+),",
     "replace": ""
    },
    "\\[[0-9:]+\\]:[0-9]+"
   ]
  }
 ]
}