target
.git
tests
docs
tickets
conformance
bench
# Only the dashboard UI sources of the upstream checkout (the `ui` stage builds them).
upstream/*
!upstream/mockserver
upstream/mockserver/*
!upstream/mockserver/mockserver-ui
# build-dashboard.sh's `siblings`: read by mockserver-ui's build from outside its directory.
!upstream/mockserver/mockserver-client-rust
upstream/mockserver/mockserver-client-rust/*
!upstream/mockserver/mockserver-client-rust/Cargo.toml
# The same list as scripts/build-dashboard.sh's excludes: installed or generated, never sources.
upstream/mockserver/mockserver-ui/node_modules
upstream/mockserver/mockserver-ui/build
upstream/mockserver/mockserver-ui/test-results
upstream/mockserver/mockserver-ui/playwright-report
# A host-built bundle; the image builds its own in the `ui` stage.
dashboard
spec/mockserver-8.0.0/manual
